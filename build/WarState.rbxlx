      <Item class="Folder" referent="72">
        <Properties>
          <string name="Name">Resources</string>
        </Properties>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">ResourceService</string>
            <string name="Source"><![CDATA[-- ResourceService: PARTIAL.
-- Resources (Treasury, Oil, Fuel, Steel, Supplies) exist in country data and are replicated.
-- A new country starts with ZERO of everything; nothing is ever granted automatically.
-- Costs are defined in config (Cost = { Treasury = n }) and checked here on the SERVER.
-- GameConfig.Economy.ChargeCosts = false while no income source exists (otherwise an empty
-- country could never build anything); flip it to true once production/economy ships.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("GameConfig"))

local ResourceService = {}
ResourceService.Name = "ResourceService"
ResourceService.Status = "PARTIAL"
ResourceService.ResourceKeys = { "Treasury", "Oil", "Fuel", "Steel", "Supplies" }
ResourceService.Active = GameConfig.Economy.ChargeCosts == true

local services

function ResourceService.get(player: Player)
	local country = services.DataService.getCountry(player)
	if not country then
		return nil
	end
	local result = {}
	for _, key in ipairs(ResourceService.ResourceKeys) do
		result[key] = country[key] or 0
	end
	return result
end

-- cost = { Treasury = 10, Steel = 2 } (optional multiplier for road lines)
function ResourceService.canAfford(country, cost, multiplier: number?): (boolean, string?)
	if not ResourceService.Active or type(cost) ~= "table" then
		return true, nil
	end
	local m = multiplier or 1
	for key, amount in pairs(cost) do
		if type(amount) == "number" and amount > 0 and (country[key] or 0) < amount * m then
			return false, "Not enough " .. key
		end
	end
	return true, nil
end

function ResourceService.charge(country, cost, multiplier: number?)
	if not ResourceService.Active or type(cost) ~= "table" then
		return
	end
	local m = multiplier or 1
	for key, amount in pairs(cost) do
		if type(amount) == "number" and amount > 0 then
			country[key] = math.max(0, (country[key] or 0) - amount * m)
		end
	end
end

function ResourceService.init(allServices)
	services = allServices
end

function ResourceService.start() end

return ResourceService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="74">
        <Properties>
          <string name="Name">Roads</string>
        </Properties>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">RoadService</string>
            <string name="Source"><![CDATA[-- RoadService: server-authoritative road placement, demolition and the road graph.
-- One road type (Straight Road). Roads are drawn by DRAG: the client sends start/end points,
-- the server snaps the line to the grid + dominant axis, validates every tile against the
-- player's OWN plot, and builds it. Junction curbs are rebuilt automatically (RoadGraph).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Modules = Shared:WaitForChild("Modules")
local RoadConfig = require(Config:WaitForChild("RoadConfig"))
local PlacementConfig = require(Config:WaitForChild("PlacementConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local GridMath = require(Modules:WaitForChild("GridMath"))
local PlacementRules = require(Modules:WaitForChild("PlacementRules"))
local RoadGraph = require(Modules:WaitForChild("RoadGraph"))
local RoadModels = require(Modules:WaitForChild("RoadModels"))

local RoadService = {}
RoadService.Name = "RoadService"

local services
local remotes
local runtime = {} -- [Player] = { cells = {key -> segment}, models = {RoadId -> Model}, byId = {RoadId -> segment} }
local lastRequest = {}

local ROAD_TYPE = RoadConfig.Types[1]

local function getRuntime(player)
	local r = runtime[player]
	if not r then
		r = { cells = {}, models = {}, byId = {} }
		runtime[player] = r
	end
	return r
end

local function exitInfo(player)
	local exit = services.WorldService.getExit(player)
	if not exit then
		return nil
	end
	return { key = exit.key, side = exit.side }
end

local function spawnModel(player, segment)
	local folder = services.WorldService.getPlotFolder(player, "Roads")
	local bounds = services.WorldService.getBounds(player)
	if not folder or not bounds then
		return
	end
	local r = getRuntime(player)
	local old = r.models[segment.RoadId]
	if old then
		old:Destroy()
	end
	local model = RoadModels.build(segment.Type, segment.Openings)
	model.Name = segment.RoadId
	local wx, wz = bounds.minX + segment.Position.X, bounds.minZ + segment.Position.Z
	model:PivotTo(CFrame.new(wx, bounds.surfaceY, wz))
	local size = PlacementConfig.RoadTileSize
	model:SetAttribute(Constants.Attributes.Kind, "Road")
	model:SetAttribute(Constants.Attributes.TypeId, segment.Type)
	model:SetAttribute("Ix", segment.Ix)
	model:SetAttribute("Iz", segment.Iz)
	model:SetAttribute("Rotation", segment.Rotation)
	model:SetAttribute("Openings", segment.Openings)
	model:SetAttribute("RectMinX", wx - size / 2)
	model:SetAttribute("RectMaxX", wx + size / 2)
	model:SetAttribute("RectMinZ", wz - size / 2)
	model:SetAttribute("RectMaxZ", wz + size / 2)
	model:SetAttribute("Connected", segment.Connected == true)
	model:SetAttribute("ExitConnected", segment.ExitConnected == true)
	model.Parent = folder
	r.models[segment.RoadId] = model
end

-- World-space rects of all road tiles, keyed by cell (used by placement validation).
function RoadService.getRoadCells(player: Player)
	local result = {}
	local r = runtime[player]
	local bounds = services.WorldService.getBounds(player)
	if not r or not bounds then
		return result
	end
	for key, segment in pairs(r.cells) do
		local _, _, rect = PlacementRules.roadCellCenter(segment.Ix, segment.Iz, bounds)
		result[key] = rect
	end
	return result
end

function RoadService.getSegments(player: Player)
	local r = runtime[player]
	return r and r.cells or {}
end

function RoadService.getSegmentsById(player: Player)
	local r = runtime[player]
	return r and r.byId or {}
end

function RoadService.count(player: Player): number
	local r = runtime[player]
	local n = 0
	if r then
		for _ in pairs(r.cells) do
			n += 1
		end
	end
	return n
end

function RoadService.loadCountry(player: Player, country)
	RoadService.clearPlayer(player)
	local r = getRuntime(player)
	for id, segment in pairs(country.Roads) do
		segment.RoadId = segment.RoadId or id
		if RoadGraph.getType(segment.Type) == nil then
			segment.Type = ROAD_TYPE.Id
		end
		local key = GridMath.cellKey(segment.Ix, segment.Iz)
		if r.cells[key] then
			-- Duplicate tile in an old save: keep the first one.
			country.Roads[id] = nil
		else
			r.cells[key] = segment
			r.byId[segment.RoadId] = segment
		end
	end
	RoadGraph.recomputeAll(r.cells, exitInfo(player))
	for _, segment in pairs(r.cells) do
		spawnModel(player, segment)
	end
end

function RoadService.clearPlayer(player: Player)
	local r = runtime[player]
	if r then
		for _, model in pairs(r.models) do
			model:Destroy()
		end
	end
	runtime[player] = nil
end

local function rateLimited(player): boolean
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < PlacementConfig.RequestCooldown then
		return true
	end
	lastRequest[player] = now
	return false
end

local function validNumber(v): boolean
	return type(v) == "number" and v == v and v > -1e6 and v < 1e6
end

-- Core placement shared by PlaceRoad (single tile) and PlaceRoadLine (drag).
local function placeLine(player, startX, startZ, endX, endZ)
	local country = services.DataService.getCountry(player)
	local bounds = services.WorldService.getBounds(player)
	if not country or not bounds then
		return { ok = false, error = "Choose a plot first" }
	end
	local cells, axis = PlacementRules.roadLine(startX, startZ, endX, endZ, bounds)
	local ctx = {
		plot = bounds,
		buildingRects = services.BuildingService.getBuildingRects(player),
		roadCells = RoadService.getRoadCells(player),
	}
	local ok, reason, tiles, newCount = PlacementRules.validateRoadLine(cells, ctx)
	if not ok then
		return { ok = false, error = reason }
	end
	local affordable, costError = services.ResourceService.canAfford(country, ROAD_TYPE.Cost, newCount)
	if not affordable then
		return { ok = false, error = costError }
	end
	services.ResourceService.charge(country, ROAD_TYPE.Cost, newCount)

	local r = getRuntime(player)
	local exit = exitInfo(player)
	local rebuild = {}
	local placedIds = {}
	for _, tile in ipairs(tiles) do
		if not tile.existing then
			local roadId = "R" .. tostring(country.NextRoadId)
			country.NextRoadId += 1
			local segment = {
				RoadId = roadId,
				Type = ROAD_TYPE.Id,
				Rotation = axis,
				Ix = tile.ix,
				Iz = tile.iz,
				Position = { X = tile.centerX - bounds.minX, Z = tile.centerZ - bounds.minZ },
				Neighbours = {},
				Adjacent = {},
				Connected = false,
			}
			country.Roads[roadId] = segment
			r.cells[GridMath.cellKey(tile.ix, tile.iz)] = segment
			r.byId[roadId] = segment
			table.insert(placedIds, roadId)
		end
	end
	for _, tile in ipairs(tiles) do
		for _, segment in ipairs(RoadGraph.updateAround(r.cells, tile.ix, tile.iz, exit)) do
			rebuild[segment.RoadId] = segment
		end
	end
	for _, segment in pairs(rebuild) do
		spawnModel(player, segment)
	end
	services.DataService.markDirty(player)
	services.CountryService.push(player)
	return { ok = true, placed = #placedIds, roadIds = placedIds }
end

local function handlePlace(player, request)
	if rateLimited(player) then
		return { ok = false, error = "Too fast" }
	end
	if type(request) ~= "table" or not validNumber(request.X) or not validNumber(request.Z) then
		return { ok = false, error = "Invalid request" }
	end
	if request.Type ~= nil and request.Type ~= ROAD_TYPE.Id then
		return { ok = false, error = "Unknown road type" }
	end
	return placeLine(player, request.X, request.Z, request.X, request.Z)
end

local function handlePlaceLine(player, request)
	if rateLimited(player) then
		return { ok = false, error = "Too fast" }
	end
	if type(request) ~= "table" then
		return { ok = false, error = "Invalid request" }
	end
	for _, key in ipairs({ "StartX", "StartZ", "EndX", "EndZ" }) do
		if not validNumber(request[key]) then
			return { ok = false, error = "Invalid request" }
		end
	end
	return placeLine(player, request.StartX, request.StartZ, request.EndX, request.EndZ)
end

-- Demolish one road tile owned by the player. Returns ok, error.
function RoadService.demolish(player: Player, roadId: any): (boolean, string?)
	local country = services.DataService.getCountry(player)
	local r = runtime[player]
	if not country or not r or type(roadId) ~= "string" then
		return false, "Nothing to demolish"
	end
	local segment = r.byId[roadId]
	if not segment or country.Roads[roadId] == nil then
		return false, "Not your road"
	end
	country.Roads[roadId] = nil
	r.byId[roadId] = nil
	r.cells[GridMath.cellKey(segment.Ix, segment.Iz)] = nil
	local model = r.models[roadId]
	if model then
		model:Destroy()
	end
	r.models[roadId] = nil
	for _, other in ipairs(RoadGraph.updateAround(r.cells, segment.Ix, segment.Iz, exitInfo(player))) do
		spawnModel(player, other)
	end
	services.DataService.markDirty(player)
	services.CountryService.push(player)
	return true, nil
end

function RoadService.init(allServices)
	services = allServices
	remotes = allServices.Remotes
end

function RoadService.start()
	remotes[Constants.Remotes.PlaceRoad].OnServerInvoke = handlePlace
	remotes[Constants.Remotes.PlaceRoadLine].OnServerInvoke = handlePlaceLine
	Players.PlayerRemoving:Connect(function(player)
		RoadService.clearPlayer(player)
		lastRequest[player] = nil
	end)
end

return RoadService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="76">
        <Properties>
          <string name="Name">Stats</string>
        </Properties>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[-- StatsService: builds the REAL statistics shown in the client Stats panel.
-- Every number is derived from the authoritative country data (no fake values).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local UtilityGrid = require(Shared:WaitForChild("Modules"):WaitForChild("UtilityGrid"))

local StatsService = {}
StatsService.Name = "StatsService"
StatsService.RoadListLimit = 6
StatsService.BuildingListLimit = 60

local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end

local function idNumber(id: string): number
	return tonumber(string.match(id or "", "%d+")) or 0
end

-- Returns { Stats = {...}, Water = {...}, Power = {...}, WaterList = {...}, PowerList = {...} }
function StatsService.build(country)
	local stats = {
		Population = country.Population or 0,
		HousingCapacity = country.HousingCapacity or 0,
		Workers = country.Workers or 0,
		Houses = 0,
		Businesses = 0,
		Factories = 0,
		Roads = 0,
		Buildings = 0,
		UnderConstruction = 0,
		WaterTowers = 0,
		PowerSources = 0,
	}
	local waterList, powerList = {}, {}
	local counters = {}
	local records = UtilityGrid.sortedRecords(country.Buildings)
	for _, record in ipairs(records) do
		local def = defsById[record.Type]
		if def then
			stats.Buildings += 1
			local completed = record.State == Constants.BuildState.Completed
			if not completed then
				stats.UnderConstruction += 1
			end
			local group = def.StatsGroup
			if group and stats[group] ~= nil and completed then
				stats[group] += 1
			end
			local short = def.ShortName or def.DisplayName
			counters[short] = (counters[short] or 0) + 1
			local label = short .. " #" .. counters[short]
			if #waterList < StatsService.BuildingListLimit then
				table.insert(waterList, {
					Label = label,
					Id = record.Id,
					Status = record.WaterStatus or "GREY",
					Required = record.WaterRequired or 0,
					Supplied = record.WaterSupplied or 0,
					Pending = not completed,
				})
				table.insert(powerList, {
					Label = label,
					Id = record.Id,
					Status = record.PowerStatus or "GREY",
					Required = record.PowerRequired or 0,
					Supplied = record.PowerSupplied or 0,
					Pending = not completed,
				})
			end
		end
	end
	local roadIds = {}
	for id in pairs(country.Roads) do
		table.insert(roadIds, id)
	end
	table.sort(roadIds, function(a, b)
		return idNumber(a) < idNumber(b)
	end)
	stats.Roads = #roadIds
	for i, id in ipairs(roadIds) do
		if i > StatsService.RoadListLimit then
			break
		end
		local row = { Label = "Road #" .. i, Id = id, Status = "GREY", Required = 0, Supplied = 0, Pending = false }
		table.insert(waterList, row)
		table.insert(powerList, row)
	end
	local extraRoads = math.max(0, #roadIds - StatsService.RoadListLimit)
	local infra = country.Infrastructure or {}
	local water = infra.Water or {}
	local power = infra.Power or {}
	local shortage = infra.Shortage or {}
	return {
		Stats = stats,
		Water = {
			Production = water.Production or 0,
			Demand = water.Demand or 0,
			Supplied = water.Supplied or 0,
			Stored = water.Stored or 0,
			Capacity = water.Capacity or 0,
			Stage = shortage.Stage or Constants.ShortageStage.Normal,
			ShortageSeconds = shortage.Seconds or 0,
		},
		Power = {
			Production = power.Production or 0,
			Demand = power.Demand or 0,
			Supplied = power.Supplied or 0,
		},
		WaterList = waterList,
		PowerList = powerList,
		ExtraRoads = extraRoads,
	}
end

function StatsService.init(_services) end

function StatsService.start() end

return StatsService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="78">
        <Properties>
          <string name="Name">Vehicles</string>
        </Properties>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">VehicleService</string>
            <string name="Source"><![CDATA[-- VehicleService: PARTIAL. Routing foundation for future vehicles (tanks, IFV, trucks,
-- military vehicles). No vehicles are spawned yet (no mass NPC / vehicle simulation).
-- Route: PLAYER PLOT (road graph) -> EXIT tile -> bridge -> MAIN MAP -> CENTRAL ISLAND.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Modules = Shared:WaitForChild("Modules")
local RoadGraph = require(Modules:WaitForChild("RoadGraph"))

local VehicleService = {}
VehicleService.Name = "VehicleService"
VehicleService.Status = "PARTIAL"
VehicleService.Active = false
VehicleService.VehicleClasses = {
	{ Id = "Truck", Category = "Logistics", Status = "PLANNED" },
	{ Id = "Tank", Category = "Military", Status = "PLANNED" },
	{ Id = "IFV", Category = "Military", Status = "PLANNED" },
	{ Id = "MilitaryVehicle", Category = "Military", Status = "PLANNED" },
}

local services

-- Returns world waypoints { Vector3, ... } from a road tile to the central island, or nil + reason.
function VehicleService.routeToCentral(player: Player, fromRoadId: string)
	local bounds = services.WorldService.getBounds(player)
	local exit = services.WorldService.getExit(player)
	if not bounds or not exit then
		return nil, "No plot"
	end
	local segmentsById = services.RoadService.getSegmentsById(player)
	local path = RoadGraph.pathToExit(segmentsById, fromRoadId)
	if not path then
		return nil, "Road is not connected to the plot exit"
	end
	local waypoints = {}
	for _, roadId in ipairs(path) do
		local segment = segmentsById[roadId]
		table.insert(waypoints, Vector3.new(bounds.minX + segment.Position.X, bounds.surfaceY, bounds.minZ + segment.Position.Z))
	end
	for i, point in ipairs(exit.waypoints) do
		if i > 1 then
			table.insert(waypoints, Vector3.new(point.X, bounds.surfaceY, point.Z))
		end
	end
	return waypoints, nil
end

-- True when at least one road tile of the player touches the exit.
function VehicleService.hasExitAccess(player: Player): boolean
	for _, segment in pairs(services.RoadService.getSegmentsById(player)) do
		if segment.ExitConnected then
			return true
		end
	end
	return false
end

function VehicleService.init(allServices)
	services = allServices
end

function VehicleService.start() end

return VehicleService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="80">
        <Properties>
          <string name="Name">Water</string>
        </Properties>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">WaterService</string>
            <string name="Source"><![CDATA[-- WaterService: server-side water system.
-- Water Tower: Production (units per utility tick), Capacity (storage buffer), Radius (studs).
-- Buildings inside a tower's radius receive water (UtilityGrid). Every building record gets
-- WaterRequired / WaterSupplied / WaterStatus (GREEN supplied, RED shortage, GREY not required).
-- Coverage is recomputed on events (build / demolish / completion / load); the periodic tick only
-- updates storage and the gradual shortage stages:
-- NORMAL -> WARNING -> PROLONGED_SHORTAGE -> POPULATION_PROBLEMS -> GRADUAL_POPULATION_DECREASE

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local UtilityGrid = require(Shared:WaitForChild("Modules"):WaitForChild("UtilityGrid"))

local WaterService = {}
WaterService.Name = "WaterService"
WaterService.Kind = "Water"

local services
local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end

local SHORTAGE = GameConfig.Utilities.Shortage
local Stage = Constants.ShortageStage

local STAGE_MESSAGES = {
	[Stage.Warning] = { "Water shortage: build a Water Tower near your buildings", "error" },
	[Stage.Prolonged] = { "Prolonged water shortage: population growth stopped", "error" },
	[Stage.Problems] = { "Water shortage is causing population problems", "error" },
	[Stage.Decrease] = { "Population is decreasing because of the water shortage", "error" },
	[Stage.Normal] = { "Water supply restored", "success" },
}

function WaterService.stageFor(seconds: number): string
	if seconds <= 0 then
		return Stage.Normal
	elseif seconds < SHORTAGE.ProlongedSeconds then
		return Stage.Warning
	elseif seconds < SHORTAGE.ProblemsSeconds then
		return Stage.Prolonged
	elseif seconds < SHORTAGE.DecreaseSeconds then
		return Stage.Problems
	end
	return Stage.Decrease
end

function WaterService.stageIndex(stage: string): number
	return table.find(Constants.ShortageOrder, stage) or 1
end

local function infra(country)
	country.Infrastructure = country.Infrastructure or {}
	local i = country.Infrastructure
	i.Water = i.Water or { Stored = 0, Production = 0, Demand = 0 }
	i.Shortage = i.Shortage or { Stage = Stage.Normal, Seconds = 0 }
	return i
end

-- Housing capacity of completed residential buildings that are RED on water.
function WaterService.affectedHousing(country): number
	local affected = 0
	for _, record in pairs(country.Buildings) do
		local def = defsById[record.Type]
		if def and (def.HousingCapacity or 0) > 0 and record.State == Constants.BuildState.Completed and record.WaterStatus == "RED" then
			affected += def.HousingCapacity
		end
	end
	return affected
end

-- Event-driven coverage recompute (no storage consumption). Returns true if anything changed.
function WaterService.recompute(player: Player): boolean
	local country = services.DataService.getCountry(player)
	if not country then
		return false
	end
	local i = infra(country)
	local capacity = UtilityGrid.capacity(country.Buildings, defsById, "Water")
	i.Water.Stored = math.clamp(i.Water.Stored or 0, 0, capacity)
	i.Water.Capacity = capacity
	local result = UtilityGrid.compute(country.Buildings, defsById, "Water", { pool = i.Water.Stored })
	local changed = UtilityGrid.apply(country.Buildings, "Water", result)
	i.Water.Production = result.production
	i.Water.Demand = result.demand
	i.Water.Supplied = result.supplied
	services.BuildingService.refreshUtilityAttributes(player)
	return changed
end

-- Pure shortage step (used by the tick and by the runtime self-test).
-- Returns previousStage, newStage, populationChanged
function WaterService.shortageStep(country, dt: number)
	local i = infra(country)
	local previous = i.Shortage.Stage or Stage.Normal
	local affected = WaterService.affectedHousing(country)
	if affected > 0 then
		i.Shortage.Seconds = (i.Shortage.Seconds or 0) + dt
	else
		i.Shortage.Seconds = math.max(0, (i.Shortage.Seconds or 0) - dt * SHORTAGE.RecoveryMultiplier)
	end
	i.Shortage.Stage = WaterService.stageFor(i.Shortage.Seconds)
	local populationChanged = false
	if i.Shortage.Stage == Stage.Decrease and affected > 0 and country.Population > 0 then
		local floorPopulation = math.max(0, country.HousingCapacity - affected)
		if country.Population > floorPopulation then
			local loss = math.max(1, math.floor(math.min(country.Population, affected) * SHORTAGE.DecreaseFraction))
			country.Population = math.max(floorPopulation, country.Population - loss)
			country.Workers = math.floor(country.Population * GameConfig.Population.WorkerRatio)
			populationChanged = true
		end
	end
	return previous, i.Shortage.Stage, populationChanged
end

local function tickPlayer(player: Player, dt: number)
	local country = services.DataService.getCountry(player)
	if not country or not services.WorldService.getPlotIndex(player) then
		return
	end
	local i = infra(country)
	local capacity = UtilityGrid.capacity(country.Buildings, defsById, "Water")
	local stored = math.clamp(i.Water.Stored or 0, 0, capacity)
	local result = UtilityGrid.compute(country.Buildings, defsById, "Water", { pool = stored })
	local changed = UtilityGrid.apply(country.Buildings, "Water", result)
	local surplus = math.max(0, result.production - result.fromProduction)
	local newStored = math.clamp(stored - result.fromPool + surplus, 0, capacity)
	if newStored ~= i.Water.Stored then
		changed = true
	end
	i.Water.Stored = newStored
	i.Water.Capacity = capacity
	i.Water.Production = result.production
	i.Water.Demand = result.demand
	i.Water.Supplied = result.supplied

	local previous, stage, populationChanged = WaterService.shortageStep(country, dt)
	if previous ~= stage then
		changed = true
		local message = STAGE_MESSAGES[stage]
		local escalated = WaterService.stageIndex(stage) > WaterService.stageIndex(previous)
		if message and (escalated or stage == Stage.Normal) then
			services.CountryService.notify(player, message[1], message[2])
		end
	end
	if changed or populationChanged then
		services.BuildingService.refreshUtilityAttributes(player)
		services.DataService.markDirty(player)
		services.CountryService.push(player)
	end
end

function WaterService.init(allServices)
	services = allServices
end

function WaterService.start()
	task.spawn(function()
		local interval = GameConfig.Utilities.TickSeconds
		while true do
			task.wait(interval)
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(tickPlayer, player, interval)
				if not ok then
					warn("[WaterService] " .. tostring(err))
				end
			end
		end
	end)
end

return WaterService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="82">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[-- WorldService: builds the game map once (ocean, central island, 6 player islands, exits, bridges)
-- and owns plot ownership. Plots are NEVER auto-assigned: the player picks a free plot after
-- creating/loading a country (ClaimPlot). No buildings, roads or citizens are pre-placed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local Theme = require(Config:WaitForChild("ThemeConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local Plots = require(Shared:WaitForChild("Modules"):WaitForChild("Plots"))
local Countries = require(Shared:WaitForChild("Modules"):WaitForChild("Countries"))

local WorldService = {}
WorldService.Name = "WorldService"

local services
local remotes
local plotOwners = {} -- [index] = { player = Player, countryName = string, flagId = string }
local playerPlots = {} -- [Player] = index
local plotModels = {} -- [index] = Model
local signs = {} -- [index] = { gui, name, flag, country }

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function rootFolders()
	return {
		Map = ensureFolder(Workspace, "Map"),
		Buildings = ensureFolder(Workspace, "Buildings"),
		Roads = ensureFolder(Workspace, "Roads"),
		Vehicles = ensureFolder(Workspace, "Vehicles"),
		NPCs = ensureFolder(Workspace, "NPCs"),
	}
end

local function color(t)
	return Color3.new(t[1], t[2], t[3])
end

local function block(parent, name, size: Vector3, cframe: CFrame, col: Color3, material, collide: boolean?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cframe
	p.Color = col
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- OCEAN + CENTRAL ISLAND -------------------------------------------------------------------
local function buildOcean(map)
	local m = GameConfig.Map
	local old = map:FindFirstChild("Ocean")
	if old then
		old:Destroy()
	end
	local ocean = Instance.new("Model")
	ocean.Name = "Ocean"
	block(ocean, "Seabed", Vector3.new(m.WaterSize, 2, m.WaterSize), CFrame.new(0, m.SeabedY - 1, 0), color(m.SeabedColor), Enum.Material.Sand)
	local water = block(
		ocean,
		"Water",
		Vector3.new(m.WaterSize, 0.4, m.WaterSize),
		CFrame.new(0, m.WaterLevel - 0.2, 0),
		color(m.WaterColor),
		Enum.Material.SmoothPlastic,
		false
	)
	water.Transparency = 0.2
	water.CanQuery = false
	water.CastShadow = false
	ocean.Parent = map
end

local function tree(parent, x: number, z: number, scale: number, rng)
	local trunkH = 2.2 * scale
	block(parent, "Trunk", Vector3.new(0.5 * scale, trunkH, 0.5 * scale), CFrame.new(x, trunkH / 2, z), Color3.fromRGB(150, 112, 80), Enum.Material.Wood, false)
	local leaf = Color3.fromRGB(112 + rng:NextInteger(0, 20), 162 + rng:NextInteger(0, 20), 98)
	block(parent, "Leaves", Vector3.new(2.2 * scale, 1.6 * scale, 2.2 * scale), CFrame.new(x, trunkH + 0.6 * scale, z), leaf, Enum.Material.SmoothPlastic, false)
	block(parent, "LeavesTop", Vector3.new(1.4 * scale, 1.1 * scale, 1.4 * scale), CFrame.new(x, trunkH + 1.8 * scale, z), leaf:Lerp(Color3.new(1, 1, 1), 0.08), Enum.Material.SmoothPlastic, false)
end

local function rock(parent, x: number, z: number, scale: number)
	block(
		parent,
		"Rock",
		Vector3.new(1.6 * scale, 1.0 * scale, 1.3 * scale),
		CFrame.new(x, 0.3 * scale, z) * CFrame.Angles(0, scale, 0.1),
		Color3.fromRGB(178, 182, 186),
		Enum.Material.Slate,
		false
	)
end

local function buildCentralIsland(map)
	local c = GameConfig.Map.CentralIsland
	local old = map:FindFirstChild("CentralIsland")
	if old then
		old:Destroy()
	end
	local island = Instance.new("Model")
	island.Name = "CentralIsland"
	island:SetAttribute("Purpose", "Future land battles")
	local sand = color(GameConfig.Territory.SandColor)
	block(island, "Beach", Vector3.new(c.Size, 6, c.Size), CFrame.new(c.CenterX, -3.15, c.CenterZ), sand, Enum.Material.Sand)
	local inner = c.Size - c.BeachWidth * 2
	local ground = block(island, "Ground", Vector3.new(inner, 6, inner), CFrame.new(c.CenterX, -3, c.CenterZ), color(c.Color), Enum.Material.Grass)
	island.PrimaryPart = ground

	local deco = Instance.new("Folder")
	deco.Name = "Decorations"
	deco.Parent = island
	local d = GameConfig.Map.Decorations
	local rng = Random.new(d.Seed)
	local limit = inner / 2 - 6
	local placed = 0
	local attempts = 0
	while placed < d.Trees and attempts < 200 do
		attempts += 1
		local x = rng:NextNumber(-limit, limit)
		local z = rng:NextNumber(-limit, limit)
		if math.abs(x) > 26 or math.abs(z) > 26 then
			tree(deco, c.CenterX + x, c.CenterZ + z, rng:NextNumber(0.9, 1.4), rng)
			placed += 1
		end
	end
	for _ = 1, d.Rocks do
		local x = rng:NextNumber(-limit, limit)
		local z = rng:NextNumber(-limit, limit)
		rock(deco, c.CenterX + x, c.CenterZ + z, rng:NextNumber(0.8, 1.6))
	end

	local lobby = GameConfig.Map.LobbySpawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(lobby[1], 0.2, lobby[3])
	spawn.Color = Theme.Colors.AccentSoft
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = island
	island.Parent = map
end

-- PLAYER PLOTS -------------------------------------------------------------------------------
local function createSign(index: number, plotModel: Model, bounds)
	local anchor = Instance.new("Part")
	anchor.Name = "OwnerSign"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(bounds.centerX, bounds.surfaceY + 20, bounds.centerZ)
	anchor.Parent = plotModel

	local gui = Instance.new("BillboardGui")
	gui.Name = "OwnerPanel"
	gui.Size = UDim2.fromOffset(176, 84)
	gui.MaxDistance = 700
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.Adornee = anchor
	gui.Parent = anchor

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = Theme.Colors.Background
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Accent
	stroke.Thickness = 1.5
	stroke.Transparency = 0.3
	stroke.Parent = card

	local function text(name, y, h, font, size, col)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.new(0, 8, 0, y)
		l.Size = UDim2.new(1, -16, 0, h)
		l.Font = font
		l.TextSize = size
		l.TextColor3 = col
		l.TextTruncate = Enum.TextTruncate.AtEnd
		l.Text = ""
		l.Parent = card
		return l
	end
	local nameLabel = text("PlayerName", 6, 18, Theme.Fonts.Bold, 14, Theme.Colors.Text)
	local flagLabel = text("Flag", 25, 28, Theme.Fonts.Regular, 24, Theme.Colors.Text)
	local flagImage = Instance.new("ImageLabel")
	flagImage.Name = "FlagImage"
	flagImage.BackgroundTransparency = 1
	flagImage.AnchorPoint = Vector2.new(0.5, 0)
	flagImage.Position = UDim2.new(0.5, 0, 0, 27)
	flagImage.Size = UDim2.fromOffset(36, 24)
	flagImage.ScaleType = Enum.ScaleType.Crop
	flagImage.Visible = false
	flagImage.Parent = card
	local countryLabel = text("CountryName", 58, 18, Theme.Fonts.Medium, 13, Theme.Colors.AccentDark)
	signs[index] = { gui = gui, name = nameLabel, flag = flagLabel, flagImage = flagImage, country = countryLabel }
end

local function updateSign(index: number)
	local sign = signs[index]
	if not sign then
		return
	end
	local owner = plotOwners[index]
	if owner then
		sign.name.Text = owner.player.Name
		local entry = Countries.get(owner.flagId or "")
		if entry and Countries.hasRealFlag(entry) then
			sign.flagImage.Image = entry.FlagAsset
			sign.flagImage.Visible = true
			sign.flag.Text = ""
		else
			sign.flagImage.Visible = false
			sign.flag.Text = entry and entry.EmojiFallback or ""
		end
		sign.country.Text = owner.countryName or ""
	else
		sign.name.Text = "PLOT " .. index
		sign.flagImage.Visible = false
		sign.flag.Text = ""
		sign.country.Text = "Free"
	end
end

local function buildExit(plotModel: Model, index: number, bounds)
	local exit = Plots.getExit(index)
	local m = GameConfig.Map
	local width = m.BridgeWidth
	local y = bounds.surfaceY
	local folder = Instance.new("Model")
	folder.Name = "Exit"
	folder:SetAttribute("ExitSide", exit.side)
	folder:SetAttribute("ExitIx", exit.ix)
	folder:SetAttribute("ExitIz", exit.iz)

	local function strip(name, ax, az, bx, bz, w, thick, col, material, top)
		local dx, dz = bx - ax, bz - az
		local length = math.sqrt(dx * dx + dz * dz)
		if length < 0.05 then
			return nil
		end
		local mid = Vector3.new((ax + bx) / 2, top - thick / 2, (az + bz) / 2)
		local cf = CFrame.lookAt(mid, mid + Vector3.new(dx, 0, dz))
		return block(folder, name, Vector3.new(w, thick, length), cf, col, material)
	end
	local asphalt = Color3.fromRGB(124, 128, 134)
	-- Exit lane across the sand rim (plot edge -> bridge start)
	strip("ExitLane", exit.edgeX, exit.edgeZ, exit.bridgeStartX, exit.bridgeStartZ, width, 0.4, asphalt, Enum.Material.Concrete, y + 0.08)
	-- Bridge over water (bridge start -> central island landing)
	strip("Bridge", exit.bridgeStartX, exit.bridgeStartZ, exit.bridgeEndX, exit.bridgeEndZ, width, 0.8, color(m.BridgeColor), Enum.Material.Concrete, y + 0.08)
	local v = Plots.SideVector[exit.side]
	local px, pz = -v[2], v[1] -- perpendicular
	for _, s in ipairs({ -1, 1 }) do
		local ox, oz = px * s * (width / 2 + 0.15), pz * s * (width / 2 + 0.15)
		strip("Rail", exit.bridgeStartX + ox, exit.bridgeStartZ + oz, exit.bridgeEndX + ox, exit.bridgeEndZ + oz, 0.3, 0.6, color(m.BridgeRailColor), Enum.Material.SmoothPlastic, y + 0.6)
		-- Gate posts at the plot edge
		block(
			folder,
			"GatePost",
			Vector3.new(0.5, 3, 0.5),
			CFrame.new(exit.edgeX + px * s * (width / 2 + 0.6), y + 1.5, exit.edgeZ + pz * s * (width / 2 + 0.6)),
			Theme.Colors.Accent,
			Enum.Material.SmoothPlastic,
			false
		)
	end
	local beamLength = width + 1.7
	local beamSize = (v[1] == 0) and Vector3.new(beamLength, 0.4, 0.4) or Vector3.new(0.4, 0.4, beamLength)
	block(folder, "GateBeam", beamSize, CFrame.new(exit.edgeX, y + 3.1, exit.edgeZ), Theme.Colors.Background, Enum.Material.SmoothPlastic, false)
	folder.Parent = plotModel
end

local function buildPlot(map, index: number)
	local bounds = Plots.getBounds(index)
	local t = GameConfig.Territory
	local plotsFolder = ensureFolder(map, "Plots")
	local old = plotsFolder:FindFirstChild("Plot_" .. index)
	if old then
		old:Destroy()
	end
	local plotModel = Instance.new("Model")
	plotModel.Name = "Plot_" .. index
	plotModel:SetAttribute(Constants.Attributes.PlotIndex, index)
	plotModel:SetAttribute("OwnerUserId", 0)

	local islandSize = t.Size + t.RimWidth * 2
	block(plotModel, "Rim", Vector3.new(islandSize, 6, islandSize), CFrame.new(bounds.centerX, bounds.surfaceY - 3.12, bounds.centerZ), color(t.SandColor), Enum.Material.Sand)
	local ground = block(plotModel, "Ground", Vector3.new(t.Size, t.Thickness, t.Size), CFrame.new(bounds.centerX, bounds.surfaceY - t.Thickness / 2, bounds.centerZ), color(t.Color), Enum.Material.Grass)
	ground:SetAttribute(Constants.Attributes.PlotIndex, index)
	plotModel.PrimaryPart = ground

	local border = t.BorderWidth
	local sides = {
		{ Vector3.new(t.Size, 0.06, border), Vector3.new(0, 0, -t.Size / 2 + border / 2) },
		{ Vector3.new(t.Size, 0.06, border), Vector3.new(0, 0, t.Size / 2 - border / 2) },
		{ Vector3.new(border, 0.06, t.Size), Vector3.new(-t.Size / 2 + border / 2, 0, 0) },
		{ Vector3.new(border, 0.06, t.Size), Vector3.new(t.Size / 2 - border / 2, 0, 0) },
	}
	for i, side in ipairs(sides) do
		local p = block(plotModel, "Border" .. i, side[1], CFrame.new(bounds.centerX, bounds.surfaceY + 0.03, bounds.centerZ) + side[2], color(t.BorderColor), Enum.Material.SmoothPlastic, false)
		p.CanQuery = false
	end
	buildExit(plotModel, index, bounds)
	createSign(index, plotModel, bounds)
	plotModel.Parent = plotsFolder
	plotModels[index] = plotModel
	updateSign(index)
end

local function buildMap()
	local folders = rootFolders()
	buildOcean(folders.Map)
	buildCentralIsland(folders.Map)
	for index = 1, Plots.maxPlots() do
		buildPlot(folders.Map, index)
	end
end

-- OWNERSHIP ----------------------------------------------------------------------------------
local function createPlotFolders(index: number, owner: Player)
	local folders = rootFolders()
	for _, key in ipairs({ "Buildings", "Roads" }) do
		local plotFolderName = "Plot_" .. index
		local old = folders[key]:FindFirstChild(plotFolderName)
		if old then
			old:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = plotFolderName
		folder:SetAttribute(Constants.Attributes.PlotIndex, index)
		folder:SetAttribute(Constants.Attributes.OwnerUserId, owner.UserId)
		folder.Parent = folders[key]
	end
end

local function destroyPlotFolders(index: number)
	local folders = rootFolders()
	for _, key in ipairs({ "Buildings", "Roads" }) do
		local inst = folders[key]:FindFirstChild("Plot_" .. index)
		if inst then
			inst:Destroy()
		end
	end
end

local function broadcast()
	if remotes and remotes[Constants.Remotes.PlotsChanged] then
		remotes[Constants.Remotes.PlotsChanged]:FireAllClients(WorldService.listPlots())
	end
end

function WorldService.listPlots()
	local list = {}
	for index = 1, Plots.maxPlots() do
		local owner = plotOwners[index]
		table.insert(list, {
			Index = index,
			Free = owner == nil,
			OwnerName = owner and owner.player.Name or nil,
			OwnerUserId = owner and owner.player.UserId or nil,
			CountryName = owner and owner.countryName or nil,
			FlagId = owner and owner.flagId or nil,
		})
	end
	return list
end

function WorldService.isPlotFree(index: number): boolean
	return Plots.isValidIndex(index) and plotOwners[index] == nil
end

function WorldService.getOwner(index: number): Player?
	local owner = plotOwners[index]
	return owner and owner.player or nil
end

function WorldService.getPlotIndex(player: Player): number?
	return playerPlots[player]
end

function WorldService.getBounds(player: Player)
	local index = playerPlots[player]
	if not index then
		return nil
	end
	return Plots.getBounds(index)
end

function WorldService.getExit(player: Player)
	local index = playerPlots[player]
	return index and Plots.getExit(index) or nil
end

function WorldService.getPlotFolder(player: Player, kind: string): Folder?
	local index = playerPlots[player]
	if not index then
		return nil
	end
	local root = Workspace:FindFirstChild(kind)
	return root and root:FindFirstChild("Plot_" .. index) or nil
end

local function spawnCFrame(index: number)
	local bounds = Plots.getBounds(index)
	local v = Plots.SideVector[bounds.exitSide]
	local offset = bounds.size / 2 - 6
	local pos = Vector3.new(bounds.centerX + v[1] * offset, bounds.surfaceY + 4, bounds.centerZ + v[2] * offset)
	return CFrame.lookAt(pos, Vector3.new(bounds.centerX, pos.Y, bounds.centerZ))
end

function WorldService.teleportToPlot(player: Player)
	local index = playerPlots[player]
	local character = player.Character
	if index and character then
		character:PivotTo(spawnCFrame(index))
	end
end

function WorldService.teleportToLobby(player: Player)
	local lobby = GameConfig.Map.LobbySpawn
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(lobby[1], lobby[2] + 4, lobby[3]))
	end
end

-- Server-authoritative claim. Returns ok, error.
function WorldService.claim(player: Player, index: any, country): (boolean, string?)
	if not Plots.isValidIndex(index) then
		return false, "Invalid plot"
	end
	if playerPlots[player] then
		return false, "You already own a plot"
	end
	if plotOwners[index] ~= nil then
		return false, "This plot is already taken"
	end
	plotOwners[index] = {
		player = player,
		countryName = country and country.Name or "",
		flagId = country and country.FlagId or "",
	}
	playerPlots[player] = index
	createPlotFolders(index, player)
	local model = plotModels[index]
	if model then
		model:SetAttribute("OwnerUserId", player.UserId)
		model:SetAttribute("OwnerName", player.Name)
		model:SetAttribute("CountryName", country and country.Name or "")
	end
	player:SetAttribute(Constants.Attributes.PlotIndex, index)
	updateSign(index)
	broadcast()
	return true, nil
end

function WorldService.release(player: Player)
	local index = playerPlots[player]
	if not index then
		return
	end
	destroyPlotFolders(index)
	plotOwners[index] = nil
	playerPlots[player] = nil
	local model = plotModels[index]
	if model then
		model:SetAttribute("OwnerUserId", 0)
		model:SetAttribute("OwnerName", nil)
		model:SetAttribute("CountryName", nil)
	end
	if player.Parent then
		player:SetAttribute(Constants.Attributes.PlotIndex, nil)
	end
	updateSign(index)
	broadcast()
end

-- Kept for older callers: plots are no longer assigned automatically.
function WorldService.leave(player: Player)
	WorldService.release(player)
end

function WorldService.init(allServices)
	services = allServices
	remotes = allServices.Remotes
	buildMap()
end

local function hookCharacter(player: Player)
	player.CharacterAdded:Connect(function()
		task.defer(function()
			if playerPlots[player] then
				WorldService.teleportToPlot(player)
			end
		end)
	end)
end

function WorldService.start()
	remotes[Constants.Remotes.GetPlots].OnServerInvoke = function(_player)
		return { ok = true, plots = WorldService.listPlots() }
	end
	Players.PlayerAdded:Connect(hookCharacter)
	for _, player in ipairs(Players:GetPlayers()) do
		hookCharacter(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		WorldService.release(player)
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
