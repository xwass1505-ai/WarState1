	body(m, "Body", 0, -1.2, 10.0, 8.6, 7.4, C.Sky)
	floorBand(m, 0, -1.2, 10.0, 8.6, 3.7, C.Trim)
	gableRoof(m, 0, -1.2, 10.0, 8.6, 7.4, false, C.Sky, C.Charcoal)
	chimney(m, -3.2, -3.0, 9.2, C.Brick)
	door(m, 0, -1.2, 8.6, C.Trim)
	frontWindows(m, 0, -1.2, 10.0, 8.6, 2, 4, true, C.Glass)
	sideWindows(m, 0, -1.2, 10.0, 8.6, 2, C.Glass)
	porch(m, 0, -1.2 + 4.3, 5.0, 1.6, 3.0, C.Charcoal)
	shrub(m, -5.8, 4.8, 1.0)
	shrub(m, 5.8, 4.8, 1.0)
end

-- BUSINESS (Shop design 8 x 8 -> 2 x 2, Office design 12 x 12 -> 3 x 3)
Variants.Shop_A = function(m) shop(m, C.White, C.LightBlue) end
Variants.Shop_B = function(m) shop(m, C.Cream, C.Coral) end
Variants.Shop_C = function(m) shop(m, C.Sky, C.White) end
Variants.Shop_D = function(m) shop(m, C.Sage, C.Mustard) end
Variants.Office_A = function(m) office(m, C.Glass, C.White) end
Variants.Office_B = function(m) office(m, C.LightBlue, C.Steel) end
Variants.Office_C = function(m) office(m, C.Glass, C.Beige) end
Variants.Office_D = function(m) office(m, C.Mint, C.White) end

-- INDUSTRY (Workshop design 12 x 8 -> 3 x 2, Factory design 16 x 12 -> 4 x 3)
Variants.Workshop_A = function(m) workshop(m, C.Steel, C.SteelDark) end
Variants.Workshop_B = function(m) workshop(m, C.Beige, C.RoofBrown) end
Variants.Workshop_C = function(m) workshop(m, C.White, C.Slate) end
Variants.Workshop_D = function(m) workshop(m, C.Sky, C.Charcoal) end
Variants.Factory_A = function(m) factory(m, C.Steel, C.LightBlue) end
Variants.Factory_B = function(m) factory(m, C.Beige, C.Terracotta) end
Variants.Factory_C = function(m) factory(m, C.White, C.Mustard) end
Variants.Factory_D = function(m) factory(m, C.Sand, C.Slate) end

-- INFRASTRUCTURE (Water Tower / Wind Generator design 8 x 8 -> 2 x 2, Substation 12 x 12 -> 3 x 3)
Variants.WaterTower_A = function(m) waterTower(m, C.LightBlue, C.Steel) end
Variants.WaterTower_B = function(m) waterTower(m, C.White, C.SteelDark) end
Variants.WaterTower_C = function(m) waterTower(m, C.Sky, C.White) end
Variants.WaterTower_D = function(m) waterTower(m, C.Mint, C.Steel) end
Variants.WindGenerator_A = function(m) windGenerator(m, C.White, C.LightBlue) end
Variants.WindGenerator_B = function(m) windGenerator(m, C.White, C.Coral) end
Variants.WindGenerator_C = function(m) windGenerator(m, C.Trim, C.Steel) end
Variants.WindGenerator_D = function(m) windGenerator(m, C.White, C.Mint) end
Variants.Substation_A = function(m) substation(m, C.Steel, C.Warning) end
Variants.Substation_B = function(m) substation(m, C.White, C.LightBlue) end
Variants.Substation_C = function(m) substation(m, C.SteelDark, C.Warning) end
Variants.Substation_D = function(m) substation(m, C.Steel, C.Coral) end

BuildingModels.Variants = Variants

function BuildingModels.hasVariant(variantId: string): boolean
	return Variants[variantId] ~= nil
end

-- Design footprint (before scaling) in design units.
function BuildingModels.designFootprint(def): (number, number)
	local scale = def.ModelScale or 1
	return def.Footprint[1] / scale, def.Footprint[2] / scale
end

-- Builds the model at the origin. Caller positions it with model:PivotTo(cframe).
function BuildingModels.build(def, variantId: string)
	local builder = Variants[variantId]
	assert(builder, "Unknown building variant " .. tostring(variantId))
	local model = Instance.new("Model")
	model.Name = variantId
	local dw, dd = BuildingModels.designFootprint(def)
	local root = part(
		model,
		"Root",
		Vector3.new(dw, 0.2, dd),
		CFrame.new(0, 0, 0),
		Color3.new(1, 1, 1),
		Enum.Material.SmoothPlastic,
		1
	)
	model.PrimaryPart = root
	builder(model)
	local scale = def.ModelScale or 1
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	local _, size = model:GetBoundingBox()
	model:SetAttribute("VisualHeight", size.Y)
	return model
end

return BuildingModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Countries</string>
            <string name="Source"><![CDATA[-- Countries: lookup helpers over the generated CountryRegistry (195 sovereign states).
-- Flags: FlagAsset is empty unless a real, verified Roblox asset id is provided.
-- When FlagAsset is empty the UI shows EmojiFallback.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local Registry = require(Config:WaitForChild("CountryRegistry"))

local Countries = {}

Countries.Continents = Registry.Continents
Countries.List = Registry.Countries

local byId = {}
local byContinent = {}
for _, continent in ipairs(Registry.Continents) do
	byContinent[continent] = {}
end
for _, entry in ipairs(Registry.Countries) do
	byId[entry.Id] = entry
	local bucket = byContinent[entry.Continent]
	if bucket then
		table.insert(bucket, entry)
	end
end
for _, bucket in pairs(byContinent) do
	table.sort(bucket, function(a, b)
		return a.DisplayNameEN < b.DisplayNameEN
	end)
end

function Countries.get(id: string)
	return byId[id]
end

function Countries.forContinent(continent: string)
	return byContinent[continent] or {}
end

function Countries.count(): number
	return #Registry.Countries
end

function Countries.hasRealFlag(entry): boolean
	return entry ~= nil and type(entry.FlagAsset) == "string" and entry.FlagAsset ~= ""
end

-- Case-insensitive plain-text search over English names (secondary navigation).
function Countries.search(query: string, continent: string?)
	local q = string.lower(query or "")
	local results = {}
	local source = continent and Countries.forContinent(continent) or Registry.Countries
	for _, entry in ipairs(source) do
		if q == "" or string.find(string.lower(entry.DisplayNameEN), q, 1, true) then
			table.insert(results, entry)
		end
	end
	return results
end

return Countries
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DefaultCountry</string>
            <string name="Source"><![CDATA[-- DefaultCountry: creates an EMPTY country from GameConfig.EmptyCountry and migrates old saves.
-- No starting resources, citizens, houses, roads, infrastructure or economy are ever granted.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))

local DefaultCountry = {}

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[k] = deepCopy(v)
	end
	return copy
end

DefaultCountry.deepCopy = deepCopy

-- Fill missing keys recursively (never overwrites existing values).
local function fillDefaults(target, defaults)
	for key, value in pairs(defaults) do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			fillDefaults(target[key], value)
		end
	end
end

function DefaultCountry.new(slotIndex: number, name: string, flagId: string, continent: string, technologyBranch: string)
	local country = deepCopy(GameConfig.EmptyCountry)
	country.SchemaVersion = GameConfig.SchemaVersion
	country.SlotIndex = slotIndex
	country.Name = name
	country.FlagId = flagId
	country.Continent = continent
	country.TechnologyBranch = technologyBranch
	country.CreatedAt = os.time()
	country.NextBuildingId = 1
	country.NextRoadId = 1
	return country
end

local UTILITY_DEFAULTS = {
	WaterRequired = 0,
	WaterSupplied = 0,
	WaterStatus = "GREY",
	PowerRequired = 0,
	PowerSupplied = 0,
	PowerStatus = "GREY",
}

-- v1 -> v2: buildings/roads were 4x larger (8-stud houses on a 480-stud plot with 8-stud road tiles).
-- Scaling positions by Migration.V1PositionScale maps the old layout exactly onto the new grid.
local function migrateV1(country)
	local scale = GameConfig.Migration.V1PositionScale
	if country.Money ~= nil then
		if country.Treasury == nil then
			country.Treasury = country.Money
		end
		country.Money = nil
	end
	for _, record in pairs(country.Buildings or {}) do
		if type(record.X) == "number" then
			record.X *= scale
		end
		if type(record.Z) == "number" then
			record.Z *= scale
		end
	end
	for _, segment in pairs(country.Roads or {}) do
		if type(segment.Position) == "table" then
			segment.Position.X = (segment.Position.X or 0) * scale
			segment.Position.Z = (segment.Position.Z or 0) * scale
		end
		-- Only the Straight Road type exists now; junctions are derived automatically.
		if segment.Type ~= "Straight" then
			segment.Rotation = 0
		end
		segment.Type = "Straight"
		segment.Openings = nil
	end
	country.MigratedFromSchema = country.SchemaVersion or 1
end

-- Fill missing fields for older saves without granting anything.
function DefaultCountry.migrate(country)
	local version = tonumber(country.SchemaVersion) or 1
	if version < 2 then
		migrateV1(country)
	end
	if country.Money ~= nil and country.Treasury == nil then
		country.Treasury = country.Money
	end
	country.Money = nil
	fillDefaults(country, GameConfig.EmptyCountry)
	for _, record in pairs(country.Buildings) do
		for key, value in pairs(UTILITY_DEFAULTS) do
			if record[key] == nil then
				record[key] = value
			end
		end
	end
	country.NextBuildingId = country.NextBuildingId or 1
	country.NextRoadId = country.NextRoadId or 1
	country.SchemaVersion = GameConfig.SchemaVersion
	return country
end

return DefaultCountry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">GridMath</string>
            <string name="Source"><![CDATA[--!strict
-- GridMath: pure geometry helpers shared by client preview and server validation.
-- Coordinates are world X/Z on the flat territory plane.

local GridMath = {}

GridMath.DirectionOrder = { "N", "E", "S", "W" }

-- Grid direction offsets. N points to -Z (Roblox forward), E to +X.
GridMath.DirectionOffset = {
	N = { 0, -1 },
	E = { 1, 0 },
	S = { 0, 1 },
	W = { -1, 0 },
}

GridMath.Opposite = { N = "S", S = "N", E = "W", W = "E" }

function GridMath.normalizeRotation(step: number): number
	return ((math.floor(step) % 4) + 4) % 4
end

-- Rotate a direction clockwise (seen from above) by `step` quarter turns.
function GridMath.rotateDirection(dir: string, step: number): string
	local index = table.find(GridMath.DirectionOrder, dir)
	assert(index, "Unknown direction " .. tostring(dir))
	local rotated = ((index - 1 + GridMath.normalizeRotation(step)) % 4) + 1
	return GridMath.DirectionOrder[rotated]
end

-- Yaw (radians) used for models so that visuals match rotateDirection.
function GridMath.yawForRotation(step: number): number
	return -math.rad(GridMath.normalizeRotation(step) * 90)
end

function GridMath.rotatedSize(width: number, depth: number, step: number): (number, number)
	if GridMath.normalizeRotation(step) % 2 == 1 then
		return depth, width
	end
	return width, depth
end

export type Rect = { minX: number, maxX: number, minZ: number, maxZ: number }

function GridMath.rect(centerX: number, centerZ: number, width: number, depth: number): Rect
	return {
		minX = centerX - width / 2,
		maxX = centerX + width / 2,
		minZ = centerZ - depth / 2,
		maxZ = centerZ + depth / 2,
	}
end

function GridMath.rectsOverlap(a: Rect, b: Rect, tolerance: number?): boolean
	local tol = tolerance or 0
	return a.minX < b.maxX - tol and a.maxX > b.minX + tol and a.minZ < b.maxZ - tol and a.maxZ > b.minZ + tol
end

function GridMath.rectInside(inner: Rect, outer: Rect, tolerance: number?): boolean
	local tol = tolerance or 0
	return inner.minX >= outer.minX - tol
		and inner.maxX <= outer.maxX + tol
		and inner.minZ >= outer.minZ - tol
		and inner.maxZ <= outer.maxZ + tol
end

function GridMath.pointRectDistance(x: number, z: number, r: Rect): number
	local dx = math.max(r.minX - x, 0, x - r.maxX)
	local dz = math.max(r.minZ - z, 0, z - r.maxZ)
	return math.sqrt(dx * dx + dz * dz)
end

-- Shortest distance between two rects (0 when they touch or overlap).
function GridMath.rectDistance(a: Rect, b: Rect): number
	local dx = math.max(b.minX - a.maxX, 0, a.minX - b.maxX)
	local dz = math.max(b.minZ - a.maxZ, 0, a.minZ - b.maxZ)
	return math.sqrt(dx * dx + dz * dz)
end

-- Snap a footprint so that its edges line up with the grid measured from (originX, originZ).
function GridMath.snapFootprint(
	x: number,
	z: number,
	width: number,
	depth: number,
	grid: number,
	originX: number,
	originZ: number
): (number, number)
	local minX = originX + math.floor((x - width / 2 - originX) / grid + 0.5) * grid
	local minZ = originZ + math.floor((z - depth / 2 - originZ) / grid + 0.5) * grid
	return minX + width / 2, minZ + depth / 2
end

-- Integer cell index containing a coordinate.
function GridMath.cellIndex(value: number, cellSize: number, origin: number): number
	return math.floor((value - origin) / cellSize)
end

function GridMath.cellCenter(index: number, cellSize: number, origin: number): number
	return origin + (index + 0.5) * cellSize
end

function GridMath.cellKey(ix: number, iz: number): string
	return tostring(ix) .. ":" .. tostring(iz)
end

return GridMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PlacementRules</string>
            <string name="Source"><![CDATA[-- PlacementRules: shared placement validation.
-- The client uses it for the live preview, the SERVER uses the same rules as the authority.
--
-- ctx = {
--     plot = Plots bounds (the requesting player's OWN plot),
--     buildingRects = { Rect, ... }, -- world-space footprints of existing buildings
--     roadCells = { ["ix:iz"] = Rect, ... } -- world-space rects of existing road tiles
-- }

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local PlacementConfig = require(Config:WaitForChild("PlacementConfig"))
local GridMath = require(Shared:WaitForChild("Modules"):WaitForChild("GridMath"))

local PlacementRules = {}

PlacementRules.Reasons = {
	Ok = "OK",
	OutsideTerritory = "Outside your plot",
	OverlapBuilding = "Overlaps a building",
	OverlapRoad = "Overlaps a road",
	RoadOccupied = "Road already here",
	TooFarFromRoad = "Too far from road",
	NoRoads = "Build a road first",
	UnknownType = "Unknown type",
	RoadTooLong = "Road is too long",
	NotEnoughTreasury = "Not enough treasury",
}

function PlacementRules.plotRect(plot)
	return { minX = plot.minX, maxX = plot.maxX, minZ = plot.minZ, maxZ = plot.maxZ }
end

-- Snap a world point to a building footprint. Returns centerX, centerZ, rect, width, depth.
function PlacementRules.snapBuilding(def, worldX: number, worldZ: number, rotation: number, plot)
	local width, depth = GridMath.rotatedSize(def.Footprint[1], def.Footprint[2], rotation)
	local cx, cz =
		GridMath.snapFootprint(worldX, worldZ, width, depth, PlacementConfig.GridSize, plot.minX, plot.minZ)
	return cx, cz, GridMath.rect(cx, cz, width, depth), width, depth
end

-- Snap a world point to a road tile. Returns ix, iz, centerX, centerZ, rect.
function PlacementRules.snapRoad(worldX: number, worldZ: number, plot)
	local size = PlacementConfig.RoadTileSize
	local ix = GridMath.cellIndex(worldX, size, plot.minX)
	local iz = GridMath.cellIndex(worldZ, size, plot.minZ)
	return ix, iz, PlacementRules.roadCellCenter(ix, iz, plot)
end

function PlacementRules.roadCellCenter(ix: number, iz: number, plot)
	local size = PlacementConfig.RoadTileSize
	local cx = GridMath.cellCenter(ix, size, plot.minX)
	local cz = GridMath.cellCenter(iz, size, plot.minZ)
	return cx, cz, GridMath.rect(cx, cz, size, size)
end

-- Distance from a point to the nearest road tile. Returns math.huge when no roads exist.
function PlacementRules.nearestRoadDistance(x: number, z: number, roadCells): number
	local best = math.huge
	for _, rect in pairs(roadCells) do
		local d = GridMath.pointRectDistance(x, z, rect)
		if d < best then
			best = d
		end
	end
	return best
end

-- Distance from a footprint edge to the nearest road tile (buildings face the road).
function PlacementRules.nearestRoadEdgeDistance(rect, roadCells): number
	local best = math.huge
	for _, roadRect in pairs(roadCells) do
		local d = GridMath.rectDistance(rect, roadRect)
		if d < best then
			best = d
		end
	end
	return best
end

-- Returns ok, reason, info
function PlacementRules.validateBuilding(def, worldX: number, worldZ: number, rotation: number, ctx)
	if not def then
		return false, PlacementRules.Reasons.UnknownType, nil
	end
	local tol = PlacementConfig.OverlapTolerance
	local cx, cz, rect = PlacementRules.snapBuilding(def, worldX, worldZ, rotation, ctx.plot)
	local info = { centerX = cx, centerZ = cz, rect = rect, roadDistance = math.huge }

	if not GridMath.rectInside(rect, PlacementRules.plotRect(ctx.plot), tol) then
		return false, PlacementRules.Reasons.OutsideTerritory, info
	end
	for _, other in ipairs(ctx.buildingRects) do
		if GridMath.rectsOverlap(rect, other, tol) then
			return false, PlacementRules.Reasons.OverlapBuilding, info
		end
	end
	for _, roadRect in pairs(ctx.roadCells) do
		if GridMath.rectsOverlap(rect, roadRect, tol) then
			return false, PlacementRules.Reasons.OverlapRoad, info
		end
	end
	if PlacementConfig.RequireRoadAccess then
		if next(ctx.roadCells) == nil then
			return false, PlacementRules.Reasons.NoRoads, info
		end
		local distance = PlacementRules.nearestRoadEdgeDistance(rect, ctx.roadCells)
		info.roadDistance = distance
		if distance > PlacementConfig.MaxRoadDistance then
			return false, PlacementRules.Reasons.TooFarFromRoad, info
		end
	end
	return true, PlacementRules.Reasons.Ok, info
end

-- Single road tile validation (kept for the PlaceRoad remote and tests).
function PlacementRules.validateRoad(worldX: number, worldZ: number, ctx)
	local tol = PlacementConfig.OverlapTolerance
	local ix, iz, cx, cz, rect = PlacementRules.snapRoad(worldX, worldZ, ctx.plot)
	local info = { ix = ix, iz = iz, centerX = cx, centerZ = cz, rect = rect }
	if not GridMath.rectInside(rect, PlacementRules.plotRect(ctx.plot), tol) then
		return false, PlacementRules.Reasons.OutsideTerritory, info
	end
	if ctx.roadCells[GridMath.cellKey(ix, iz)] then
		return false, PlacementRules.Reasons.RoadOccupied, info
	end
	for _, other in ipairs(ctx.buildingRects) do
		if GridMath.rectsOverlap(rect, other, tol) then
			return false, PlacementRules.Reasons.OverlapBuilding, info
		end
	end
	return true, PlacementRules.Reasons.Ok, info
end

-- Cells of a straight drag from A to B, snapped to the dominant axis (grid + direction).
-- Returns cells { {ix, iz}, ... }, axis (0 = along Z / N-S, 1 = along X / E-W), fullLength.
function PlacementRules.roadLine(startX: number, startZ: number, endX: number, endZ: number, plot)
	local size = PlacementConfig.RoadTileSize
	local ix0 = GridMath.cellIndex(startX, size, plot.minX)
	local iz0 = GridMath.cellIndex(startZ, size, plot.minZ)
	local ix1 = GridMath.cellIndex(endX, size, plot.minX)
	local iz1 = GridMath.cellIndex(endZ, size, plot.minZ)
	local dx, dz = ix1 - ix0, iz1 - iz0
	local cells = {}
	local axis
	if math.abs(dx) >= math.abs(dz) then
		axis = 1
		local stepX = dx >= 0 and 1 or -1
		for i = 0, math.abs(dx) do
			table.insert(cells, { ix0 + i * stepX, iz0 })
		end
	else
		axis = 0
		local stepZ = dz >= 0 and 1 or -1
		for i = 0, math.abs(dz) do
			table.insert(cells, { ix0, iz0 + i * stepZ })
		end
	end
	if #cells == 1 then
		axis = 0
	end
	return cells, axis, #cells
end

-- Validates a drag line. Existing road tiles on the line are allowed (they become junctions)
-- and are skipped. Returns ok, reason, tiles, newCount where each tile =
-- { ix, iz, centerX, centerZ, rect, valid, existing, reason }.
function PlacementRules.validateRoadLine(cells, ctx)
	local tol = PlacementConfig.OverlapTolerance
	local plotRect = PlacementRules.plotRect(ctx.plot)
	local tiles = {}
	local firstReason = nil
	local newCount = 0
	if #cells > PlacementConfig.MaxRoadDragTiles then
		return false, PlacementRules.Reasons.RoadTooLong, tiles, 0
	end
	for _, cell in ipairs(cells) do
		local ix, iz = cell[1], cell[2]
		local cx, cz, rect = PlacementRules.roadCellCenter(ix, iz, ctx.plot)
		local tile = { ix = ix, iz = iz, centerX = cx, centerZ = cz, rect = rect, valid = true, existing = false }
		if not GridMath.rectInside(rect, plotRect, tol) then
			tile.valid = false
			tile.reason = PlacementRules.Reasons.OutsideTerritory
		elseif ctx.roadCells[GridMath.cellKey(ix, iz)] then
			tile.existing = true
		else
			for _, other in ipairs(ctx.buildingRects) do
				if GridMath.rectsOverlap(rect, other, tol) then
					tile.valid = false
					tile.reason = PlacementRules.Reasons.OverlapBuilding
					break
				end
			end
		end
		if tile.valid and not tile.existing then
			newCount += 1
		end
		if not tile.valid and firstReason == nil then
			firstReason = tile.reason
		end
		table.insert(tiles, tile)
	end
	if firstReason then
		return false, firstReason, tiles, newCount
	end
	if newCount == 0 then
		return false, PlacementRules.Reasons.RoadOccupied, tiles, 0
	end
	return true, PlacementRules.Reasons.Ok, tiles, newCount
end

return PlacementRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[-- Plots: geometry of the 6 player plots (islands around the central island) and their exits.
-- Building and road positions are saved in plot-LOCAL coordinates, so a country can be loaded
-- onto any free plot in a later session.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local PlacementConfig = require(Config:WaitForChild("PlacementConfig"))

local Plots = {}

local SIDE_VECTOR = {
	N = { 0, -1 },
	E = { 1, 0 },
	S = { 0, 1 },
	W = { -1, 0 },
}
Plots.SideVector = SIDE_VECTOR

local function plotConfig(index: number)
	return GameConfig.Map.Plots[index]
end

function Plots.isValidIndex(index: any): boolean
	return type(index) == "number" and index == math.floor(index) and index >= 1 and index <= Plots.maxPlots()
end

function Plots.getBounds(index: number)
	local cfg = plotConfig(index)
	assert(cfg, "Unknown plot " .. tostring(index))
	local t = GameConfig.Territory
	local half = t.Size / 2
	return {
		index = index,
		centerX = cfg.CenterX,
		centerZ = cfg.CenterZ,
		minX = cfg.CenterX - half,
		maxX = cfg.CenterX + half,
		minZ = cfg.CenterZ - half,
		maxZ = cfg.CenterZ + half,
		size = t.Size,
		surfaceY = t.SurfaceY,
		exitSide = cfg.ExitSide,
	}
end

function Plots.toWorld(bounds, localX: number, localZ: number): (number, number)
	return bounds.minX + localX, bounds.minZ + localZ
end

function Plots.toLocal(bounds, worldX: number, worldZ: number): (number, number)
	return worldX - bounds.minX, worldZ - bounds.minZ
end

function Plots.maxPlots(): number
	return math.min(#GameConfig.Map.Plots, GameConfig.Territory.MaxPlots)
end

-- Returns the plot index containing a world point (buildable area only), or nil.
function Plots.plotAt(worldX: number, worldZ: number): number?
	for index = 1, Plots.maxPlots() do
		local b = Plots.getBounds(index)
		if worldX >= b.minX and worldX <= b.maxX and worldZ >= b.minZ and worldZ <= b.maxZ then
			return index
		end
	end
	return nil
end

-- Exit of a plot: the road tile on the plot edge that faces the central island, plus the
-- bridge waypoints PLOT -> EXIT -> MAIN MAP -> CENTRAL ISLAND (used by future vehicles).
function Plots.getExit(index: number)
	local b = Plots.getBounds(index)
	local tile = PlacementConfig.RoadTileSize
	local tiles = math.floor(b.size / tile)
	local mid = math.floor(tiles / 2)
	local side = b.exitSide
	local ix, iz
	if side == "N" then
		ix, iz = mid, 0
	elseif side == "S" then
		ix, iz = mid, tiles - 1
	elseif side == "E" then
		ix, iz = tiles - 1, mid
	else
		ix, iz = 0, mid
	end
	local tileX = b.minX + (ix + 0.5) * tile
	local tileZ = b.minZ + (iz + 0.5) * tile
	local v = SIDE_VECTOR[side]
	local rim = GameConfig.Territory.RimWidth
	local half = b.size / 2
	local edgeX, edgeZ = b.centerX + v[1] * half, b.centerZ + v[2] * half
	if v[1] == 0 then
		edgeX = tileX
	else
		edgeZ = tileZ
	end
	local rimX, rimZ = edgeX + v[1] * rim, edgeZ + v[2] * rim

	local central = GameConfig.Map.CentralIsland
	local ch = central.Size / 2
	local landX, landZ = rimX, rimZ
	if side == "S" then
		landZ = central.CenterZ - ch + central.BeachWidth
	elseif side == "N" then
		landZ = central.CenterZ + ch - central.BeachWidth
	elseif side == "E" then
		landX = central.CenterX - ch + central.BeachWidth
	else
		landX = central.CenterX + ch - central.BeachWidth
	end
	return {
		plotIndex = index,
		side = side,
		ix = ix,
		iz = iz,
		key = tostring(ix) .. ":" .. tostring(iz),
		tileX = tileX,
		tileZ = tileZ,
		edgeX = edgeX,
		edgeZ = edgeZ,
		bridgeStartX = rimX,
		bridgeStartZ = rimZ,
		bridgeEndX = landX,
		bridgeEndZ = landZ,
		waypoints = {
			{ X = tileX, Z = tileZ },
			{ X = edgeX, Z = edgeZ },
			{ X = rimX, Z = rimZ },
			{ X = landX, Z = landZ },
			{ X = central.CenterX, Z = central.CenterZ },
		},
	}
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RoadGraph</string>
            <string name="Source"><![CDATA[-- RoadGraph: pure road-network logic (no Instances).
-- Only ONE road type exists (Straight Road). Junction shapes are derived automatically:
-- every tile connects to all 4-adjacent road tiles, so curbs disappear where a branch joins.
--
-- Segment record fields (saved): RoadId, Type, Rotation, Ix, Iz, Position {X, Z} (plot-local)
-- Derived fields (recomputed): Neighbours, Adjacent, Connected, Openings ("NS", "NES", ...), ExitConnected
-- Neighbours are true bidirectional edges, ready for vehicle pathfinding (trucks, tanks, IFV...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RoadConfig = require(Shared:WaitForChild("Config"):WaitForChild("RoadConfig"))
local GridMath = require(Shared:WaitForChild("Modules"):WaitForChild("GridMath"))

local RoadGraph = {}

local typeById = {}
for _, roadType in ipairs(RoadConfig.Types) do
	typeById[roadType.Id] = roadType
end

RoadGraph.DefaultType = RoadConfig.Types[1].Id

function RoadGraph.getType(typeId: string)
	return typeById[typeId]
end

-- Static openings of a type after rotation (used for isolated tiles / legacy data).
function RoadGraph.openings(typeId: string, rotation: number)
	local roadType = typeById[typeId] or typeById[RoadGraph.DefaultType]
	local result = {}
	if not roadType then
		return result
	end
	for _, dir in ipairs(roadType.Openings) do
		result[GridMath.rotateDirection(dir, rotation)] = true
	end
	return result
end

function RoadGraph.openingsToString(set): string
	local s = ""
	for _, dir in ipairs(GridMath.DirectionOrder) do
		if set[dir] then
			s ..= dir
		end
	end
	return s
end

function RoadGraph.stringToOpenings(s: string?)
	local set = {}
	for _, dir in ipairs(GridMath.DirectionOrder) do
		if s and string.find(s, dir, 1, true) then
			set[dir] = true
		end
	end
	return set
end

-- exit (optional) = { key = "ix:iz", side = "N"|"E"|"S"|"W" } from Plots.getExit
local function refreshSegment(segmentsByCell, segment, exit)
	local neighbours = {}
	local adjacent = {}
	local open = {}
	local count = 0
	for _, dir in ipairs(GridMath.DirectionOrder) do
		local offset = GridMath.DirectionOffset[dir]
		local other = segmentsByCell[GridMath.cellKey(segment.Ix + offset[1], segment.Iz + offset[2])]
		if other then
			table.insert(adjacent, other.RoadId)
			if RoadConfig.AutoConnect ~= false then
				table.insert(neighbours, other.RoadId)
				open[dir] = true
				count += 1
			else
				local mine = RoadGraph.openings(segment.Type, segment.Rotation)
				local theirs = RoadGraph.openings(other.Type, other.Rotation)
				if mine[dir] and theirs[GridMath.Opposite[dir]] then
					table.insert(neighbours, other.RoadId)
					open[dir] = true
					count += 1
				end
			end
		end
	end
	local exitConnected = exit ~= nil and exit.key == GridMath.cellKey(segment.Ix, segment.Iz)
	if exitConnected then
		open[exit.side] = true
		count += 1
	end
	if count == 0 then
		open = RoadGraph.openings(segment.Type, segment.Rotation)
	elseif count == 1 then
		-- Dead end keeps a straight look (open on both ends, curbs along the sides).
		for dir in pairs(open) do
			open[GridMath.Opposite[dir]] = true
		end
	end
	local before = segment.Openings
	segment.Neighbours = neighbours
	segment.Adjacent = adjacent
	segment.Connected = #neighbours > 0 or exitConnected
	segment.ExitConnected = exitConnected
	segment.Openings = RoadGraph.openingsToString(open)
	return before ~= segment.Openings
end

-- Recompute a segment and its four adjacent cells after a change.
-- Returns the list of segments whose visual openings changed (they must be rebuilt).
function RoadGraph.updateAround(segmentsByCell, ix: number, iz: number, exit)
	local changed = {}
	local center = segmentsByCell[GridMath.cellKey(ix, iz)]
	if center then
		refreshSegment(segmentsByCell, center, exit)
		table.insert(changed, center)
	end
	for _, dir in ipairs(GridMath.DirectionOrder) do
		local offset = GridMath.DirectionOffset[dir]
		local other = segmentsByCell[GridMath.cellKey(ix + offset[1], iz + offset[2])]
		if other and refreshSegment(segmentsByCell, other, exit) then
			table.insert(changed, other)
		end
	end
	return changed
end

function RoadGraph.recomputeAll(segmentsByCell, exit)
	for _, segment in pairs(segmentsByCell) do
		refreshSegment(segmentsByCell, segment, exit)
	end
end

-- Breadth-first count of the network reachable from a RoadId.
function RoadGraph.networkSize(segmentsById, startId: string): number
	local visited = { [startId] = true }
	local queue = { startId }
	local head = 1
	local count = 0
	while head <= #queue do
		local id = queue[head]
		head += 1
		local segment = segmentsById[id]
		if segment then
			count += 1
			for _, n in ipairs(segment.Neighbours or {}) do
				if not visited[n] then
					visited[n] = true
					table.insert(queue, n)
				end
			end
		end
	end
	return count
end

-- BFS shortest path (in tiles). goal = RoadId or predicate(segment) -> boolean.
-- Returns { RoadId, ... } from start to goal, or nil.
function RoadGraph.findPath(segmentsById, startId: string, goal)
	if not segmentsById[startId] then
		return nil
	end
	local isGoal
	if type(goal) == "function" then
		isGoal = goal
	else
		isGoal = function(segment)
			return segment.RoadId == goal
		end
	end
	local parent = { [startId] = false }
	local queue = { startId }
	local head = 1
	while head <= #queue do
		local id = queue[head]
		head += 1
		local segment = segmentsById[id]
		if segment and isGoal(segment) then
			local path = {}
			local cursor = id
			while cursor do
				table.insert(path, 1, cursor)
				cursor = parent[cursor]
			end
			return path
		end
		if segment then
			for _, n in ipairs(segment.Neighbours or {}) do
				if parent[n] == nil then
					parent[n] = id
					table.insert(queue, n)
				end
			end
		end
	end
	return nil
end

-- Path from a road tile to the plot exit (PLAYER PLOT -> EXIT). nil when not reachable.
function RoadGraph.pathToExit(segmentsById, startId: string)
	return RoadGraph.findPath(segmentsById, startId, function(segment)
		return segment.ExitConnected == true
	end)
end

return RoadGraph
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RoadModels</string>
            <string name="Source"><![CDATA[-- RoadModels: procedural Straight Road tile, small, clean and gray, with low curbs on both sides.
-- Openings ("NS", "NES", ...) come from RoadGraph: curbs are only built on CLOSED sides,
-- so a branch to the left/right removes the curb at the joint (no curb through a junction).
-- Inner corner posts are added where two open sides meet, so junction curbs look finished.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RoadConfig = require(Shared:WaitForChild("Config"):WaitForChild("RoadConfig"))

local RoadModels = {}

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local ASPHALT = rgb(RoadConfig.Colors.Asphalt)
local CURB = rgb(RoadConfig.Colors.Curb)
local MARKING = rgb(RoadConfig.Colors.Marking)

local function part(model, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(position)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p:SetAttribute("BaseTransparency", 0)
	p.Parent = model
	return p
end

local OFFSET = {
	N = { 0, -1 },
	E = { 1, 0 },
	S = { 0, 1 },
	W = { -1, 0 },
}

local function openSet(openings: string?)
	local set = {}
	local s = openings or "NS"
	for _, dir in ipairs({ "N", "E", "S", "W" }) do
		if string.find(s, dir, 1, true) then
			set[dir] = true
		end
	end
	return set
end

-- Builds a tile at the origin in WORLD orientation (no rotation needed, openings are world sides).
-- typeId is kept for API compatibility; only "Straight" exists.
function RoadModels.build(typeId: string?, openings: string?)
	local size = RoadConfig.TileSize
	local half = size / 2
	local curbW = RoadConfig.CurbWidth
	local curbH = RoadConfig.CurbHeight
	local asphaltH = RoadConfig.AsphaltHeight
	local open = openSet(openings)

	local model = Instance.new("Model")
	model.Name = "Road_" .. tostring(typeId or "Straight")

	local root = part(model, "Root", Vector3.new(size, 0.05, size), Vector3.new(0, 0.025, 0), ASPHALT)
	root.Transparency = 1
	root:SetAttribute("BaseTransparency", 1)
	model.PrimaryPart = root

	part(model, "Asphalt", Vector3.new(size, asphaltH, size), Vector3.new(0, asphaltH / 2, 0), ASPHALT, Enum.Material.Concrete)

	-- Curbs along closed sides.
	for dir, o in pairs(OFFSET) do
		if not open[dir] then
			local pos = Vector3.new(o[1] * (half - curbW / 2), asphaltH + curbH / 2, o[2] * (half - curbW / 2))
			local curbSize
			if o[1] == 0 then
				curbSize = Vector3.new(size, curbH, curbW)
			else
				curbSize = Vector3.new(curbW, curbH, size)
			end
			part(model, "Curb" .. dir, curbSize, pos, CURB)
		end
	end
	-- Inner corner posts where two OPEN sides meet (junction corners).
	local corners = { { "N", "E" }, { "E", "S" }, { "S", "W" }, { "W", "N" } }
	for _, pair in ipairs(corners) do
		if open[pair[1]] and open[pair[2]] then
			local a, b = OFFSET[pair[1]], OFFSET[pair[2]]
			local cx = (a[1] + b[1]) * (half - curbW / 2)
			local cz = (a[2] + b[2]) * (half - curbW / 2)
			part(model, "Post" .. pair[1] .. pair[2], Vector3.new(curbW, curbH, curbW), Vector3.new(cx, asphaltH + curbH / 2, cz), CURB)
		end
	end
	-- Center dash along each open axis (subtle, flat).
	local nsOpen = open.N or open.S
	local ewOpen = open.E or open.W
	local count = 0
	for _ in pairs(open) do
		count += 1
	end
	if count <= 2 then
		if nsOpen and not ewOpen then
			part(model, "Dash", Vector3.new(0.08, 0.02, size * 0.45), Vector3.new(0, asphaltH + 0.01, 0), MARKING)
		elseif ewOpen and not nsOpen then
			part(model, "Dash", Vector3.new(size * 0.45, 0.02, 0.08), Vector3.new(0, asphaltH + 0.01, 0), MARKING)
		end
	end
	return model
end

-- Lightweight flat tile used for the drag preview (one part, no curbs).
function RoadModels.previewTile(): Part
	local size = RoadConfig.TileSize
	local p = Instance.new("Part")
	p.Name = "RoadPreviewTile"
	p.Size = Vector3.new(size - 0.08, 0.12, size - 0.08)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

return RoadModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">UtilityGrid</string>
            <string name="Source"><![CDATA[-- UtilityGrid: pure coverage/allocation logic shared by WaterService and PowerService (no Instances).
--
-- A source (completed building with def[kind].Production > 0) supplies consumers whose centers are
-- within def[kind].Radius studs. Consumers are served in a stable order (oldest building first) from
-- the nearest sources with remaining capacity. An optional storage pool (water) covers the rest,
-- but only for consumers that are inside the radius of at least one source.
--
-- Status: GREEN = fully supplied, RED = shortage / no coverage, GREY = not required or not built yet.

local UtilityGrid = {}

UtilityGrid.Status = { Green = "GREEN", Red = "RED", Grey = "GREY" }

local COMPLETED = "COMPLETED"

local function idNumber(id: string): number
	return tonumber(string.match(id or "", "%d+")) or 0
end

local function sortedRecords(buildings)
	local list = {}
	for _, record in pairs(buildings) do
		table.insert(list, record)
	end
	table.sort(list, function(a, b)
		return idNumber(a.Id) < idNumber(b.Id)
	end)
	return list
end
UtilityGrid.sortedRecords = sortedRecords

local function distance(a, b): number
	local dx, dz = (a.X or 0) - (b.X or 0), (a.Z or 0) - (b.Z or 0)
	return math.sqrt(dx * dx + dz * dz)
end

-- buildings: { [Id] = record }, defsById: { [TypeId] = def }, kind: "Water" | "Power"
-- options: { pool = number? } (units available from storage this cycle)
-- Returns result = {
--     production, demand, supplied, fromProduction, fromPool, sources, consumers,
--     covered, uncovered, perRecord = { [Id] = { Required, Supplied, Status, Pending } }
-- }
function UtilityGrid.compute(buildings, defsById, kind: string, options)
	local pool = (options and options.pool) or 0
	local result = {
		production = 0,
		demand = 0,
		supplied = 0,
		fromProduction = 0,
		fromPool = 0,
		sources = 0,
		consumers = 0,
		covered = 0,
		uncovered = 0,
		perRecord = {},
	}
	local list = sortedRecords(buildings)
	local sources = {}
	for _, record in ipairs(list) do
		local def = defsById[record.Type]
		local spec = def and def[kind]
		if spec and record.State == COMPLETED and (spec.Production or 0) > 0 and not record[kind .. "Offline"] then
			table.insert(sources, { record = record, remaining = spec.Production, radius = spec.Radius or 0 })
			result.production += spec.Production
			result.sources += 1
		end
	end
	for _, record in ipairs(list) do
		local def = defsById[record.Type]
		local spec = def and def[kind]
		local required = spec and spec.Required or 0
		local entry = { Required = required, Supplied = 0, Status = UtilityGrid.Status.Grey, Pending = false }
		if required > 0 and record.State ~= COMPLETED then
			entry.Pending = true
		elseif required > 0 then
			result.consumers += 1
			result.demand += required
			local candidates = {}
			for _, source in ipairs(sources) do
				local d = distance(record, source.record)
				if d <= source.radius then
					table.insert(candidates, { source = source, d = d })
				end
			end
			table.sort(candidates, function(a, b)
				return a.d < b.d
			end)
			local need = required
			for _, c in ipairs(candidates) do
				if need <= 0 then
					break
				end
				local take = math.min(need, c.source.remaining)
				if take > 0 then
					c.source.remaining -= take
					need -= take
					result.fromProduction += take
				end
			end
			if need > 0 and #candidates > 0 and pool > 0 then
				local take = math.min(need, pool)
				pool -= take
				need -= take
				result.fromPool += take
			end
			if #candidates > 0 then
				result.covered += 1
			else
				result.uncovered += 1
			end
			entry.Supplied = required - need
			result.supplied += entry.Supplied
			entry.Status = need <= 0 and UtilityGrid.Status.Green or UtilityGrid.Status.Red
		end
		result.perRecord[record.Id] = entry
	end
	return result
end

-- Writes the result into the records (WaterRequired / WaterSupplied / WaterStatus etc.).
-- Returns true if any record changed.
function UtilityGrid.apply(buildings, kind: string, result): boolean
	local changed = false
	for id, entry in pairs(result.perRecord) do
		local record = buildings[id]
		if record then
			local status = entry.Status
			if record[kind .. "Status"] ~= status or record[kind .. "Supplied"] ~= entry.Supplied or record[kind .. "Required"] ~= entry.Required then
				changed = true
			end
			record[kind .. "Required"] = entry.Required
			record[kind .. "Supplied"] = entry.Supplied
			record[kind .. "Status"] = status
		end
	end
	return changed
end

-- Total storage capacity of completed sources (water towers).
function UtilityGrid.capacity(buildings, defsById, kind: string): number
	local total = 0
	for _, record in pairs(buildings) do
		local def = defsById[record.Type]
		local spec = def and def[kind]
		if spec and record.State == COMPLETED and (spec.Capacity or 0) > 0 then
			total += spec.Capacity
		end
	end
	return total
end

return UtilityGrid
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Types</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[-- Types: shared Luau type definitions (documentation + type checking only, no runtime logic).

export type BuildState = "PLANNED" | "UNDER_CONSTRUCTION" | "COMPLETED"
export type UtilityStatus = "GREEN" | "RED" | "GREY"

export type BuildingRecord = {
	Id: string,
	Type: string,
	Variant: string,
	X: number, -- plot-local center X
	Z: number, -- plot-local center Z
	Rotation: number, -- 0..3 quarter turns clockwise
	State: BuildState,
	PlannedElapsed: number,
	Progress: number, -- seconds of construction completed
	CreatedAt: number,
	WaterRequired: number,
	WaterSupplied: number,
	WaterStatus: UtilityStatus,
	PowerRequired: number,
	PowerSupplied: number,
	PowerStatus: UtilityStatus,
}

export type RoadSegment = {
	RoadId: string,
	Type: string, -- always "Straight" (junction visuals are derived automatically)
	Rotation: number, -- 0 = drawn along Z (N-S), 1 = drawn along X (E-W)
	Ix: number,
	Iz: number,
	Position: { X: number, Z: number }, -- plot-local tile center
	Neighbours: { string }, -- connected RoadIds (graph edges)
	Adjacent: { string }, -- touching RoadIds
	Connected: boolean,
	Openings: string, -- e.g. "NS", "NES" (derived)
	ExitConnected: boolean, -- tile touches the plot exit
}

export type Infrastructure = {
	Water: { Stored: number, Production: number, Demand: number },
	Power: { Production: number, Demand: number },
	Shortage: { Stage: string, Seconds: number },
}

export type Country = {
	SchemaVersion: number,
	SlotIndex: number,
	Name: string,
	FlagId: string,
	Continent: string,
	TechnologyBranch: string,
	CreatedAt: number,
	Treasury: number,
	Oil: number,
	Fuel: number,
	Steel: number,
	Supplies: number,
	Population: number,
	Workers: number,
	HousingCapacity: number,
	Buildings: { [string]: BuildingRecord },
	Roads: { [string]: RoadSegment },
	Military: { [string]: any },
	Infrastructure: Infrastructure,
	LastPlotIndex: number,
	NextBuildingId: number,
	NextRoadId: number,
}

export type SlotSummary = {
	Index: number,
	Locked: boolean,
	Empty: boolean,
	Name: string?,
	FlagId: string?,
	TechnologyBranch: string?,
	Population: number?,
}

export type PlotInfo = {
	Index: number,
	Free: boolean,
	OwnerName: string?,
	OwnerUserId: number?,
	CountryName: string?,
	FlagId: string?,
}

return {}
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="42">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="43">
      <Properties>
        <string name="Name">ServerMain</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ServerMain: single server entry point. Requires every system, calls init() then start().
-- Systems never run from their own Script; order is explicit here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))

local Systems = script.Parent:WaitForChild("Systems")

-- Remotes are defined in default.project.json (Rojo). If they are missing (e.g. playing without
-- Rojo), create them once. FindFirstChild guards prevent duplicates.
local function ensureRemotes()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	local remotes = {}
	for _, name in ipairs(Constants.RemoteFunctions) do
		local r = folder:FindFirstChild(name)
		if not r then
			r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
			warn("[ServerMain] Created missing RemoteFunction " .. name)
		end
		remotes[name] = r
	end
	for _, name in ipairs(Constants.RemoteEvents) do
		local r = folder:FindFirstChild(name)
		if not r then
			r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
			warn("[ServerMain] Created missing RemoteEvent " .. name)
		end
		remotes[name] = r
	end
	return remotes
end

local ORDER = {
	{ "Data", "DataService" },
	{ "World", "WorldService" },
	{ "Resources", "ResourceService" },
	{ "Roads", "RoadService" },
	{ "Buildings", "BuildingService" },
	{ "Construction", "ConstructionService" },
	{ "Water", "WaterService" },
	{ "Power", "PowerService" },
	{ "Population", "PopulationService" },
	{ "Stats", "StatsService" },
	{ "Country", "CountryService" },
	{ "Research", "ResearchService" },
	{ "Production", "ProductionService" },
	{ "Economy", "EconomyService" },
	{ "Vehicles", "VehicleService" },
	{ "Military", "MilitaryService" },
}

local services = { Remotes = ensureRemotes() }
local loaded = {}

for _, entry in ipairs(ORDER) do
	local folderName, moduleName = entry[1], entry[2]
	local moduleScript = Systems:WaitForChild(folderName):WaitForChild(moduleName)
	local ok, result = pcall(require, moduleScript)
	if not ok then
		error(string.format("[ServerMain] Failed to load %s: %s", moduleName, tostring(result)))
	end
	services[moduleName] = result
	table.insert(loaded, result)
end

for _, service in ipairs(loaded) do
	service.init(services)
end
for _, service in ipairs(loaded) do
	service.start()
end

ReplicatedStorage:SetAttribute("WarStateServerReady", true)
print(string.format("[WarState] Server ready (%d systems)", #loaded))
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="44">
      <Properties>
        <string name="Name">Systems</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Buildings</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BuildingService</string>
            <string name="Source"><![CDATA[-- BuildingService: server-authoritative building placement and demolition.
-- Client sends {Type, Variant, X, Z, Rotation}; the server snaps and validates against the
-- player's OWN plot (territory, overlap, road access within PlacementConfig.MaxRoadDistance,
-- resources) and creates a PLANNED building that ConstructionService builds over time.
-- Demolish requests are only accepted for records that exist in the requester's own country,
-- so nobody can build, delete or modify anything on another player's plot.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Modules = Shared:WaitForChild("Modules")
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local PlacementConfig = require(Config:WaitForChild("PlacementConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local GridMath = require(Modules:WaitForChild("GridMath"))
local PlacementRules = require(Modules:WaitForChild("PlacementRules"))
local BuildingModels = require(Modules:WaitForChild("BuildingModels"))

local BuildingService = {}
BuildingService.Name = "BuildingService"

local services
local remotes
local runtime = {} -- [Player] = { models = {Id -> Model}, rects = {Id -> Rect} }
local lastRequest = {}

local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end
BuildingService.DefsById = defsById

function BuildingService.getDef(typeId: string)
	return defsById[typeId]
end

local function getRuntime(player)
	local r = runtime[player]
	if not r then
		r = { models = {}, rects = {} }
		runtime[player] = r
	end
	return r
end

local function worldRect(record, bounds)
	local def = defsById[record.Type]
	local width, depth = GridMath.rotatedSize(def.Footprint[1], def.Footprint[2], record.Rotation)
	return GridMath.rect(bounds.minX + record.X, bounds.minZ + record.Z, width, depth)
end

local function spawnModel(player, record)
	local folder = services.WorldService.getPlotFolder(player, "Buildings")
	local bounds = services.WorldService.getBounds(player)
	local def = defsById[record.Type]
	if not folder or not bounds or not def then
		return nil
	end
	local r = getRuntime(player)
	local old = r.models[record.Id]
	if old then
		old:Destroy()
	end
	local model = BuildingModels.build(def, record.Variant)
	model.Name = record.Id
	local wx, wz = bounds.minX + record.X, bounds.minZ + record.Z
	model:PivotTo(CFrame.new(wx, bounds.surfaceY, wz) * CFrame.Angles(0, GridMath.yawForRotation(record.Rotation), 0))
	local rect = worldRect(record, bounds)
	model:SetAttribute(Constants.Attributes.Kind, "Building")
	model:SetAttribute(Constants.Attributes.TypeId, record.Type)
	model:SetAttribute(Constants.Attributes.OwnerUserId, player.UserId)
	model:SetAttribute("Variant", record.Variant)
	model:SetAttribute("RectMinX", rect.minX)
	model:SetAttribute("RectMaxX", rect.maxX)
	model:SetAttribute("RectMinZ", rect.minZ)
	model:SetAttribute("RectMaxZ", rect.maxZ)
	model:SetAttribute("State", record.State)
	model:SetAttribute("BuildTime", def.BuildTimeSeconds)
	model:SetAttribute("WaterStatus", record.WaterStatus or "GREY")
	model:SetAttribute("PowerStatus", record.PowerStatus or "GREY")
	model.Parent = folder
	r.models[record.Id] = model
	r.rects[record.Id] = rect
	return model
end

function BuildingService.getModel(player: Player, id: string)
	local r = runtime[player]
	return r and r.models[id] or nil
end

function BuildingService.getBuildingRects(player: Player)
	local result = {}
	local r = runtime[player]
	if r then
		for _, rect in pairs(r.rects) do
			table.insert(result, rect)
		end
	end
	return result
end

-- Called whenever buildings are added/removed/completed: recompute water + power coverage,
-- housing capacity, then replicate. Event-driven (never a per-frame recalculation).
function BuildingService.onBuildingsChanged(player: Player)
	local country = services.DataService.getCountry(player)
	if not country then
		return
	end
	services.PopulationService.recalculate(country)
	services.WaterService.recompute(player)
	services.PowerService.recompute(player)
	services.DataService.markDirty(player)
	services.CountryService.push(player)
end

-- Mirror utility statuses onto the models (used by client overlays).
function BuildingService.refreshUtilityAttributes(player: Player)
	local country = services.DataService.getCountry(player)
	local r = runtime[player]
	if not country or not r then
		return
	end
	for id, model in pairs(r.models) do
		local record = country.Buildings[id]
		if record then
			model:SetAttribute("WaterStatus", record.WaterStatus or "GREY")
			model:SetAttribute("PowerStatus", record.PowerStatus or "GREY")
		end
	end
end

function BuildingService.loadCountry(player: Player, country)
	BuildingService.clearPlayer(player)
	for _, record in pairs(country.Buildings) do
		if defsById[record.Type] and BuildingModels.hasVariant(record.Variant) then
			local model = spawnModel(player, record)
			if model then
				services.ConstructionService.track(player, record, model)
			end
		else
			warn("[BuildingService] Skipping unknown saved building " .. tostring(record.Type))
		end
	end
end

function BuildingService.clearPlayer(player: Player)
	local r = runtime[player]
	if r then
		for _, model in pairs(r.models) do
			model:Destroy()
		end
	end
	runtime[player] = nil
end

local function validNumber(v): boolean
	return type(v) == "number" and v == v and v > -1e6 and v < 1e6
end

local function handlePlace(player, request)
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < PlacementConfig.RequestCooldown then
		return { ok = false, error = "Too fast" }
	end
	lastRequest[player] = now

	local country = services.DataService.getCountry(player)
	local bounds = services.WorldService.getBounds(player)
	if not country or not bounds then
		return { ok = false, error = "Choose a plot first" }
	end
	if type(request) ~= "table" or not validNumber(request.X) or not validNumber(request.Z) then
		return { ok = false, error = "Invalid request" }
	end
	local def = type(request.Type) == "string" and defsById[request.Type] or nil
	if not def or def.Active ~= true then
		return { ok = false, error = "Unknown building" }
	end
	local variant = request.Variant
	if type(variant) ~= "string" or not table.find(def.Variants, variant) then
		variant = def.Variants[1]
	end
	local rotation = GridMath.normalizeRotation(validNumber(request.Rotation) and request.Rotation or 0)

	local ctx = {
		plot = bounds,
		buildingRects = BuildingService.getBuildingRects(player),
		roadCells = services.RoadService.getRoadCells(player),
	}
	local ok, reason, info = PlacementRules.validateBuilding(def, request.X, request.Z, rotation, ctx)
	if not ok then
		return { ok = false, error = reason }
	end
	local affordable, costError = services.ResourceService.canAfford(country, def.Cost)
	if not affordable then
		return { ok = false, error = costError }
	end
	services.ResourceService.charge(country, def.Cost)

	local id = "B" .. tostring(country.NextBuildingId)
	country.NextBuildingId += 1
	local record = {
		Id = id,
		Type = def.Id,
		Variant = variant,
		X = info.centerX - bounds.minX,
		Z = info.centerZ - bounds.minZ,
		Rotation = rotation,
		State = Constants.BuildState.Planned,
		PlannedElapsed = 0,
		Progress = 0,
		CreatedAt = os.time(),
		WaterRequired = def.Water and def.Water.Required or 0,
		WaterSupplied = 0,
		WaterStatus = "GREY",
		PowerRequired = def.Power and def.Power.Required or 0,
		PowerSupplied = 0,
		PowerStatus = "GREY",
	}
	country.Buildings[id] = record
	local model = spawnModel(player, record)
	if model then
		services.ConstructionService.track(player, record, model)
	end
	BuildingService.onBuildingsChanged(player)
	return { ok = true, buildingId = id }
end

-- Demolish one building owned by the player. Returns ok, error.
function BuildingService.demolish(player: Player, id: any): (boolean, string?)
	local country = services.DataService.getCountry(player)
	if not country or type(id) ~= "string" then
		return false, "Nothing to demolish"
	end
	local record = country.Buildings[id]
	if not record then
		return false, "Not your building"
	end
	country.Buildings[id] = nil
	services.ConstructionService.untrack(player, id)
	local r = runtime[player]
	if r then
		local model = r.models[id]
		if model then
			model:Destroy()
		end
		r.models[id] = nil
		r.rects[id] = nil
	end
	BuildingService.onBuildingsChanged(player)
	return true, nil
end

local function handleDemolish(player, request)
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < PlacementConfig.RequestCooldown then
		return { ok = false, error = "Too fast" }
	end
	lastRequest[player] = now
	if type(request) ~= "table" or type(request.Id) ~= "string" then
		return { ok = false, error = "Invalid request" }
	end
	if not services.WorldService.getPlotIndex(player) then
		return { ok = false, error = "Choose a plot first" }
	end
	local ok, err
	if request.Kind == "Road" then
		ok, err = services.RoadService.demolish(player, request.Id)
	elseif request.Kind == "Building" then
		ok, err = BuildingService.demolish(player, request.Id)
	else
		return { ok = false, error = "Invalid request" }
	end
	return { ok = ok, error = err }
end

function BuildingService.init(allServices)
	services = allServices
	remotes = allServices.Remotes
end

function BuildingService.start()
	remotes[Constants.Remotes.PlaceBuilding].OnServerInvoke = handlePlace
	remotes[Constants.Remotes.Demolish].OnServerInvoke = handleDemolish
	Players.PlayerRemoving:Connect(function(player)
		BuildingService.clearPlayer(player)
		lastRequest[player] = nil
	end)
end

return BuildingService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Construction</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">ConstructionService</string>
            <string name="Source"><![CDATA[-- ConstructionService: PLANNED -> UNDER_CONSTRUCTION -> COMPLETED over time (server authority).
-- Visuals: planned = faint ghost; under construction = parts become solid from the ground up.
-- The progress bar itself is drawn on the CLIENT (Controllers/ConstructionBars) from model
-- attributes (State, BuildTime, CompleteAt = server time), so it animates smoothly without
-- server ticks. Construction advances only while the owner is in the session (progress is saved).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))

local ConstructionService = {}
ConstructionService.Name = "ConstructionService"

local services
local tracked = {} -- [Player] = { [Id] = { record, model, parts } }

local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end

local GHOST = GameConfig.Construction.GhostTransparency

local function collectParts(model)
	local parts = {}
	local pivotY = model:GetPivot().Position.Y
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			local base = d:GetAttribute("BaseTransparency") or 0
			local bottom = d.Position.Y - d.Size.Y / 2 - pivotY
			table.insert(parts, { part = d, base = base, bottom = bottom })
		end
	end
	return parts
end

local function setTiming(entry)
	local record = entry.record
	local model = entry.model
	local def = defsById[record.Type]
	local now = Workspace:GetServerTimeNow()
	model:SetAttribute("State", record.State)
	model:SetAttribute("BuildTime", def.BuildTimeSeconds)
	if record.State == Constants.BuildState.Planned then
		local plannedLeft = math.max(0, GameConfig.Construction.PlannedSeconds - record.PlannedElapsed)
		model:SetAttribute("CompleteAt", now + plannedLeft + def.BuildTimeSeconds)
	elseif record.State == Constants.BuildState.UnderConstruction then
		model:SetAttribute("CompleteAt", now + math.max(0, def.BuildTimeSeconds - record.Progress))
	else
		model:SetAttribute("CompleteAt", now)
	end
end

local function applyVisual(entry)
	local record = entry.record
	local model = entry.model
	local def = defsById[record.Type]
	if record.State == Constants.BuildState.Completed then
		for _, info in ipairs(entry.parts) do
			info.part.Transparency = info.base
		end
		model:SetAttribute("Progress", 1)
		return
	end
	local fraction = 0
	if record.State == Constants.BuildState.UnderConstruction then
		fraction = math.clamp(record.Progress / def.BuildTimeSeconds, 0, 1)
	end
	model:SetAttribute("Progress", fraction)
	local height = model:GetAttribute("VisualHeight") or 2
	local revealHeight = fraction * height
	for _, info in ipairs(entry.parts) do
		local target
		if record.State == Constants.BuildState.UnderConstruction and info.bottom <= revealHeight then
			target = info.base
		else
			target = math.max(info.base, GHOST)
		end
		if info.part.Transparency ~= target then
			info.part.Transparency = target
		end
	end
end

function ConstructionService.track(player: Player, record, model)
	tracked[player] = tracked[player] or {}
	local entry = { record = record, model = model, parts = collectParts(model) }
	setTiming(entry)
	applyVisual(entry)
	if record.State ~= Constants.BuildState.Completed then
		tracked[player][record.Id] = entry
	end
end

function ConstructionService.untrack(player: Player, id: string)
	local entries = tracked[player]
	if entries then
		entries[id] = nil
	end
end

function ConstructionService.clearPlayer(player: Player)
	tracked[player] = nil
end

local function step(dt: number)
	for player, entries in pairs(tracked) do
		local completedAny = false
		local anyActive = false
		local transitioned = false
		for id, entry in pairs(entries) do
			local record = entry.record
			local def = defsById[record.Type]
			if record.State == Constants.BuildState.Planned then
				anyActive = true
				record.PlannedElapsed += dt
				if record.PlannedElapsed >= GameConfig.Construction.PlannedSeconds then
					record.State = Constants.BuildState.UnderConstruction
					transitioned = true
					setTiming(entry)
				end
				applyVisual(entry)
			elseif record.State == Constants.BuildState.UnderConstruction then
				anyActive = true
				record.Progress = math.min(record.Progress + dt, def.BuildTimeSeconds)
				if record.Progress >= def.BuildTimeSeconds then
					record.State = Constants.BuildState.Completed
					completedAny = true
					setTiming(entry)
					services.CountryService.notify(player, def.DisplayName .. " completed", "success")
				end
				applyVisual(entry)
			end
			if record.State == Constants.BuildState.Completed then
				entries[id] = nil
			end
		end
		if anyActive then
			services.DataService.markDirty(player)
		end
		if completedAny then
			services.BuildingService.onBuildingsChanged(player)
		elseif transitioned then
			services.CountryService.push(player)
		end
	end
end

function ConstructionService.init(allServices)
	services = allServices
end

function ConstructionService.start()
	task.spawn(function()
		local interval = GameConfig.Construction.TickSeconds
		local last = os.clock()
		while true do
			task.wait(interval)
			local now = os.clock()
			local dt = now - last
			last = now
			local ok, err = pcall(step, dt)
			if not ok then
				warn("[ConstructionService] " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		tracked[player] = nil
	end)
end

return ConstructionService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Country</string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">CountryService</string>
            <string name="Source"><![CDATA[-- CountryService: slot selection, country creation (server-validated), plot claiming and
-- state replication. Flow: MAIN MENU -> CREATE COUNTRY -> COUNTRY SETUP -> PLOT SELECTION -> GAME.
-- Creating or loading a country NEVER assigns a plot: the player must claim a free one.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local TechnologyConfig = require(Config:WaitForChild("TechnologyConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local Countries = require(Shared:WaitForChild("Modules"):WaitForChild("Countries"))
local DefaultCountry = require(Shared:WaitForChild("Modules"):WaitForChild("DefaultCountry"))

local CountryService = {}
CountryService.Name = "CountryService"

local services
local remotes
local pushQueued = {}
local busy = {}

local techById = {}
for _, branch in ipairs(TechnologyConfig.Branches) do
	techById[branch.Id] = branch
end

local function cleanName(raw)
	if type(raw) ~= "string" then
		return nil, "Enter a country name"
	end
	local name = string.gsub(raw, "%s+", " ")
	name = string.match(name, "^%s*(.-)%s*$") or ""
	local length = utf8.len(name) or #name
	if length < GameConfig.CountryName.MinLength then
		return nil, "Name is too short"
	end
	if length > GameConfig.CountryName.MaxLength then
		return nil, "Name is too long"
	end
	if not string.match(name, "^[%w %-'%.]+$") then
		return nil, "Use letters, numbers, spaces, - ' ."
	end
	return name, nil
end

local function filterName(player, name)
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		if result ~= name then
			return nil, "That name is not allowed"
		end
		return name, nil
	end
	if RunService:IsStudio() then
		-- Text filtering is not always available in Studio; allow the already-sanitized name.
		return name, nil
	end
	return nil, "Name check failed. Try again."
end

local function snapshot(player)
	local session = services.DataService.getSession(player)
	local country = session and session.country
	if not country then
		return { Active = false, Persistent = session and session.persistent or false }
	end
	local plotIndex = services.WorldService.getPlotIndex(player)
	local built = services.StatsService.build(country)
	return {
		Active = true,
		NeedsPlot = plotIndex == nil,
		Persistent = session.persistent,
		SlotIndex = session.activeSlot,
		Name = country.Name,
		FlagId = country.FlagId,
		Continent = country.Continent,
		TechnologyBranch = country.TechnologyBranch,
		Treasury = country.Treasury or 0,
		Oil = country.Oil,
		Fuel = country.Fuel,
		Steel = country.Steel,
		Supplies = country.Supplies,
		Population = country.Population,
		Workers = country.Workers,
		HousingCapacity = country.HousingCapacity,
		BuildingCount = built.Stats.Buildings,
		UnderConstruction = built.Stats.UnderConstruction,
		RoadCount = built.Stats.Roads,
		PlotIndex = plotIndex,
		LastPlotIndex = country.LastPlotIndex,
		Stats = built.Stats,
		Water = built.Water,
		Power = built.Power,
		WaterList = built.WaterList,
		PowerList = built.PowerList,
		ExtraRoads = built.ExtraRoads,
	}
end
CountryService.snapshot = snapshot

-- Replicate the authoritative state (throttled to one push per frame).
function CountryService.push(player: Player)
	if pushQueued[player] then
		return
	end
	pushQueued[player] = true
	task.defer(function()
		pushQueued[player] = nil
		if player.Parent then
			remotes[Constants.Remotes.StateChanged]:FireClient(player, snapshot(player))
		end
	end)
end

function CountryService.notify(player: Player, message: string, kind: string?)
	remotes[Constants.Remotes.Notify]:FireClient(player, { Text = message, Kind = kind or "info" })
end

local function guard(player, fn)
	if busy[player] then
		return { ok = false, error = "Please wait" }
	end
	busy[player] = true
	local ok, result = pcall(fn)
	busy[player] = nil
	if not ok then
		warn("[CountryService] " .. tostring(result))
		return { ok = false, error = "Server error" }
	end
	return result
end

-- Activates the country in the session. The player then picks a plot (ClaimPlot).
local function activateCountry(player, index, country)
	services.DataService.setActive(player, index, country)
	services.PopulationService.recalculate(country)
	services.DataService.saveActive(player)
	CountryService.push(player)
	return { ok = true, needsPlot = true, state = snapshot(player), plots = services.WorldService.listPlots() }
end

local function handleGetProfile(player)
	local session = services.DataService.loadSession(player)
	return {
		ok = true,
		slots = services.DataService.getSlotSummaries(player),
		persistent = session.persistent,
		activeSlot = session.activeSlot,
	}
end

local function validSlotIndex(index)
	return type(index) == "number" and index == math.floor(index) and index >= 1 and index <= GameConfig.SlotCount
end

local function handleCreate(player, index, payload)
	return guard(player, function()
		if not validSlotIndex(index) then
			return { ok = false, error = "Invalid slot" }
		end
		if not services.DataService.isSlotUnlocked(index) then
			return { ok = false, error = "This slot is locked" }
		end
		local session = services.DataService.loadSession(player)
		if session.activeSlot then
			return { ok = false, error = "Leave your current state first" }
		end
		if session.profile.Summaries["Slot" .. index] ~= nil then
			return { ok = false, error = "Slot already has a state" }
		end
		if type(payload) ~= "table" then
			return { ok = false, error = "Invalid request" }
		end
		local name, nameError = cleanName(payload.Name)
		if not name then
			return { ok = false, error = nameError }
		end
		name, nameError = filterName(player, name)
		if not name then
			return { ok = false, error = nameError }
		end
		local flag = type(payload.FlagId) == "string" and Countries.get(payload.FlagId) or nil
		if not flag then
			return { ok = false, error = "Select a flag" }
		end
		if payload.Continent ~= flag.Continent then
			return { ok = false, error = "Flag does not match continent" }
		end
		local branch = type(payload.TechnologyBranch) == "string" and techById[payload.TechnologyBranch] or nil
		if not branch or branch.Active ~= true then
			return { ok = false, error = "Select a technology branch" }
		end
		local country = DefaultCountry.new(index, name, flag.Id, flag.Continent, branch.Id)
		return activateCountry(player, index, country)
	end)
end

local function handleLoad(player, index)
	return guard(player, function()
		if not validSlotIndex(index) or not services.DataService.isSlotUnlocked(index) then
			return { ok = false, error = "Invalid slot" }
		end
		local session = services.DataService.loadSession(player)
		if session.activeSlot then
			return { ok = false, error = "Leave your current state first" }
		end
		local country, err = services.DataService.loadSlot(player, index)
		if not country then
			return { ok = false, error = err }
		end
		return activateCountry(player, index, country)
	end)
end

local function handleClaimPlot(player, plotIndex)
	return guard(player, function()
		local session = services.DataService.getSession(player)
		local country = session and session.country
		if not country then
			return { ok = false, error = "Create or load a country first" }
		end
		if services.WorldService.getPlotIndex(player) then
			return { ok = false, error = "You already own a plot" }
		end
		local ok, err = services.WorldService.claim(player, plotIndex, country)
		if not ok then
			return { ok = false, error = err, plots = services.WorldService.listPlots() }
		end
		country.LastPlotIndex = plotIndex
		services.RoadService.loadCountry(player, country)
		services.BuildingService.loadCountry(player, country)
		services.PopulationService.recalculate(country)
		services.WaterService.recompute(player)
		services.PowerService.recompute(player)
		services.WorldService.teleportToPlot(player)
		session.dirty = true
		services.DataService.saveActive(player)
		CountryService.push(player)
		return { ok = true, state = snapshot(player) }
	end)
end

local function handleLeave(player)
	return guard(player, function()
		local session = services.DataService.getSession(player)
		if not session or not session.activeSlot then
			return { ok = true }
		end
		session.dirty = true
		services.DataService.saveActive(player)
		services.ConstructionService.clearPlayer(player)
		services.RoadService.clearPlayer(player)
		services.BuildingService.clearPlayer(player)
		services.WorldService.release(player)
		services.WorldService.teleportToLobby(player)
		services.DataService.clearActive(player)
		CountryService.push(player)
		return { ok = true }
	end)
end

local function handleDelete(player, index)
	return guard(player, function()
		if not validSlotIndex(index) then
			return { ok = false, error = "Invalid slot" }
		end
		local ok, err = services.DataService.deleteSlot(player, index)
		return { ok = ok, error = err }
	end)
end

local function handleSave(player)
	return guard(player, function()
		local session = services.DataService.getSession(player)
		if not session or not session.activeSlot then
			return { ok = false, error = "No active state" }
		end
		session.dirty = true
		local ok = services.DataService.saveActive(player)
		if not session.persistent then
			return { ok = ok, persistent = false }
		end
		return { ok = ok, persistent = true, error = (not ok) and "Save failed" or nil }
	end)
end

function CountryService.init(allServices)
	services = allServices
	remotes = allServices.Remotes
end

function CountryService.start()
	remotes[Constants.Remotes.GetProfile].OnServerInvoke = handleGetProfile
	remotes[Constants.Remotes.CreateCountry].OnServerInvoke = handleCreate
	remotes[Constants.Remotes.LoadSlot].OnServerInvoke = handleLoad
	remotes[Constants.Remotes.ClaimPlot].OnServerInvoke = handleClaimPlot
	remotes[Constants.Remotes.LeaveState].OnServerInvoke = handleLeave
	remotes[Constants.Remotes.DeleteSlot].OnServerInvoke = handleDelete
	remotes[Constants.Remotes.SaveNow].OnServerInvoke = handleSave

	Players.PlayerRemoving:Connect(function(player)
		pushQueued[player] = nil
		busy[player] = nil
	end)
end

return CountryService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: server-authoritative save/load with 3 independent slots.
-- Profile key : "profile_<userId>" -> slot summaries (for the slot screen)
-- Slot keys   : "slot_<userId>_<index>" -> full country data, one key per slot (independent)
-- Saved per slot: country info, resources, population, buildings (incl. water/power status),
-- roads (road graph), infrastructure (water storage, power, shortage stage), last plot.
-- Old saves are migrated by DefaultCountry.migrate (safe defaults, nothing granted).
-- If DataStores are unavailable (e.g. Studio without API access) the session runs in MEMORY mode
-- and never writes, so a failed load can never overwrite real data.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local DefaultCountry = require(Shared:WaitForChild("Modules"):WaitForChild("DefaultCountry"))

local DataService = {}
DataService.Name = "DataService"

local store = nil
local storeError = nil
local sessions = {} -- [Player] = session
local memoryStore = {} -- used only in memory mode, lost on server shutdown

local function profileKey(userId: number): string
	return "profile_" .. tostring(userId)
end

local function slotKey(userId: number, index: number): string
	return "slot_" .. tostring(userId) .. "_" .. tostring(index)
end

local function withRetries(label: string, fn)
	local lastError = nil
	for attempt = 1, GameConfig.DataStoreRetries do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataService] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		local message = tostring(result)
		if string.find(message, "StudioAccessToApisNotAllowed", 1, true) or string.find(message, "API access", 1, true) then
			break -- Studio without API access: retrying cannot succeed
		end
		task.wait(attempt)
	end
	return false, lastError
end

local function newProfile()
	return { SchemaVersion = GameConfig.SchemaVersion, Summaries = {} }
end

function DataService.init(_services)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[DataService] DataStore unavailable, using MEMORY mode: " .. storeError)
	end
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveSeconds)
			for player in pairs(sessions) do
				task.spawn(DataService.saveActive, player)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in pairs(sessions) do
			pending += 1
			task.spawn(function()
				DataService.saveActive(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Loads (or creates) the player's session. Returns session.
function DataService.loadSession(player: Player)
	if sessions[player] then
		return sessions[player]
	end
	local session = {
		player = player,
		persistent = store ~= nil,
		persistenceReason = storeError,
		profile = newProfile(),
		activeSlot = nil,
		country = nil,
		dirty = false,
	}
	if store then
		local ok, data = withRetries("Load profile", function()
			return store:GetAsync(profileKey(player.UserId))
		end)
		if ok then
			if type(data) == "table" then
				session.profile = data
				session.profile.Summaries = session.profile.Summaries or {}
			end
		else
			session.persistent = false
			session.persistenceReason = "Profile load failed: " .. tostring(data)
		end
	else
		session.profile = memoryStore[profileKey(player.UserId)] or newProfile()
	end
	sessions[player] = session
	return session
end

function DataService.getSession(player: Player)
	return sessions[player]
end

function DataService.isSlotUnlocked(index: number): boolean
	local slot = GameConfig.Slots[index]
	return slot ~= nil and slot.Unlocked == true
end

function DataService.getSlotSummaries(player: Player)
	local session = DataService.loadSession(player)
	local result = {}
	for index = 1, GameConfig.SlotCount do
		local summary = session.profile.Summaries["Slot" .. index]
		table.insert(result, {
			Index = index,
			Locked = not DataService.isSlotUnlocked(index),
			Empty = summary == nil,
			Name = summary and summary.Name or nil,
			FlagId = summary and summary.FlagId or nil,
			TechnologyBranch = summary and summary.TechnologyBranch or nil,
			Population = summary and summary.Population or nil,
			LastPlotIndex = summary and summary.LastPlotIndex or nil,
		})
	end
	return result
end

local function summarize(country)
	return {
		Name = country.Name,
		FlagId = country.FlagId,
		TechnologyBranch = country.TechnologyBranch,
		Population = country.Population,
		LastPlotIndex = country.LastPlotIndex,
		UpdatedAt = os.time(),
	}
end

local function writeProfile(session)
	local key = profileKey(session.player.UserId)
	if not session.persistent then
		memoryStore[key] = session.profile
		return true
	end
	return withRetries("Save profile", function()
		store:UpdateAsync(key, function()
			return session.profile
		end)
	end)
end

-- Loads the full country for a slot. Returns country or nil, error.
function DataService.loadSlot(player: Player, index: number)
	local session = DataService.loadSession(player)
	if session.profile.Summaries["Slot" .. index] == nil then
		return nil, "Slot is empty"
	end
	local key = slotKey(player.UserId, index)
	local data
	if session.persistent then
		local ok, result = withRetries("Load slot", function()
			return store:GetAsync(key)
		end)
		if not ok then
			return nil, "Could not load save data. Try again."
		end
		data = result
	else
		data = memoryStore[key] and DefaultCountry.deepCopy(memoryStore[key]) or nil
	end
	if type(data) ~= "table" then
		return nil, "Save data missing"
	end
	return DefaultCountry.migrate(data), nil
end

function DataService.setActive(player: Player, index: number, country)
	local session = DataService.loadSession(player)
	session.activeSlot = index
	session.country = country
	session.dirty = true
	session.profile.Summaries["Slot" .. index] = summarize(country)
end

function DataService.clearActive(player: Player)
	local session = sessions[player]
	if session then
		session.activeSlot = nil
		session.country = nil
		session.dirty = false
	end
end

function DataService.getCountry(player: Player)
	local session = sessions[player]
	return session and session.country or nil
end

function DataService.markDirty(player: Player)
	local session = sessions[player]
	if session then
		session.dirty = true
	end
end

-- Saves the active slot and the profile summary.
function DataService.saveActive(player: Player): boolean
	local session = sessions[player]
	if not session or not session.country or not session.activeSlot then
		return true
	end
	if not session.dirty then
		return true
	end
	local index = session.activeSlot
	local country = session.country
	session.profile.Summaries["Slot" .. index] = summarize(country)
	local key = slotKey(player.UserId, index)
	if not session.persistent then
		memoryStore[key] = DefaultCountry.deepCopy(country)
		memoryStore[profileKey(player.UserId)] = session.profile
		session.dirty = false
		return true
	end
	local ok = withRetries("Save slot", function()
		store:UpdateAsync(key, function()
			return country
		end)
	end)
	if ok then
		ok = writeProfile(session)
	end
	if ok then
		session.dirty = false
	end
	return ok
end

function DataService.deleteSlot(player: Player, index: number): (boolean, string?)
	local session = DataService.loadSession(player)
	if session.activeSlot == index then
		return false, "Leave the state before deleting it"
	end
	local key = slotKey(player.UserId, index)
	if session.persistent then
		local ok = withRetries("Delete slot", function()
			store:RemoveAsync(key)
		end)
		if not ok then
			return false, "Delete failed. Try again."
		end
	else
		memoryStore[key] = nil
	end
	session.profile.Summaries["Slot" .. index] = nil
	writeProfile(session)
	return true, nil
end

function DataService.releaseSession(player: Player)
	DataService.saveActive(player)
	sessions[player] = nil
end

Players.PlayerRemoving:Connect(function(player)
	-- WorldService/other systems clean up first via their own handlers; saving happens here.
	DataService.releaseSession(player)
end)

return DataService
]]></string>
          </Properties>
        </Item>
      </Item>
