        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">BuildMenu</string>
            <string name="Source"><![CDATA[-- BuildMenu: compact bottom-center menu. BUILD -> CATEGORY -> ITEM.
-- Categories: Roads, Residential, Business, Industry, Infrastructure, Military + planned ones.
-- Categories scroll horizontally (touch drag on mobile, mouse wheel on PC). Roads is always first.
-- Open/close: slide + scale; cards pop in with a short stagger.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local BuildMenuConfig = require(Config:WaitForChild("BuildMenuConfig"))
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local RoadConfig = require(Config:WaitForChild("RoadConfig"))
local BuildingModels = require(Shared:WaitForChild("Modules"):WaitForChild("BuildingModels"))
local RoadModels = require(Shared:WaitForChild("Modules"):WaitForChild("RoadModels"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local BuildMenu = {}
BuildMenu.__index = BuildMenu

local DESIGN_W, DESIGN_H = 580, 206
local CARD_W, CARD_H = 104, 128

local function metaFor(def)
	if (def.HousingCapacity or 0) > 0 then
		return string.format("+%d homes · %ds", def.HousingCapacity, def.BuildTimeSeconds)
	end
	if def.Water and (def.Water.Production or 0) > 0 then
		return string.format("Water %d · r%d", def.Water.Production, def.Water.Radius)
	end
	if def.Power and (def.Power.Production or 0) > 0 then
		return string.format("Power %d · r%d", def.Power.Production, def.Power.Radius)
	end
	return string.format("%ds build", def.BuildTimeSeconds)
end

local function itemsForCategory(categoryId: string)
	local items = {}
	if categoryId == "Roads" then
		for _, roadType in ipairs(RoadConfig.Types) do
			if roadType.Active then
				table.insert(items, {
					Kind = "Road",
					Id = roadType.Id,
					Name = roadType.DisplayName,
					Meta = "Hold + drag",
				})
			end
		end
	else
		for _, def in ipairs(BuildingConfig.Buildings) do
			if def.Category == categoryId and def.Active then
				table.insert(items, {
					Kind = "Building",
					Id = def.Id,
					Name = def.DisplayName,
					Meta = metaFor(def),
					Def = def,
				})
			end
		end
	end
	return items
end

local function viewport(parent, item)
	local frame = UIKit.new("ViewportFrame", {
		BackgroundColor3 = C.SurfaceAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 68),
		Ambient = Color3.fromRGB(205, 210, 220),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -2, -1),
		Parent = parent,
	})
	UIKit.corner(frame, 8)
	local model
	if item.Kind == "Road" then
		model = RoadModels.build(item.Id, "NS")
	else
		model = BuildingModels.build(item.Def, item.Def.Variants[1])
	end
	model.Parent = frame
	local cf, size = model:GetBoundingBox()
	local radius = math.max(size.Magnitude / 2, 0.5)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local direction = Vector3.new(1, 0.9, 1.2).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + direction * radius * 3.4, cf.Position)
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

function BuildMenu.new(root: ScreenGui, callbacks)
	local self = setmetatable({}, BuildMenu)
	self.callbacks = callbacks
	self.categoryButtons = {}
	self.currentCategory = BuildMenuConfig.Categories[1].Id

	self.panel = UIKit.panel({
		Name = "BuildMenu",
		Radius = T.Radius.Large,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		Visible = false,
		Parent = root,
	})
	UIKit.autoScale(self.panel, DESIGN_W, DESIGN_H + 40)
	UIKit.padding(self.panel, 10)

	local badge = UIKit.new("Frame", {
		BackgroundColor3 = C.AccentSoft,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(76, 28),
		Parent = self.panel,
	})
	UIKit.corner(badge, 999)
	local icon = UIKit.hammerIcon(badge, 14, C.AccentDark)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position = UDim2.new(0, 9, 0.5, 0)
	UIKit.label({
		Text = "BUILD",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.AccentDark,
		Position = UDim2.fromOffset(28, 0),
		Size = UDim2.new(1, -30, 1, 0),
		Parent = badge,
	})
	UIKit.button({
		Text = "Close",
		TextSize = T.TextSize.Small,
		Style = "ghost",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(60, 28),
		Radius = 999,
		Parent = self.panel,
		OnClick = function()
			self:hide()
			self.callbacks.onClose()
		end,
	})

	self.categories = UIKit.hScroll({
		Name = "Categories",
		Position = UDim2.fromOffset(84, 0),
		Size = UDim2.new(1, -84 - 68, 0, 30),
		Spacing = 6,
		Parent = self.panel,
	})
	for i, category in ipairs(BuildMenuConfig.Categories) do
		local b = UIKit.button({
			Text = category.DisplayName,
			TextSize = T.TextSize.Tiny,
			Size = UDim2.fromOffset(category.Status == "PLANNED" and 84 or 100, 26),
			Radius = 999,
			LayoutOrder = i,
			Parent = self.categories,
			OnClick = function()
				self:selectCategory(category.Id)
			end,
		})
		if category.Status == "PLANNED" then
			b.Instance.TextColor3 = C.TextMuted
		end
		self.categoryButtons[category.Id] = b
	end

	self.items = UIKit.hScroll({
		Name = "Items",
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 1, -40),
		Spacing = 8,
		Parent = self.panel,
	})
	return self
end

function BuildMenu:selectCategory(categoryId: string)
	self.currentCategory = categoryId
	for id, b in pairs(self.categoryButtons) do
		b.setSelected(id == categoryId)
	end
	for _, child in ipairs(self.items:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.items.CanvasPosition = Vector2.new(0, 0)
	local items = itemsForCategory(categoryId)
	if #items == 0 then
		UIKit.label({
			Text = "Planned for a future update",
			TextColor3 = C.TextMuted,
			TextSize = T.TextSize.Small,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(DESIGN_W - 20, 120),
			Parent = self.items,
		})
		return
	end
	for i, item in ipairs(items) do
		local card = UIKit.button({
			Name = item.Id,
			Text = "",
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			LayoutOrder = i,
			Radius = T.Radius.Medium,
			Parent = self.items,
			OnClick = function()
				self:hide()
				self.callbacks.onSelect(item.Kind, item.Id)
			end,
		})
		UIKit.padding(card.Instance, 6)
		local vp = viewport(card.Instance, item)
		vp.Active = false
		UIKit.label({
			Text = item.Name,
			Font = T.Fonts.Bold,
			TextSize = T.TextSize.Small,
			Position = UDim2.fromOffset(0, 74),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = card.Instance,
		})
		UIKit.label({
			Text = item.Meta,
			TextColor3 = C.TextMuted,
			TextSize = T.TextSize.Tiny,
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Parent = card.Instance,
		})
		-- Staggered pop-in
		local scale = card.Instance:FindFirstChild("PressScale")
		if scale then
			scale.Scale = 0.86
			task.delay(0.03 * i, function()
				if card.Instance.Parent then
					UIKit.tween(scale, T.Motion.Normal, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end)
		end
	end
end

function BuildMenu:show(categoryId: string?)
	self:selectCategory(categoryId or self.currentCategory)
	UIKit.open(self.panel, 24)
end

function BuildMenu:hide()
	UIKit.close(self.panel, 24)
end

function BuildMenu:isOpen(): boolean
	return self.panel.Visible
end

return BuildMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">CreateStateScreen</string>
            <string name="Source"><![CDATA[-- CreateStateScreen: CREATE COUNTRY -> COUNTRY SETUP wizard:
-- Country Name -> Flag (Continent -> Country, any of the 195 flags) -> Technology Branch -> Review.
-- Name, Flag and Technology are independent (e.g. "Novaria" + Germany flag + USSR / Russia tech).
-- The client only collects choices; the server validates and creates the country, then the
-- player continues to PLOT SELECTION (no plot is assigned automatically).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Countries = require(Shared:WaitForChild("Modules"):WaitForChild("Countries"))
local TechnologyConfig = require(Shared:WaitForChild("Config"):WaitForChild("TechnologyConfig"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local CreateStateScreen = {}
CreateStateScreen.__index = CreateStateScreen

local DESIGN_W, DESIGN_H = 440, 480
local STEPS = { "Name", "Flag", "Technology", "Review" }

function CreateStateScreen.new(root: ScreenGui, callbacks)
	local self = setmetatable({}, CreateStateScreen)
	self.callbacks = callbacks
	self.choice = { Name = "", FlagId = nil, Continent = nil, TechnologyBranch = nil }
	self.step = 1
	self.browseContinent = nil
	self.search = ""

	self.panel = UIKit.panel({
		Name = "CreateStateScreen",
		Canvas = true,
		Radius = T.Radius.Large,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		Visible = false,
		Parent = root,
	})
	UIKit.autoScale(self.panel, DESIGN_W, DESIGN_H)
	UIKit.padding(self.panel, 20)

	self.title = UIKit.label({
		Text = "Create Country",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Header,
		Size = UDim2.new(1, -90, 0, 26),
		Parent = self.panel,
	})
	self.stepLabel = UIKit.label({
		Text = "",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = self.panel,
	})
	-- Progress track (4 segments)
	self.track = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 10),
		Size = UDim2.fromOffset(4 * 20 + 3 * 4, 6),
		Parent = self.panel,
	})
	UIKit.list(self.track, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right)
	self.dotFrames = {}
	for i = 1, #STEPS do
		local dot = UIKit.new("Frame", {
			BackgroundColor3 = C.Gray,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(20, 6),
			LayoutOrder = i,
			Parent = self.track,
		})
		UIKit.corner(dot, 999)
		self.dotFrames[i] = dot
	end

	self.content = UIKit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56 - 50),
		ClipsDescendants = true,
		Parent = self.panel,
	})

	self.error = UIKit.label({
		Text = "",
		TextColor3 = C.Danger,
		TextSize = T.TextSize.Small,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -44),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = self.panel,
	})

	self.backButton = UIKit.button({
		Text = "Back",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(96, 36),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Radius = 999,
		Parent = self.panel,
		OnClick = function()
			self:back()
		end,
	})
	self.nextButton = UIKit.button({
		Text = "Next",
		Style = "primary",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(150, 36),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Radius = 999,
		Parent = self.panel,
		OnClick = function()
			self:next()
		end,
	})
	return self
end

function CreateStateScreen:setError(text: string?)
	self.error.Text = text or ""
end

function CreateStateScreen:clearContent()
	for _, child in ipairs(self.content:GetChildren()) do
		child:Destroy()
	end
end

function CreateStateScreen:canContinue(): (boolean, string?)
	if self.step == 1 then
		local name = string.match(self.choice.Name or "", "^%s*(.-)%s*$") or ""
		if #name < GameConfig.CountryName.MinLength then
			return false, "Name must be at least " .. GameConfig.CountryName.MinLength .. " characters"
		end
		if #name > GameConfig.CountryName.MaxLength then
			return false, "Name is too long"
		end
		return true, nil
	elseif self.step == 2 then
		if not self.choice.FlagId then
			return false, "Select a continent, then a country"
		end
		return true, nil
	elseif self.step == 3 then
		if not self.choice.TechnologyBranch then
			return false, "Select a technology branch"
		end
		return true, nil
	end
	return true, nil
end

function CreateStateScreen:renderName()
	UIKit.label({
		Text = "Country name",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = self.content,
	})
	local box = UIKit.new("TextBox", {
		Name = "NameInput",
		BackgroundColor3 = C.Surface,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 42),
		Font = T.Fonts.Medium,
		TextSize = T.TextSize.Body,
		TextColor3 = C.Text,
		PlaceholderText = "e.g. Novaria",
		PlaceholderColor3 = C.TextMuted,
		Text = self.choice.Name,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.content,
	})
	UIKit.corner(box, T.Radius.Small)
	local stroke = UIKit.stroke(box, C.Stroke)
	UIKit.padding(box, 0, 12)
	box.Focused:Connect(function()
		UIKit.tween(stroke, T.Motion.Fast, { Color = C.Accent, Thickness = 1.5 })
	end)
	box.FocusLost:Connect(function()
		UIKit.tween(stroke, T.Motion.Fast, { Color = C.Stroke, Thickness = 1 })
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > GameConfig.CountryName.MaxLength then
			box.Text = string.sub(box.Text, 1, GameConfig.CountryName.MaxLength)
		end
		self.choice.Name = box.Text
		self:setError(nil)
	end)
	UIKit.label({
		Text = string.format(
			"%d-%d characters. Name, flag and technology are independent choices.",
			GameConfig.CountryName.MinLength,
			GameConfig.CountryName.MaxLength
		),
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Position = UDim2.fromOffset(0, 76),
		Size = UDim2.new(1, 0, 0, 32),
		Parent = self.content,
	})
end

function CreateStateScreen:renderContinents()
	UIKit.label({
		Text = "Select continent",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = self.content,
	})
	local grid = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 1, -26),
		Parent = self.content,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -4, 0, 54)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, continent in ipairs(Countries.Continents) do
		local count = #Countries.forContinent(continent)
		local b = UIKit.button({
			Text = string.upper(continent) .. "\n" .. count .. " countries",
			TextSize = T.TextSize.Small,
			LayoutOrder = i,
			Radius = T.Radius.Medium,
			Parent = grid,
			OnClick = function()
				self.browseContinent = continent
				self.search = ""
				self:render()
			end,
		})
		if self.choice.Continent == continent then
			b.setSelected(true)
		end
	end
end

function CreateStateScreen:renderCountries()
	local continent = self.browseContinent
	UIKit.button({
		Text = "< Continents",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(110, 28),
		Style = "ghost",
		Radius = 999,
		Parent = self.content,
		OnClick = function()
			self.browseContinent = nil
			self:render()
		end,
	})
	UIKit.label({
		Text = string.upper(continent),
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		TextColor3 = C.AccentDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, 0, 0, 28),
		Parent = self.content,
	})
	local search = UIKit.new("TextBox", {
		Name = "Search",
		BackgroundColor3 = C.Surface,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 30),
		Font = T.Fonts.Regular,
		TextSize = T.TextSize.Small,
		TextColor3 = C.Text,
		PlaceholderText = "Search in " .. continent .. " (optional)",
		PlaceholderColor3 = C.TextMuted,
		Text = self.search,
		ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.content,
	})
	UIKit.corner(search, 999)
	UIKit.stroke(search, C.Stroke)
	UIKit.padding(search, 0, 12)

	local list = UIKit.vScroll({
		Name = "CountryList",
		Position = UDim2.fromOffset(0, 74),
		Size = UDim2.new(1, 0, 1, -74),
		Parent = self.content,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -6, 0, 36)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	UIKit.padding(list, 2, 2)

	local buttons = {}
	local function populate()
		for _, b in ipairs(buttons) do
			b.Instance:Destroy()
		end
		buttons = {}
		for i, entry in ipairs(Countries.search(self.search, continent)) do
			local b
			b = UIKit.button({
				Text = "",
				LayoutOrder = i,
				Parent = list,
				OnClick = function()
					self.choice.FlagId = entry.Id
					self.choice.Continent = entry.Continent
					self:setError(nil)
					for _, other in ipairs(buttons) do
						other.setSelected(other == b)
					end
				end,
			})
			local flag = UIKit.flag(b.Instance, entry, 18)
			flag.AnchorPoint = Vector2.new(0, 0.5)
			flag.Position = UDim2.new(0, 8, 0.5, 0)
			UIKit.label({
				Text = entry.DisplayNameEN,
				TextSize = T.TextSize.Small,
				Position = UDim2.fromOffset(40, 0),
				Size = UDim2.new(1, -46, 1, 0),
				Parent = b.Instance,
			})
			if self.choice.FlagId == entry.Id then
				b.setSelected(true)
			end
			table.insert(buttons, b)
		end
	end
	populate()
	search:GetPropertyChangedSignal("Text"):Connect(function()
		self.search = search.Text
		populate()
	end)
end

function CreateStateScreen:renderTechnology()
	UIKit.label({
		Text = "Technology branch",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = self.content,
	})
	local holder = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 1, -26),
		Parent = self.content,
	})
	UIKit.list(holder, Enum.FillDirection.Vertical, 8)
	local buttons = {}
	for i, branch in ipairs(TechnologyConfig.Branches) do
		local b
		b = UIKit.button({
			Text = "",
			Size = UDim2.new(1, 0, 0, 60),
			LayoutOrder = i,
			Radius = T.Radius.Medium,
			Parent = holder,
			OnClick = function()
				self.choice.TechnologyBranch = branch.Id
				self:setError(nil)
				for _, other in ipairs(buttons) do
					other.setSelected(other == b)
				end
			end,
		})
		UIKit.label({
			Text = branch.DisplayName,
			Font = T.Fonts.Bold,
			Position = UDim2.fromOffset(14, 9),
			Size = UDim2.new(1, -28, 0, 20),
			Parent = b.Instance,
		})
		UIKit.label({
			Text = branch.Description,
			TextColor3 = C.TextMuted,
			TextSize = T.TextSize.Small,
			Position = UDim2.fromOffset(14, 31),
			Size = UDim2.new(1, -28, 0, 18),
			Parent = b.Instance,
		})
		if self.choice.TechnologyBranch == branch.Id then
			b.setSelected(true)
		end
		table.insert(buttons, b)
	end
end

function CreateStateScreen:renderReview()
	local entry = Countries.get(self.choice.FlagId or "")
	local techName = self.choice.TechnologyBranch
	for _, branch in ipairs(TechnologyConfig.Branches) do
		if branch.Id == self.choice.TechnologyBranch then
			techName = branch.DisplayName
		end
	end
	local card = UIKit.new("Frame", {
		BackgroundColor3 = C.Surface,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 160),
		Parent = self.content,
	})
	UIKit.corner(card, T.Radius.Medium)
	UIKit.stroke(card, C.Stroke)
	UIKit.padding(card, 14)
	local flag = UIKit.flag(card, entry, 34)
	flag.Position = UDim2.fromOffset(0, 0)
	UIKit.label({
		Text = self.choice.Name,
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Title,
		Position = UDim2.fromOffset(60, 0),
		Size = UDim2.new(1, -60, 0, 22),
		Parent = card,
	})
	UIKit.label({
		Text = "Flag: " .. (entry and entry.DisplayNameEN or "-") .. " · " .. (self.choice.Continent or ""),
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		Position = UDim2.fromOffset(60, 24),
		Size = UDim2.new(1, -60, 0, 16),
		Parent = card,
	})
	UIKit.label({
		Text = "Technology: " .. tostring(techName),
		TextColor3 = C.Text,
		TextSize = T.TextSize.Small,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = card,
	})
	UIKit.label({
		Text = "Your state starts empty: no treasury, citizens, houses or roads. Next you will choose a free plot.",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = card,
	})
end

function CreateStateScreen:render()
	self:clearContent()
	self.stepLabel.Text = string.format("Country setup · Step %d of %d · %s", self.step, #STEPS, STEPS[self.step])
	for i, dot in ipairs(self.dotFrames) do
		UIKit.tween(dot, T.Motion.Normal, { BackgroundColor3 = (i <= self.step) and C.Accent or C.Gray })
	end
	self.backButton.setText(self.step == 1 and "Cancel" or "Back")
	self.nextButton.setText(self.step == #STEPS and "Choose plot" or "Next")
	if self.step == 1 then
		self:renderName()
	elseif self.step == 2 then
		if self.browseContinent then
			self:renderCountries()
		else
			self:renderContinents()
		end
	elseif self.step == 3 then
		self:renderTechnology()
	else
		self:renderReview()
	end
	-- Gentle slide-in of the step content.
	self.content.Position = UDim2.fromOffset(12, 56)
	UIKit.tween(self.content, T.Motion.Normal, { Position = UDim2.fromOffset(0, 56) })
end

function CreateStateScreen:next()
	if self.submitting then
		return
	end
	local ok, reason = self:canContinue()
	if not ok then
		self:setError(reason)
		return
	end
	self:setError(nil)
	if self.step < #STEPS then
		self.step += 1
		if self.step == 2 then
			self.browseContinent = self.choice.Continent
		end
		self:render()
		return
	end
	self.submitting = true
	self.nextButton.setText("Creating...")
	local payload = {
		Name = string.match(self.choice.Name, "^%s*(.-)%s*$"),
		FlagId = self.choice.FlagId,
		Continent = self.choice.Continent,
		TechnologyBranch = self.choice.TechnologyBranch,
	}
	task.spawn(function()
		local result = self.callbacks.onSubmit(self.slotIndex, payload)
		self.submitting = false
		if result and result.ok then
			self:hide()
		else
			self.nextButton.setText("Choose plot")
			self:setError(result and result.error or "Could not create country")
		end
	end)
end

function CreateStateScreen:back()
	if self.submitting then
		return
	end
	self:setError(nil)
	if self.step == 2 and self.browseContinent then
		self.browseContinent = nil
		self:render()
		return
	end
	if self.step == 1 then
		self:hide()
		self.callbacks.onCancel()
		return
	end
	self.step -= 1
	self:render()
end

function CreateStateScreen:show(slotIndex: number)
	self.slotIndex = slotIndex
	self.choice = { Name = "", FlagId = nil, Continent = nil, TechnologyBranch = nil }
	self.step = 1
	self.browseContinent = nil
	self.search = ""
	self.submitting = false
	self:setError(nil)
	self.title.Text = "Create Country"
	self:render()
	UIKit.open(self.panel, 16)
end

function CreateStateScreen:hide()
	UIKit.close(self.panel, 16)
end

return CreateStateScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- HUD: TOP CENTER menu + country + population pill; BOTTOM CENTER compact BUILD button
-- (hammer icon, hover + press animation); RIGHT side STATS button.
-- Respects the Roblox Core UI safe inset (ScreenGui.ScreenInsets).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Countries = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("Countries"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local HUD = {}
HUD.__index = HUD

-- Pill button with an icon + caption, hover lift and press squish.
local function iconButton(props)
	local button = UIKit.new("TextButton", {
		Name = props.Name,
		AutoButtonColor = false,
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		AnchorPoint = props.AnchorPoint,
		Position = props.Position,
		Size = props.Size,
		Text = "",
		Visible = false,
		Parent = props.Parent,
	})
	UIKit.corner(button, 999)
	local stroke = UIKit.stroke(button, C.Stroke, 1.5)
	UIKit.gradient(button, C.Background, C.AccentSoft, 90)
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = button
	local icon = props.Icon(button)
	local caption = UIKit.label({
		Name = "Caption",
		Text = props.Text,
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		TextColor3 = C.AccentDark,
		Parent = button,
	})
	if props.Vertical then
		icon.AnchorPoint = Vector2.new(0.5, 0)
		icon.Position = UDim2.new(0.5, 0, 0, 9)
		caption.TextXAlignment = Enum.TextXAlignment.Center
		caption.TextSize = T.TextSize.Tiny
		caption.Position = UDim2.new(0, 0, 1, -22)
		caption.Size = UDim2.new(1, 0, 0, 14)
	else
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 14, 0.5, 0)
		caption.Position = UDim2.fromOffset(40, 0)
		caption.Size = UDim2.new(1, -48, 1, 0)
	end
	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		UIKit.tween(scale, T.Motion.Fast, { Scale = 1.05 })
		UIKit.tween(stroke, T.Motion.Fast, { Color = C.Accent })
		UIKit.tween(icon, T.Motion.Normal, { Rotation = props.HoverRotation or 0 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		UIKit.tween(scale, T.Motion.Fast, { Scale = 1 })
		UIKit.tween(stroke, T.Motion.Fast, { Color = C.Stroke })
		UIKit.tween(icon, T.Motion.Normal, { Rotation = 0 })
	end)
	button.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.08, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		UIKit.tween(scale, T.Motion.Normal, { Scale = hovering and 1.05 or 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		-- Tap bounce so touch devices also see press feedback.
		scale.Scale = 0.92
		UIKit.tween(scale, T.Motion.Normal, { Scale = 1 }, Enum.EasingStyle.Back)
		props.OnClick()
	end)
	return button
end

function HUD.new(root: ScreenGui, callbacks)
	local self = setmetatable({}, HUD)
	self.callbacks = callbacks

	-- TOP CENTER bar
	self.top = UIKit.new("CanvasGroup", {
		Name = "TopCenter",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = root,
	})
	UIKit.corner(self.top, 999)
	UIKit.stroke(self.top, C.Stroke)
	UIKit.padding(self.top, 4, 6)
	UIKit.list(self.top, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	self.menuButton = UIKit.button({
		Name = "Menu",
		Text = "Menu",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(58, 30),
		Radius = 999,
		LayoutOrder = 1,
		Parent = self.top,
		OnClick = function()
			self:toggleMenu()
		end,
	})
	self.flagHolder = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(25, 18),
		LayoutOrder = 2,
		Parent = self.top,
	})
	self.nameLabel = UIKit.label({
		Text = "",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		LayoutOrder = 3,
		Parent = self.top,
	})
	UIKit.new("Frame", {
		BackgroundColor3 = C.Stroke,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(1, 18),
		LayoutOrder = 4,
		Parent = self.top,
	})
	self.popLabel = UIKit.label({
		Name = "Population",
		Text = "Population 0 / 0",
		TextSize = T.TextSize.Small,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		LayoutOrder = 5,
		Parent = self.top,
	})
	self.stageChip = UIKit.label({
		Name = "ShortageChip",
		Text = "",
		Font = T.Fonts.Bold,
		TextColor3 = C.Warning,
		TextSize = T.TextSize.Tiny,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		LayoutOrder = 6,
		Visible = false,
		Parent = self.top,
	})
	self.saveChip = UIKit.label({
		Text = "Saving off",
		TextColor3 = C.Danger,
		TextSize = T.TextSize.Tiny,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		LayoutOrder = 7,
		Visible = false,
		Parent = self.top,
	})

	-- Menu popover (under the top bar)
	self.menu = UIKit.panel({
		Name = "MenuPopover",
		Canvas = true,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.fromOffset(190, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = root,
	})
	UIKit.padding(self.menu, 8)
	UIKit.list(self.menu, Enum.FillDirection.Vertical, 6)
	UIKit.button({
		Text = "Save now",
		TextSize = T.TextSize.Small,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 1,
		Parent = self.menu,
		OnClick = function()
			self:closeMenu()
			self.callbacks.onSave()
		end,
	})
	UIKit.button({
		Text = "Main menu",
		TextSize = T.TextSize.Small,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 2,
		Parent = self.menu,
		OnClick = function()
			self:closeMenu()
			self.callbacks.onChangeSlot()
		end,
	})

	-- BOTTOM CENTER build button
	self.hammer = iconButton({
		Name = "BuildButton",
		Text = "BUILD",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(112, 42),
		HoverRotation = -18,
		Parent = root,
		Icon = function(parent)
			return UIKit.hammerIcon(parent, 20, C.AccentDark)
		end,
		OnClick = function()
			self:toggleTools()
		end,
	})

	-- Tool popover: BUILD / DEMOLISH
	self.tools = UIKit.panel({
		Name = "BuildTools",
		Canvas = true,
		Radius = 999,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -66),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = root,
	})
	UIKit.padding(self.tools, 5)
	UIKit.list(self.tools, Enum.FillDirection.Horizontal, 6, nil, Enum.VerticalAlignment.Center)
	UIKit.button({
		Text = "Build",
		Style = "primary",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(92, 34),
		Radius = 999,
		LayoutOrder = 1,
		Parent = self.tools,
		OnClick = function()
			self:closeTools()
			self.callbacks.onOpenBuild()
		end,
	})
	UIKit.button({
		Text = "Demolish",
		Style = "danger",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(92, 34),
		Radius = 999,
		LayoutOrder = 2,
		Parent = self.tools,
		OnClick = function()
			self:closeTools()
			self.callbacks.onDemolish()
		end,
	})

	-- RIGHT side STATS button
	self.statsButton = iconButton({
		Name = "StatsButton",
		Text = "STATS",
		Vertical = true,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(54, 58),
		HoverRotation = 0,
		Parent = root,
		Icon = function(parent)
			return UIKit.statsIcon(parent, 20, C.AccentDark)
		end,
		OnClick = function()
			self.callbacks.onStats()
		end,
	})
	return self
end

function HUD:toggleTools()
	if self.tools.Visible then
		self:closeTools()
	else
		self:closeMenu()
		UIKit.open(self.tools, 8)
	end
end

function HUD:closeTools()
	UIKit.close(self.tools, 8)
end

function HUD:toggleMenu()
	if self.menu.Visible then
		self:closeMenu()
	else
		UIKit.open(self.menu, -6)
	end
end

function HUD:closeMenu()
	UIKit.close(self.menu, -6)
end

function HUD:setHammerVisible(visible: boolean)
	self.hammer.Visible = visible
	if not visible then
		self.tools.Visible = false
	end
end

function HUD:show()
	UIKit.open(self.top, -8)
	self.hammer.Visible = true
	self.statsButton.Visible = true
	local base = UDim2.new(0.5, 0, 1, -16)
	self.hammer.Position = base + UDim2.fromOffset(0, 60)
	UIKit.tween(self.hammer, T.Motion.Slow, { Position = base }, Enum.EasingStyle.Back)
	local statsBase = UDim2.new(1, -12, 0.5, 0)
	self.statsButton.Position = statsBase + UDim2.fromOffset(80, 0)
	UIKit.tween(self.statsButton, T.Motion.Slow, { Position = statsBase }, Enum.EasingStyle.Back)
end

function HUD:hide()
	self.top.Visible = false
	self.menu.Visible = false
	self.tools.Visible = false
	self.hammer.Visible = false
	self.statsButton.Visible = false
end

local STAGE_TEXT = {
	WARNING = "Water warning",
	PROLONGED_SHORTAGE = "Water shortage",
	POPULATION_PROBLEMS = "Water crisis",
	GRADUAL_POPULATION_DECREASE = "Population falling",
}

function HUD:update(state)
	if not state or not state.Active then
		return
	end
	if self.lastFlag ~= state.FlagId then
		self.lastFlag = state.FlagId
		for _, child in ipairs(self.flagHolder:GetChildren()) do
			child:Destroy()
		end
		local flag = UIKit.flag(self.flagHolder, Countries.get(state.FlagId or ""), 18)
		flag.Size = UDim2.fromScale(1, 1)
	end
	self.nameLabel.Text = state.Name or ""
	local previous = self.lastPopulation
	self.popLabel.Text = string.format("Population %d / %d", state.Population or 0, state.HousingCapacity or 0)
	if previous ~= nil and state.Population ~= previous then
		self.popLabel.TextColor3 = (state.Population or 0) > previous and C.AccentDark or C.Danger
		UIKit.tween(self.popLabel, T.Motion.Slow, { TextColor3 = C.Text })
	end
	self.lastPopulation = state.Population
	self.saveChip.Visible = state.Persistent == false
	local stage = state.Water and state.Water.Stage
	local text = stage and STAGE_TEXT[stage]
	self.stageChip.Visible = text ~= nil
	self.stageChip.Text = text or ""
	self.stageChip.TextColor3 = (stage == "WARNING") and C.Warning or C.Danger
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">MainMenu</string>
            <string name="Source"><![CDATA[-- MainMenu: the title screen. Big "WAR STATE" typography on a white -> light blue backdrop,
-- soft floating shapes (looping tweens, no per-frame code), and the 3 save slot cards.
-- The backdrop stays visible behind COUNTRY SETUP and PLOT SELECTION, then fades into the game.

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local SlotScreen = require(script.Parent:WaitForChild("SlotScreen"))

local TweenService = game:GetService("TweenService")

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local MainMenu = {}
MainMenu.__index = MainMenu

local DESIGN_W, DESIGN_H = 420, 470

local function floatTween(inst: Instance, props, duration: number)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tween = TweenService:Create(inst, info, props)
	tween:Play()
	return tween
end

function MainMenu.new(backdropGui: ScreenGui, root: ScreenGui, callbacks)
	local self = setmetatable({}, MainMenu)
	self.callbacks = callbacks
	self.loops = {}

	-- Backdrop (full screen, below the UI) ---------------------------------------------------
	self.backdrop = UIKit.new("CanvasGroup", {
		Name = "MenuBackdrop",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = backdropGui,
	})
	UIKit.gradient(self.backdrop, C.SkyTop, C.SkyBottom, 90)
	local shapes = {
		{ 0.12, 0.2, 260, 0.82 },
		{ 0.88, 0.28, 320, 0.86 },
		{ 0.78, 0.86, 380, 0.88 },
		{ 0.2, 0.84, 220, 0.84 },
	}
	self.shapes = {}
	for i, s in ipairs(shapes) do
		local circle = UIKit.new("Frame", {
			Name = "Shape" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(s[1], s[2]),
			Size = UDim2.fromOffset(s[3], s[3]),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = s[4],
			BorderSizePixel = 0,
			Parent = self.backdrop,
		})
		UIKit.corner(circle, 999)
		table.insert(self.shapes, { frame = circle, base = circle.Position, index = i })
	end
	-- A thin horizon line with small "islands" for a hint of the map.
	local horizon = UIKit.new("Frame", {
		Name = "Horizon",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, 0, 0.16, 0),
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Parent = self.backdrop,
	})
	for i, x in ipairs({ 0.18, 0.34, 0.5, 0.66, 0.82 }) do
		local w = (i == 3) and 150 or 60
		local island = UIKit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, 0.5),
			Size = UDim2.fromOffset(w, 14),
			BackgroundColor3 = C.Background,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Parent = horizon,
		})
		UIKit.corner(island, 999)
	end

	-- Foreground content ---------------------------------------------------------------------
	self.content = UIKit.new("CanvasGroup", {
		Name = "MainMenu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		Visible = false,
		Parent = root,
	})
	UIKit.autoScale(self.content, DESIGN_W, DESIGN_H)

	self.title = UIKit.label({
		Name = "Title",
		Text = "WAR STATE",
		Font = T.Fonts.Title,
		TextSize = T.TextSize.Hero,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 70),
		Parent = self.content,
	})
	self.titleBase = self.title.Position
	self.underline = UIKit.new("Frame", {
		Name = "Underline",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 74),
		Size = UDim2.fromOffset(0, 4),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Parent = self.content,
	})
	UIKit.corner(self.underline, 999)
	self.subtitle = UIKit.label({
		Text = "Build a nation from zero",
		Font = T.Fonts.Medium,
		TextSize = T.TextSize.Body,
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 20),
		Parent = self.content,
	})

	self.slotHolder = UIKit.new("Frame", {
		Name = "SlotHolder",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(380, 300),
		Parent = self.content,
	})
	self.slots = SlotScreen.new(self.slotHolder, callbacks)

	self.footer = UIKit.label({
		Text = "Phase 2 · City builder foundation",
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = self.content,
	})
	return self
end

function MainMenu:startLoops()
	self:stopLoops()
	table.insert(self.loops, floatTween(self.title, { Position = self.titleBase + UDim2.fromOffset(0, -3) }, 2.8))
	for _, s in ipairs(self.shapes) do
		local dy = (s.index % 2 == 0) and 14 or -14
		table.insert(self.loops, floatTween(s.frame, { Position = s.base + UDim2.fromOffset(dy * 0.6, dy) }, 6 + s.index))
	end
end

function MainMenu:stopLoops()
	for _, tween in ipairs(self.loops) do
		tween:Cancel()
	end
	self.loops = {}
	self.title.Position = self.titleBase
	for _, s in ipairs(self.shapes) do
		s.frame.Position = s.base
	end
end

function MainMenu:showBackdrop()
	if not self.backdrop.Visible then
		UIKit.fade(self.backdrop, true, T.Motion.Slow)
	end
end

-- Full title screen with slots.
function MainMenu:show(profile)
	self:showBackdrop()
	self.slots:render(profile)
	self.content.Visible = true
	self.content.GroupTransparency = 1
	UIKit.tween(self.content, T.Motion.Slow, { GroupTransparency = 0 })
	-- Title reveal: slide + fade, underline grows, slots slide in slightly later.
	self.title.TextTransparency = 1
	self.title.Position = self.titleBase + UDim2.fromOffset(0, 14)
	UIKit.tween(self.title, T.Motion.Hero, { TextTransparency = 0, Position = self.titleBase })
	self.underline.Size = UDim2.fromOffset(0, 4)
	task.delay(0.25, function()
		UIKit.tween(self.underline, T.Motion.Hero, { Size = UDim2.fromOffset(120, 4) })
	end)
	self.subtitle.TextTransparency = 1
	task.delay(0.35, function()
		UIKit.tween(self.subtitle, T.Motion.Slow, { TextTransparency = 0 })
	end)
	self.slots:reveal(0.45)
	task.delay(T.Motion.Hero, function()
		if self.content.Visible then
			self:startLoops()
		end
	end)
end

-- Keep only the backdrop (used behind COUNTRY SETUP / PLOT SELECTION).
function MainMenu:hideContent()
	self:stopLoops()
	UIKit.fade(self.content, false, T.Motion.Fast)
end

-- Fade everything out (entering the game).
function MainMenu:hide()
	self:stopLoops()
	UIKit.fade(self.content, false, T.Motion.Fast)
	UIKit.fade(self.backdrop, false, T.Motion.Slow)
end

return MainMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">PlacementBar</string>
            <string name="Source"><![CDATA[-- PlacementBar: bottom-center controls while building (works on PC and mobile).
-- Road mode: hold + drag hint and live tile count. Building mode: Style / Rotate / Place / Done.
-- Demolish mode: hint + Done. Validity: neutral text when valid, subtle red reason when invalid.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local RoadConfig = require(Config:WaitForChild("RoadConfig"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local PlacementBar = {}
PlacementBar.__index = PlacementBar

local DESIGN_W, DESIGN_H = 460, 96

local function displayName(kind, id)
	if kind == "Demolish" then
		return "Demolish"
	end
	local list = kind == "Road" and RoadConfig.Types or BuildingConfig.Buildings
	for _, entry in ipairs(list) do
		if entry.Id == id then
			return entry.DisplayName
		end
	end
	return id
end

function PlacementBar.new(root: ScreenGui, callbacks)
	callbacks = callbacks or {}
	local self = setmetatable({}, PlacementBar)
	self.panel = UIKit.panel({
		Name = "PlacementBar",
		Canvas = true,
		Radius = T.Radius.Large,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		Visible = false,
		Parent = root,
	})
	UIKit.autoScale(self.panel, DESIGN_W, DESIGN_H + 40)
	UIKit.padding(self.panel, 10, 14)
	self.title = UIKit.label({
		Text = "",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Small,
		Size = UDim2.new(0.45, 0, 0, 18),
		Parent = self.panel,
	})
	self.status = UIKit.label({
		Text = "",
		TextSize = T.TextSize.Small,
		TextColor3 = C.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.55, 0, 0, 18),
		Parent = self.panel,
	})
	self.hint = UIKit.label({
		Text = "",
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.TextMuted,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = self.panel,
	})
	local row = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = self.panel,
	})
	UIKit.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	self.styleButton = UIKit.button({
		Text = "Style A",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(84, 36),
		Radius = 999,
		LayoutOrder = 1,
		Parent = row,
		OnClick = callbacks.onStyle,
	})
	self.rotateButton = UIKit.button({
		Text = "Rotate (R)",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(96, 36),
		Radius = 999,
		LayoutOrder = 2,
		Parent = row,
		OnClick = callbacks.onRotate,
	})
	self.placeButton = UIKit.button({
		Text = "Place",
		Style = "primary",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(110, 36),
		Radius = 999,
		LayoutOrder = 3,
		Parent = row,
		OnClick = callbacks.onPlace,
	})
	UIKit.button({
		Text = "Done (Q)",
		TextSize = T.TextSize.Small,
		Size = UDim2.fromOffset(90, 36),
		Radius = 999,
		LayoutOrder = 4,
		Parent = row,
		OnClick = callbacks.onDone,
	})
	return self
end

function PlacementBar:update(status)
	if not status.Active then
		return
	end
	local kind = status.Kind
	self.title.Text = displayName(kind, status.Id)
	self.styleButton.Instance.Visible = kind == "Building"
	self.rotateButton.Instance.Visible = kind == "Building"
	self.placeButton.Instance.Visible = kind == "Building"
	if kind == "Road" then
		self.hint.Text = "Hold left mouse (or finger) and drag · release to build"
	elseif kind == "Demolish" then
		self.hint.Text = "Click one of your buildings or road tiles to remove it"
	else
		self.hint.Text = "Click to place · R rotate · Q done"
	end
	if status.Variant then
		local letter = string.match(status.Variant, "_(%w+)$") or "A"
		self.styleButton.setText("Style " .. letter)
	end
	if status.Valid then
		if kind == "Road" and status.Tiles then
			self.status.Text = string.format("%d new tile%s", status.Tiles, status.Tiles == 1 and "" or "s")
		elseif kind == "Demolish" then
			self.status.Text = status.TargetLabel or "Ready"
		else
			self.status.Text = "Ready to place"
		end
		self.status.TextColor3 = C.TextMuted
	else
		self.status.Text = status.Reason or "Invalid placement"
		self.status.TextColor3 = C.Danger
	end
	self.placeButton.setDisabled(not status.Valid)
end

function PlacementBar:show()
	UIKit.open(self.panel, 16)
end

function PlacementBar:hide()
	UIKit.close(self.panel, 16)
end

return PlacementBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">PlotScreen</string>
            <string name="Source"><![CDATA[-- PlotScreen: PLOT SELECTION. Shows the map (central island + 6 player islands) and lets the
-- player claim a FREE plot. Occupied plots cannot be selected. The server re-validates the claim.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfig"))
local Countries = require(Shared:WaitForChild("Modules"):WaitForChild("Countries"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local PlotScreen = {}
PlotScreen.__index = PlotScreen

local DESIGN_W, DESIGN_H = 580, 392
local MAP_PX = 320

function PlotScreen.new(root: ScreenGui, callbacks)
	local self = setmetatable({}, PlotScreen)
	self.callbacks = callbacks
	self.plots = {}
	self.selected = nil
	self.buttons = {}

	self.panel = UIKit.panel({
		Name = "PlotScreen",
		Canvas = true,
		Radius = T.Radius.Large,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		Visible = false,
		Parent = root,
	})
	UIKit.autoScale(self.panel, DESIGN_W, DESIGN_H)
	UIKit.padding(self.panel, 18)

	UIKit.label({
		Text = "Choose your plot",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Header,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = self.panel,
	})
	self.subtitle = UIKit.label({
		Text = "Pick a free island. Your country will be built there.",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = self.panel,
	})

	-- Map ------------------------------------------------------------------------------------
	self.map = UIKit.new("Frame", {
		Name = "Map",
		BackgroundColor3 = Color3.fromRGB(214, 234, 250),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.fromOffset(MAP_PX, MAP_PX - 24),
		ClipsDescendants = true,
		Parent = self.panel,
	})
	UIKit.corner(self.map, T.Radius.Medium)
	UIKit.stroke(self.map, C.Stroke)

	local extent = 0
	for _, p in ipairs(GameConfig.Map.Plots) do
		extent = math.max(extent, math.abs(p.CenterX), math.abs(p.CenterZ))
	end
	local islandSize = GameConfig.Territory.Size + GameConfig.Territory.RimWidth * 2
	extent += islandSize / 2 + 20
	local mapW, mapH = MAP_PX, MAP_PX - 24
	local scale = math.min(mapW, mapH) / (extent * 2)
	local function toMap(x, z)
		return UDim2.fromOffset(mapW / 2 + x * scale, mapH / 2 + z * scale)
	end
	local central = GameConfig.Map.CentralIsland
	local centralFrame = UIKit.new("Frame", {
		Name = "CentralIsland",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = toMap(central.CenterX, central.CenterZ),
		Size = UDim2.fromOffset(central.Size * scale, central.Size * scale),
		BackgroundColor3 = Color3.fromRGB(196, 222, 184),
		BorderSizePixel = 0,
		Parent = self.map,
	})
	UIKit.corner(centralFrame, 18)
	UIKit.label({
		Text = "CENTRAL",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextColor3 = Color3.fromRGB(96, 128, 90),
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = centralFrame,
	})

	for _, p in ipairs(GameConfig.Map.Plots) do
		local b
		b = UIKit.button({
			Name = "Plot" .. p.Index,
			Text = "",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = toMap(p.CenterX, p.CenterZ),
			Size = UDim2.fromOffset(islandSize * scale, islandSize * scale),
			Radius = 12,
			Style = "ghost",
			Parent = self.map,
			OnClick = function()
				self:select(p.Index)
			end,
		})
		local title = UIKit.label({
			Name = "Title",
			Text = "P" .. p.Index,
			Font = T.Fonts.Bold,
			TextSize = T.TextSize.Body,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = b.Instance,
		})
		local status = UIKit.label({
			Name = "Status",
			Text = "Free",
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.Success,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(2, 28),
			Size = UDim2.new(1, -4, 0, 14),
			Parent = b.Instance,
		})
		self.buttons[p.Index] = { api = b, title = title, status = status }
	end

	-- Details --------------------------------------------------------------------------------
	local side = UIKit.new("Frame", {
		Name = "Details",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(MAP_PX + 16, 54),
		Size = UDim2.new(1, -(MAP_PX + 16), 1, -54),
		Parent = self.panel,
	})
	self.detailTitle = UIKit.label({
		Text = "No plot selected",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Title,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = side,
	})
	self.detailStatus = UIKit.label({
		Text = "Tap an island on the map",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Small,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 34),
		Parent = side,
	})
	UIKit.label({
		Text = "Each plot has its own exit and bridge to the central island (future land battles).",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Tiny,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = side,
	})
	self.error = UIKit.label({
		Text = "",
		TextColor3 = C.Danger,
		TextSize = T.TextSize.Small,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -92),
		Size = UDim2.new(1, 0, 0, 32),
		Parent = side,
	})
	self.claimButton = UIKit.button({
		Text = "Claim plot",
		Style = "primary",
		TextSize = T.TextSize.Small,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -46),
		Size = UDim2.new(1, 0, 0, 38),
		Radius = 999,
		Parent = side,
		OnClick = function()
			self:claim()
		end,
	})
	self.claimButton.setDisabled(true)
	UIKit.button({
		Text = "Back to menu",
		TextSize = T.TextSize.Small,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 36),
		Radius = 999,
		Style = "ghost",
		Parent = side,
		OnClick = function()
			if not self.claiming then
				self.callbacks.onBack()
			end
		end,
	})
	return self
end

function PlotScreen:setPlots(plots)
	self.plots = {}
	for _, info in ipairs(plots or {}) do
		self.plots[info.Index] = info
	end
	for index, entry in pairs(self.buttons) do
		local info = self.plots[index]
		local free = info == nil or info.Free
		entry.api.setDisabled(not free)
		entry.api.setSelected(free and self.selected == index)
		if free then
			entry.status.Text = "Free"
			entry.status.TextColor3 = C.Success
			entry.title.TextColor3 = C.Text
		else
			local flag = Countries.get(info.FlagId or "")
			entry.status.Text = (flag and flag.EmojiFallback .. " " or "") .. tostring(info.OwnerName or "Taken")
			entry.status.TextColor3 = C.TextMuted
			entry.title.TextColor3 = C.TextMuted
		end
	end
	if self.selected and not (self.plots[self.selected] == nil or self.plots[self.selected].Free) then
		self.selected = nil
		self:setError("That plot was just taken. Pick another one.")
	end
	self:renderDetails()
end

function PlotScreen:setError(text: string?)
	self.error.Text = text or ""
end

function PlotScreen:renderDetails()
	local index = self.selected
	if not index then
		self.detailTitle.Text = "No plot selected"
		self.detailStatus.Text = "Tap a free island on the map"
		self.claimButton.setDisabled(true)
		return
	end
	self.detailTitle.Text = "Plot " .. index
	self.detailStatus.Text = "Free · ready to claim"
	self.claimButton.setDisabled(self.claiming == true)
end

function PlotScreen:select(index: number)
	local info = self.plots[index]
	if info and not info.Free then
		self:setError("Plot " .. index .. " is owned by " .. tostring(info.OwnerName))
		return
	end
	self:setError(nil)
	self.selected = index
	for i, entry in pairs(self.buttons) do
		entry.api.setSelected(i == index)
	end
	self:renderDetails()
end

function PlotScreen:claim()
	if self.claiming or not self.selected then
		return
	end
	self.claiming = true
	self.claimButton.setText("Claiming...")
	self.claimButton.setDisabled(true)
	local index = self.selected
	task.spawn(function()
		local result = self.callbacks.onClaim(index)
		self.claiming = false
		self.claimButton.setText("Claim plot")
		if result and result.ok then
			self:hide()
		else
			self:setError(result and result.error or "Could not claim plot")
			if result and result.plots then
				self:setPlots(result.plots)
			end
			self:renderDetails()
		end
	end)
end

function PlotScreen:show(plots, preferredIndex: number?)
	self.selected = nil
	self.claiming = false
	self:setError(nil)
	self:setPlots(plots)
	if preferredIndex and self.plots[preferredIndex] and self.plots[preferredIndex].Free then
		self:select(preferredIndex)
	end
	UIKit.open(self.panel, 16)
end

function PlotScreen:hide()
	UIKit.close(self.panel, 16)
end

function PlotScreen:isOpen(): boolean
	return self.panel.Visible
end

return PlotScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">SlotScreen</string>
            <string name="Source"><![CDATA[-- SlotScreen: exactly 3 save slot cards (Slot 1 FREE, slots 2-3 LOCKED, no monetization yet).
-- Rendered inside the MainMenu.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local Countries = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("Countries"))
local TechnologyConfig =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("TechnologyConfig"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local SlotScreen = {}
SlotScreen.__index = SlotScreen

local ROW_H = 64

local function techName(id)
	for _, branch in ipairs(TechnologyConfig.Branches) do
		if branch.Id == id then
			return branch.DisplayName
		end
	end
	return id or ""
end

function SlotScreen.new(parent: GuiObject, callbacks)
	local self = setmetatable({}, SlotScreen)
	self.callbacks = callbacks
	self.panel = UIKit.new("Frame", {
		Name = "SlotScreen",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	UIKit.label({
		Text = "SELECT A SAVE SLOT",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.AccentDark,
		Size = UDim2.new(1, 0, 0, 16),
		Parent = self.panel,
	})
	self.rows = UIKit.new("Frame", {
		Name = "Rows",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 3 * ROW_H + 2 * 8),
		Parent = self.panel,
	})
	UIKit.list(self.rows, Enum.FillDirection.Vertical, 8)
	self.note = UIKit.label({
		Text = "",
		TextColor3 = C.TextMuted,
		TextSize = T.TextSize.Tiny,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 22 + 3 * ROW_H + 2 * 8 + 8),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = self.panel,
	})
	self.rowFrames = {}
	return self
end

function SlotScreen:render(profile)
	for _, child in ipairs(self.rows:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.rowFrames = {}
	for _, slot in ipairs(profile.slots) do
		local row = UIKit.new("CanvasGroup", {
			Name = "Slot" .. slot.Index,
			BackgroundColor3 = slot.Locked and C.Surface or C.Background,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, ROW_H),
			LayoutOrder = slot.Index,
			Parent = self.rows,
		})
		UIKit.corner(row, T.Radius.Medium)
		local rowStroke = UIKit.stroke(row, C.Stroke)
		UIKit.padding(row, 10, 14)
		table.insert(self.rowFrames, row)
		row.MouseEnter:Connect(function()
			if not slot.Locked then
				UIKit.tween(rowStroke, T.Motion.Fast, { Color = C.Accent })
			end
		end)
		row.MouseLeave:Connect(function()
			UIKit.tween(rowStroke, T.Motion.Fast, { Color = C.Stroke })
		end)

		local title = "SLOT " .. slot.Index
		local subtitle
		if slot.Locked then
			subtitle = "Locked"
		elseif slot.Empty then
			subtitle = "Free · Empty"
		else
			subtitle = string.format("%s · Pop %d", techName(slot.TechnologyBranch), slot.Population or 0)
			title = slot.Name or title
		end

		local flagEntry = (not slot.Empty) and Countries.get(slot.FlagId or "") or nil
		local textX = 0
		if flagEntry then
			local flag = UIKit.flag(row, flagEntry, 26)
			flag.AnchorPoint = Vector2.new(0, 0.5)
			flag.Position = UDim2.fromScale(0, 0.5)
			textX = 46
		else
			local badge = UIKit.new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.fromOffset(36, 36),
				BackgroundColor3 = slot.Locked and C.Gray or C.AccentSoft,
				BorderSizePixel = 0,
				Parent = row,
			})
			UIKit.corner(badge, 10)
			UIKit.label({
				Text = tostring(slot.Index),
				Font = T.Fonts.Bold,
				TextColor3 = slot.Locked and C.TextMuted or C.AccentDark,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = badge,
			})
			textX = 48
		end
		UIKit.label({
			Text = title,
			Font = T.Fonts.Bold,
			Position = UDim2.fromOffset(textX, 4),
			Size = UDim2.new(1, -(textX + 150), 0, 20),
			TextColor3 = slot.Locked and C.TextMuted or C.Text,
			Parent = row,
		})
		UIKit.label({
			Text = subtitle,
			TextColor3 = C.TextMuted,
			TextSize = T.TextSize.Small,
			Position = UDim2.fromOffset(textX, 24),
			Size = UDim2.new(1, -(textX + 150), 0, 16),
			Parent = row,
		})

		if slot.Locked then
			local lock = UIKit.button({
				Text = "Locked",
				TextSize = T.TextSize.Small,
				Size = UDim2.fromOffset(84, 32),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Parent = row,
			})
			lock.setDisabled(true)
		elseif slot.Empty then
			UIKit.button({
				Text = "Create",
				Style = "primary",
				TextSize = T.TextSize.Small,
				Size = UDim2.fromOffset(84, 32),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Radius = 999,
				Parent = row,
				OnClick = function()
					self.callbacks.onCreate(slot.Index)
				end,
			})
		else
			UIKit.button({
				Text = "Play",
				Style = "primary",
				TextSize = T.TextSize.Small,
				Size = UDim2.fromOffset(64, 32),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.fromScale(1, 0.5),
				Radius = 999,
				Parent = row,
				OnClick = function()
					self.callbacks.onPlay(slot.Index)
				end,
			})
			local armed = false
			local delete
			delete = UIKit.button({
				Text = "Delete",
				Style = "danger",
				TextSize = T.TextSize.Tiny,
				Size = UDim2.fromOffset(70, 32),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -72, 0.5, 0),
				Radius = 999,
				Parent = row,
				OnClick = function()
					if not armed then
						armed = true
						delete.setText("Confirm")
						task.delay(3, function()
							armed = false
							if delete.Instance.Parent then
								delete.setText("Delete")
							end
						end)
					else
						self.callbacks.onDelete(slot.Index)
					end
				end,
			})
		end
	end
	if profile.persistent then
		self.note.Text = "Progress is saved to your slots."
	else
		self.note.Text = "Saving is OFF this session (Studio API access disabled or DataStore unavailable)."
	end
end

-- Staggered slide + fade of the slot cards.
function SlotScreen:reveal(delay: number?)
	for i, row in ipairs(self.rowFrames) do
		row.GroupTransparency = 1
		task.delay((delay or 0) + (i - 1) * 0.07, function()
			if row.Parent then
				UIKit.tween(row, T.Motion.Slow, { GroupTransparency = 0 })
			end
		end)
	end
end

function SlotScreen:show(profile)
	self:render(profile)
	self:reveal(0)
end

function SlotScreen:hide() end

return SlotScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">StatsPanel</string>
            <string name="Source"><![CDATA[-- StatsPanel: right-side panel opened by the STATS button. Shows REAL server data only
-- (snapshot.Stats / Water / Power / WaterList / PowerList built by StatsService).
-- Updates whenever the server pushes a new snapshot (build, demolish, completion, new source,
-- coverage or consumption change). Rebuilds only while open.

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))

local C = UIKit.Theme.Colors
local T = UIKit.Theme

local StatsPanel = {}
StatsPanel.__index = StatsPanel

local WIDTH = 300

local STAGE_LABEL = {
	NORMAL = { "Normal", "GREEN" },
	WARNING = { "Warning", "WARNING" },
	PROLONGED_SHORTAGE = { "Prolonged shortage", "RED" },
	POPULATION_PROBLEMS = { "Population problems", "RED" },
	GRADUAL_POPULATION_DECREASE = { "Population decreasing", "RED" },
}

local GLYPH = { GREEN = "✓", RED = "✕", GREY = "—" }

function StatsPanel.new(root: ScreenGui, callbacks)
	local self = setmetatable({}, StatsPanel)
	self.callbacks = callbacks or {}
	self.snapshot = nil
	self.panel = UIKit.panel({
		Name = "StatsPanel",
		Canvas = true,
		Radius = T.Radius.Large,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -76, 0.5, 0),
		Size = UDim2.new(0, WIDTH, 1, -150),
		Visible = false,
		Parent = root,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(WIDTH, 560)
	constraint.MinSize = Vector2.new(WIDTH, 240)
	constraint.Parent = self.panel
	UIKit.padding(self.panel, 14)

	local icon = UIKit.statsIcon(self.panel, 16, C.AccentDark)
	icon.Position = UDim2.fromOffset(0, 4)
	UIKit.label({
		Text = "STATS",
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Body,
		TextColor3 = C.Text,
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -90, 0, 24),
		Parent = self.panel,
	})
	UIKit.button({
		Text = "Close",
		TextSize = T.TextSize.Tiny,
		Style = "ghost",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(56, 24),
		Radius = 999,
		Parent = self.panel,
		OnClick = function()
			self:hide()
		end,
	})
	self.scroll = UIKit.vScroll({
		Name = "Body",
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 1, -32),
		Parent = self.panel,
	})
	UIKit.list(self.scroll, Enum.FillDirection.Vertical, 8)
	UIKit.padding(self.scroll, 0, 2)
	return self
end

local function sectionTitle(parent, text, order)
	return UIKit.label({
		Text = text,
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.AccentDark,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = order,
		Parent = parent,
	})
end

local function statGrid(parent, entries, order)
	local grid = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, math.ceil(#entries / 2) * 50 - 6),
		LayoutOrder = order,
		Parent = parent,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.5, -3, 0, 44)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, e in ipairs(entries) do
		local cell = UIKit.new("Frame", {
			BackgroundColor3 = C.Surface,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = grid,
		})
		UIKit.corner(cell, T.Radius.Small)
		UIKit.stroke(cell, C.Stroke)
		UIKit.padding(cell, 5, 9)
		UIKit.label({
			Text = e[1],
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.TextMuted,
			Size = UDim2.new(1, 0, 0, 14),
			Parent = cell,
		})
		UIKit.label({
			Text = tostring(e[2]),
			Font = T.Fonts.Bold,
			TextSize = T.TextSize.Body,
			TextColor3 = C.Text,
			Position = UDim2.fromOffset(0, 16),
			Size = UDim2.new(1, 0, 0, 18),
			Parent = cell,
		})
	end
	return grid
end

local function meter(parent, label, value, maxValue, order, fillColor)
	local holder = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.label({
		Text = label,
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.TextMuted,
		Size = UDim2.new(0.6, 0, 0, 14),
		Parent = holder,
	})
	UIKit.label({
		Text = tostring(value),
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, 0, 0, 14),
		Parent = holder,
	})
	local track = UIKit.new("Frame", {
		BackgroundColor3 = C.Gray,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 6),
		Parent = holder,
	})
	UIKit.corner(track, 999)
	local fraction = (maxValue > 0) and math.clamp(value / maxValue, 0, 1) or 0
	local fill = UIKit.new("Frame", {
		BackgroundColor3 = fillColor or C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	UIKit.corner(fill, 999)
	UIKit.tween(fill, T.Motion.Slow, { Size = UDim2.fromScale(fraction, 1) })
	return holder
end

local function statusList(parent, rows, order, extraRoads)
	local list = UIKit.new("Frame", {
		BackgroundColor3 = C.Surface,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.corner(list, T.Radius.Small)
	UIKit.stroke(list, C.Stroke)
	UIKit.padding(list, 6, 10)
	UIKit.list(list, Enum.FillDirection.Vertical, 2)
	if #rows == 0 then
		UIKit.label({
			Text = "Nothing built yet",
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.TextMuted,
			Size = UDim2.new(1, 0, 0, 18),
			Parent = list,
		})
	end
	for i, row in ipairs(rows) do
		local line = UIKit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = i,
			Parent = list,
		})
		local status = row.Pending and "GREY" or row.Status
		local color = UIKit.statusColor(status)
		local dot = UIKit.statusDot(line, color, 7)
		dot.AnchorPoint = Vector2.new(0, 0.5)
		dot.Position = UDim2.fromScale(0, 0.5)
		UIKit.label({
			Text = GLYPH[status] or "—",
			Font = T.Fonts.Bold,
			TextSize = T.TextSize.Tiny,
			TextColor3 = color,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(0, 14, 1, 0),
			Parent = line,
		})
		UIKit.label({
			Text = row.Label,
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.Text,
			Position = UDim2.fromOffset(28, 0),
			Size = UDim2.new(1, -96, 1, 0),
			Parent = line,
		})
		local right
		if row.Pending then
			right = "building"
		elseif (row.Required or 0) > 0 then
			right = string.format("%d / %d", row.Supplied or 0, row.Required)
		else
			right = "not required"
		end
		UIKit.label({
			Text = right,
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 70, 1, 0),
			Parent = line,
		})
	end
	if (extraRoads or 0) > 0 then
		UIKit.label({
			Text = string.format("+ %d more road tiles (not required)", extraRoads),
			TextSize = T.TextSize.Tiny,
			TextColor3 = C.TextMuted,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = #rows + 1,
			Parent = list,
		})
	end
	return list
end

function StatsPanel:render()
	for _, child in ipairs(self.scroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local s = self.snapshot
	if not s or not s.Active or not s.Stats then
		sectionTitle(self.scroll, "NO ACTIVE COUNTRY", 1)
		return
	end
	local st, water, power = s.Stats, s.Water or {}, s.Power or {}
	sectionTitle(self.scroll, "OVERVIEW", 1)
	statGrid(self.scroll, {
		{ "Population", string.format("%d / %d", st.Population, st.HousingCapacity) },
		{ "Buildings", st.Buildings },
		{ "Houses", st.Houses },
		{ "Businesses", st.Businesses },
		{ "Factories", st.Factories },
		{ "Roads", st.Roads },
		{ "Water Towers", st.WaterTowers },
		{ "Power Sources", st.PowerSources },
	}, 2)

	sectionTitle(self.scroll, "WATER", 10)
	local stage = STAGE_LABEL[water.Stage or "NORMAL"] or STAGE_LABEL.NORMAL
	local chip = UIKit.new("Frame", {
		BackgroundColor3 = stage[2] == "GREEN" and C.SuccessSoft or (stage[2] == "WARNING" and C.WarningSoft or C.DangerSoft),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 11,
		Parent = self.scroll,
	})
	UIKit.corner(chip, 999)
	UIKit.label({
		Text = "Supply status: " .. stage[1],
		Font = T.Fonts.Bold,
		TextSize = T.TextSize.Tiny,
		TextColor3 = stage[2] == "GREEN" and C.Success or (stage[2] == "WARNING" and C.Warning or C.Danger),
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = chip,
	})
	local waterMax = math.max(water.Production or 0, water.Demand or 0, 1)
	meter(self.scroll, "Water Production", water.Production or 0, waterMax, 12, C.Accent)
	meter(self.scroll, "Water Demand", water.Demand or 0, waterMax, 13, C.GrayDark)
	meter(self.scroll, string.format("Water Stored (cap %d)", water.Capacity or 0), math.floor(water.Stored or 0), math.max(water.Capacity or 0, 1), 14, C.AccentDark)
	statusList(self.scroll, s.WaterList or {}, 15, s.ExtraRoads)

	sectionTitle(self.scroll, "POWER", 20)
	local powerMax = math.max(power.Production or 0, power.Demand or 0, 1)
	meter(self.scroll, "Power Production", power.Production or 0, powerMax, 21, C.Warning)
	meter(self.scroll, "Power Demand", power.Demand or 0, powerMax, 22, C.GrayDark)
	statusList(self.scroll, s.PowerList or {}, 23, s.ExtraRoads)

	local legend = UIKit.label({
		Text = "✓ green = supplied · ✕ red = problem · — grey = not required",
		TextSize = T.TextSize.Tiny,
		TextColor3 = C.TextMuted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 30,
		Parent = self.scroll,
	})
	legend.Name = "Legend"
end

function StatsPanel:update(snapshot)
	self.snapshot = snapshot
	if self.panel.Visible then
		self:render()
	end
end

function StatsPanel:toggle()
	if self.panel.Visible then
		self:hide()
	else
		self:show()
	end
end

function StatsPanel:show()
	self:render()
	UIKit.open(self.panel, 0, 40)
end

function StatsPanel:hide()
	UIKit.close(self.panel, 0, nil, 40)
end

function StatsPanel:isOpen(): boolean
	return self.panel.Visible
end

return StatsPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">Toast</string>
            <string name="Source"><![CDATA[-- Toast: compact notifications under the top-center HUD.
-- Slide down + fade in, auto dismiss with slide up + fade out. Max 3 visible.

local UIKit = require(script.Parent.Parent:WaitForChild("Components"):WaitForChild("UIKit"))
local C = UIKit.Theme.Colors
local T = UIKit.Theme

local Toast = {}
Toast.__index = Toast

function Toast.new(root: ScreenGui)
	local self = setmetatable({}, Toast)
	self.container = UIKit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.fromOffset(360, 130),
		Parent = root,
	})
	UIKit.list(self.container, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	self.order = 0
	return self
end

function Toast:show(text: string, kind: string?)
	local accent = C.Accent
	if kind == "error" then
		accent = C.Danger
	elseif kind == "success" then
		accent = C.Success
	elseif kind == "warning" then
		accent = C.Warning
	end
	self.order += 1
	local item = UIKit.new("CanvasGroup", {
		Name = "Toast",
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 32),
		LayoutOrder = self.order,
		GroupTransparency = 1,
		Parent = self.container,
	})
	UIKit.corner(item, 999)
	UIKit.stroke(item, C.Stroke)
	UIKit.padding(item, 0, 14)
	UIKit.list(item, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local dot = UIKit.statusDot(item, accent, 8)
	dot.LayoutOrder = 1
	UIKit.label({
		Text = text,
		TextColor3 = C.Text,
		Font = T.Fonts.Medium,
		TextSize = T.TextSize.Small,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 32),
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		Parent = item,
	})
	local scale = Instance.new("UIScale")
	scale.Scale = 0.9
	scale.Parent = item
	UIKit.tween(item, 0.2, { GroupTransparency = 0 })
	UIKit.tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if item.Parent then
			UIKit.tween(scale, 0.2, { Scale = 0.94 })
			UIKit.tween(item, 0.22, { GroupTransparency = 1 }).Completed:Connect(function()
				item:Destroy()
			end)
		end
	end)
	local items = {}
	for _, child in ipairs(self.container:GetChildren()) do
		if child:IsA("CanvasGroup") then
			table.insert(items, child)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #items > 3 do
		table.remove(items, 1):Destroy()
	end
end

return Toast
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="100">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="101">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="102">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[-- ClientMain: the single client entry point.
-- Flow: MAIN MENU -> CREATE COUNTRY -> COUNTRY SETUP -> PLOT SELECTION -> GAME.
-- Client responsibilities: input, UI, preview. Everything permanent is requested from the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mainUI = playerGui:WaitForChild("MainUI")

mainUI.ResetOnSpawn = false
mainUI.IgnoreGuiInset = false
mainUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
mainUI.DisplayOrder = 10
pcall(function()
	mainUI.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
end)

-- Full-screen backdrop for the menus (drawn below MainUI, covers the whole screen).
local backdropGui = playerGui:FindFirstChild("WarStateBackdrop")
if not backdropGui then
	backdropGui = Instance.new("ScreenGui")
	backdropGui.Name = "WarStateBackdrop"
	backdropGui.ResetOnSpawn = false
	backdropGui.IgnoreGuiInset = true
	backdropGui.DisplayOrder = 5
	backdropGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		backdropGui.ScreenInsets = Enum.ScreenInsets.None
	end)
	backdropGui.Parent = playerGui
end

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Controllers = script.Parent:WaitForChild("Controllers")
local ClientState = require(Controllers:WaitForChild("ClientState"))
local PlacementController = require(Controllers:WaitForChild("PlacementController"))
local ConstructionBars = require(Controllers:WaitForChild("ConstructionBars"))

local Screens = mainUI:WaitForChild("Screens")
local Toast = require(Screens:WaitForChild("Toast"))
local MainMenu = require(Screens:WaitForChild("MainMenu"))
local CreateStateScreen = require(Screens:WaitForChild("CreateStateScreen"))
local PlotScreen = require(Screens:WaitForChild("PlotScreen"))
local HUD = require(Screens:WaitForChild("HUD"))
local BuildMenu = require(Screens:WaitForChild("BuildMenu"))
local PlacementBar = require(Screens:WaitForChild("PlacementBar"))
local StatsPanel = require(Screens:WaitForChild("StatsPanel"))

local function remote(name: string)
	return Remotes:WaitForChild(name)
end

local function invoke(name: string, ...)
	local args = table.pack(...)
	local ok, result = pcall(function()
		return remote(name):InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return { ok = false, error = "Connection problem" }
	end
	if type(result) ~= "table" then
		return { ok = false, error = "Unexpected server response" }
	end
	return result
end

player.CameraMaxZoomDistance = math.max(player.CameraMaxZoomDistance, 220)

local toast = Toast.new(mainUI)
local mainMenu, createScreen, plotScreen, hud, buildMenu, placementBar, statsPanel

local function showMainMenu()
	local profile = invoke(Constants.Remotes.GetProfile)
	if not profile.ok then
		toast:show(profile.error or "Could not load slots", "error")
		task.delay(2, showMainMenu)
		return
	end
	hud:hide()
	statsPanel.panel.Visible = false
	mainMenu:show(profile)
end

local function showPlotSelection(plots, preferred)
	mainMenu:showBackdrop()
	if not plots then
		local result = invoke(Constants.Remotes.GetPlots)
		plots = result.plots or {}
	end
	plotScreen:show(plots, preferred)
end

-- Country created or loaded: continue to PLOT SELECTION (no automatic plot).
local function afterCountryReady(result)
	if not result.ok then
		toast:show(result.error or "Could not open country", "error")
		return false
	end
	if result.state then
		ClientState.set(result.state)
	end
	mainMenu:hideContent()
	showPlotSelection(result.plots, result.state and result.state.LastPlotIndex)
	return true
end

local function enterGame(result)
	if result.state then
		ClientState.set(result.state)
	end
	mainMenu:hide()
	hud:show()
	hud:update(ClientState.snapshot)
	statsPanel:update(ClientState.snapshot)
	toast:show("Welcome to " .. tostring(ClientState.snapshot.Name or "your state"), "success")
end

mainMenu = MainMenu.new(backdropGui, mainUI, {
	onCreate = function(index)
		mainMenu:hideContent()
		createScreen:show(index)
	end,
	onPlay = function(index)
		afterCountryReady(invoke(Constants.Remotes.LoadSlot, index))
	end,
	onDelete = function(index)
		local result = invoke(Constants.Remotes.DeleteSlot, index)
		if result.ok then
			toast:show("Slot " .. index .. " deleted")
		else
			toast:show(result.error or "Delete failed", "error")
		end
		showMainMenu()
	end,
})

createScreen = CreateStateScreen.new(mainUI, {
	onSubmit = function(index, payload)
		local result = invoke(Constants.Remotes.CreateCountry, index, payload)
		if result.ok then
			afterCountryReady(result)
		end
		return result
	end,
	onCancel = function()
		showMainMenu()
	end,
})

plotScreen = PlotScreen.new(mainUI, {
	onClaim = function(plotIndex)
		local result = invoke(Constants.Remotes.ClaimPlot, plotIndex)
		if result.ok then
			enterGame(result)
		end
		return result
	end,
	onBack = function()
		plotScreen:hide()
		invoke(Constants.Remotes.LeaveState)
		ClientState.set({ Active = false })
		showMainMenu()
	end,
})

local function exitPlacement()
	PlacementController.cancel()
	placementBar:hide()
	hud:setHammerVisible(true)
end

buildMenu = BuildMenu.new(mainUI, {
	onSelect = function(kind, id)
		hud:setHammerVisible(false)
		PlacementController.start(kind, id)
		placementBar:show()
	end,
	onClose = function()
		hud:setHammerVisible(true)
	end,
})

placementBar = PlacementBar.new(mainUI, {
	onStyle = function()
		PlacementController.cycleVariant()
	end,
	onRotate = function()
		PlacementController.rotate()
	end,
	onPlace = function()
		PlacementController.confirm()
	end,
	onDone = function()
		local wasDemolish = PlacementController.getStatus().Kind == "Demolish"
		exitPlacement()
		if not wasDemolish then
			buildMenu:show()
			hud:setHammerVisible(false)
		end
	end,
})

statsPanel = StatsPanel.new(mainUI)

hud = HUD.new(mainUI, {
	onOpenBuild = function()
		hud:setHammerVisible(false)
		buildMenu:show()
	end,
	onDemolish = function()
		hud:setHammerVisible(false)
		PlacementController.start("Demolish", nil)
		placementBar:show()
	end,
	onStats = function()
		statsPanel:toggle()
	end,
	onSave = function()
		local result = invoke(Constants.Remotes.SaveNow)
		if result.ok and result.persistent then
			toast:show("Saved", "success")
		elseif result.ok then
			toast:show("Saving is off in this session", "error")
		else
			toast:show(result.error or "Save failed", "error")
		end
	end,
	onChangeSlot = function()
		exitPlacement()
		buildMenu.panel.Visible = false
		statsPanel.panel.Visible = false
		local result = invoke(Constants.Remotes.LeaveState)
		if result.ok then
			ClientState.set({ Active = false })
			showMainMenu()
		else
			toast:show(result.error or "Could not leave", "error")
		end
	end,
})

PlacementController.onStatus(function(status)
	if status.Active then
		placementBar:update(status)
	else
		placementBar:hide()
		if not buildMenu:isOpen() and ClientState.snapshot.Active and not ClientState.snapshot.NeedsPlot then
			hud:setHammerVisible(true)
		end
	end
end)

PlacementController.onResult(function(success, message)
	if not success then
		toast:show(message, "error")
	end
end)

remote(Constants.Remotes.StateChanged).OnClientEvent:Connect(function(snapshot)
	ClientState.set(snapshot)
end)

remote(Constants.Remotes.PlotsChanged).OnClientEvent:Connect(function(plots)
	if plotScreen:isOpen() then
		plotScreen:setPlots(plots)
	end
end)

remote(Constants.Remotes.Notify).OnClientEvent:Connect(function(payload)
	if type(payload) == "table" and type(payload.Text) == "string" then
		toast:show(payload.Text, payload.Kind)
	end
end)

ClientState.onChanged(function(snapshot)
	if snapshot.Active and not snapshot.NeedsPlot then
		hud:update(snapshot)
		statsPanel:update(snapshot)
	end
end)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

ConstructionBars.start()
showMainMenu()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="103">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- ClientState: read-only mirror of the server-authoritative country snapshot.
-- The client NEVER edits gameplay state here; it only displays what the server sent.

local ClientState = {}

local listeners = {}
ClientState.snapshot = { Active = false }

function ClientState.set(snapshot)
	ClientState.snapshot = snapshot or { Active = false }
	for _, fn in ipairs(listeners) do
		task.spawn(fn, ClientState.snapshot)
	end
end

function ClientState.onChanged(fn)
	table.insert(listeners, fn)
	return function()
		local index = table.find(listeners, fn)
		if index then
			table.remove(listeners, index)
		end
	end
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">ConstructionBars</string>
            <string name="Source"><![CDATA[-- ConstructionBars: client-side construction progress bars above buildings.
--   Building...      12s
--   ████████░░
-- Reads server attributes on building models (State, BuildTime, CompleteAt = server time) and
-- animates the fill with ONE linear tween per state change (smooth, no per-frame work).
-- A single light loop (5x per second) updates the seconds text. On completion the bar fills,
-- shows "Done" and fades out smoothly.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Theme = require(Config:WaitForChild("ThemeConfig"))
local GameConfig = require(Config:WaitForChild("GameConfig"))

local ConstructionBars = {}

local C = Theme.Colors
local player = Players.LocalPlayer
local bars = {} -- [Model] = entry
local started = false

local function tween(inst, duration, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function remaining(model): number
	local completeAt = model:GetAttribute("CompleteAt") or 0
	return math.max(0, completeAt - Workspace:GetServerTimeNow())
end

local function createBar(model: Model)
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "ConstructionBar_" .. model.Name
	gui.Size = UDim2.fromOffset(104, 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (model:GetAttribute("VisualHeight") or 2) + 0.9, 0)
	gui.MaxDistance = GameConfig.Construction.ProgressBarMaxDistance
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Adornee = root

	local card = Instance.new("CanvasGroup")
	card.Name = "Card"
	card.BackgroundTransparency = 1
	card.Size = UDim2.fromScale(1, 1)
	card.GroupTransparency = 1
	card.Parent = gui

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Size = UDim2.new(0.7, 0, 0, 14)
	status.Font = Theme.Fonts.Bold
	status.TextSize = 11
	status.TextColor3 = C.Text
	status.TextStrokeColor3 = C.Background
	status.TextStrokeTransparency = 0.4
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Text = "Building..."
	status.Parent = card

	local timeLabel = Instance.new("TextLabel")
	timeLabel.Name = "Time"
	timeLabel.BackgroundTransparency = 1
	timeLabel.AnchorPoint = Vector2.new(1, 0)
	timeLabel.Position = UDim2.fromScale(1, 0)
	timeLabel.Size = UDim2.new(0.3, 0, 0, 14)
	timeLabel.Font = Theme.Fonts.Bold
	timeLabel.TextSize = 11
	timeLabel.TextColor3 = C.AccentDark
	timeLabel.TextStrokeColor3 = C.Background
	timeLabel.TextStrokeTransparency = 0.4
	timeLabel.TextXAlignment = Enum.TextXAlignment.Right
	timeLabel.Text = ""
	timeLabel.Parent = card

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(0, 18)
	track.Size = UDim2.new(1, 0, 0, 10)
	track.BackgroundColor3 = C.Background
	track.BorderSizePixel = 0
	track.Parent = card
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.Stroke
	stroke.Thickness = 1
	stroke.Parent = track

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = C.Accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(C.Accent, C.AccentDark)
	gradient.Parent = fill

	gui.Parent = player:WaitForChild("PlayerGui")
	tween(card, 0.25, { GroupTransparency = 0 })
	return { gui = gui, card = card, fill = fill, status = status, time = timeLabel, model = model, connections = {} }
end

local function removeBar(model: Model, animated: boolean)
	local entry = bars[model]
	if not entry then
		return
	end
	bars[model] = nil
	for _, c in ipairs(entry.connections) do
		c:Disconnect()
	end
	if entry.fillTween then
		entry.fillTween:Cancel()
	end
	if animated and entry.gui.Parent then
		entry.status.Text = "Done"
		entry.time.Text = ""
		tween(entry.fill, 0.2, { Size = UDim2.fromScale(1, 1) })
		task.delay(0.35, function()
			tween(entry.card, 0.45, { GroupTransparency = 1 }).Completed:Connect(function()
				entry.gui:Destroy()
			end)
		end)
	else
		entry.gui:Destroy()
	end
end

local function refresh(entry)
	local model = entry.model
	local state = model:GetAttribute("State")
	if state == "COMPLETED" then
		removeBar(model, true)
		return
	end
	local total = model:GetAttribute("BuildTime") or 1
	local left = remaining(model)
	if entry.fillTween then
		entry.fillTween:Cancel()
		entry.fillTween = nil
	end
	if state == "PLANNED" then
		entry.status.Text = "Preparing..."
		entry.fill.Size = UDim2.fromScale(0, 1)
	else
		entry.status.Text = "Building..."
		local fraction = math.clamp(1 - left / total, 0, 1)
		entry.fill.Size = UDim2.fromScale(fraction, 1)
		if left > 0 then
			entry.fillTween = tween(entry.fill, left, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)
		end
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or model:GetAttribute("Kind") ~= "Building" or bars[model] then
		return
	end
	local state = model:GetAttribute("State")
	if state == nil or state == "COMPLETED" then
		-- Listen in case construction data arrives later.
		local c
		c = model:GetAttributeChangedSignal("State"):Connect(function()
			if model:GetAttribute("State") ~= "COMPLETED" and not bars[model] then
				c:Disconnect()
				track(model)
			end
		end)
		return
	end
	local entry = createBar(model)
	if not entry then
		return
	end
	bars[model] = entry
	table.insert(entry.connections, model:GetAttributeChangedSignal("State"):Connect(function()
		refresh(entry)
	end))
	table.insert(entry.connections, model:GetAttributeChangedSignal("CompleteAt"):Connect(function()
		refresh(entry)
	end))
	table.insert(entry.connections, model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			removeBar(model, false)
		end
	end))
	refresh(entry)
end

function ConstructionBars.start()
	if started then
		return
	end
	started = true
	local buildings = Workspace:WaitForChild("Buildings")
	buildings.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst.Parent and inst.Parent:IsA("Folder") then
			task.defer(track, inst)
		end
	end)
	for _, inst in ipairs(buildings:GetDescendants()) do
		track(inst)
	end
	task.spawn(function()
		while true do
			task.wait(0.2)
			for model, entry in pairs(bars) do
				if model:GetAttribute("State") == "UNDER_CONSTRUCTION" or model:GetAttribute("State") == "PLANNED" then
					local left = math.ceil(remaining(model))
					entry.time.Text = left > 0 and (tostring(left) .. "s") or ""
				end
			end
		end
	end)
end

return ConstructionBars
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">PlacementController</string>
            <string name="Source"><![CDATA[-- PlacementController: client-side build preview only (server is the authority).
-- Modes:
--   Road      : hold LMB / finger, drag, release. A transparent preview follows the cursor while
--               held (grid snap + dominant direction + per-tile validation), release sends ONE
--               PlaceRoadLine request. A single click never builds a road by itself.
--   Building  : snapped preview + radius ring for water/power sources, click / Place to request.
--   Demolish  : hover highlights your own building or road tile, click to request removal.
-- Validation uses the SAME PlacementRules as the server. Work happens only while a mode is
-- active and only when the hovered grid cell changes (no heavy per-frame recomputation).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local Modules = Shared:WaitForChild("Modules")
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local PlacementConfig = require(Config:WaitForChild("PlacementConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local GridMath = require(Modules:WaitForChild("GridMath"))
local PlacementRules = require(Modules:WaitForChild("PlacementRules"))
local BuildingModels = require(Modules:WaitForChild("BuildingModels"))
local RoadModels = require(Modules:WaitForChild("RoadModels"))
local Plots = require(Modules:WaitForChild("Plots"))

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local PlacementController = {}

local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end
local VALID_COLOR = rgb(PlacementConfig.PreviewValidColor)
local INVALID_COLOR = rgb(PlacementConfig.PreviewInvalidColor)
local EXISTING_COLOR = Color3.fromRGB(200, 214, 230)

local active = nil
local connections = {}
local listeners = {}
local aimScreen = nil -- Vector2 (touch aim point) or nil for mouse
local requesting = false
local ctxCache = nil
local ctxDirty = true

local previewFolder = nil
local tilePool = {}

local function emit()
	local status = PlacementController.getStatus()
	for _, fn in ipairs(listeners) do
		task.spawn(fn, status)
	end
end

function PlacementController.onStatus(fn)
	table.insert(listeners, fn)
end

function PlacementController.getStatus()
	if not active then
		return { Active = false }
	end
	local variantName = nil
	if active.kind == "Building" then
		variantName = defsById[active.id].Variants[active.variantIndex]
	end
	return {
		Active = true,
		Kind = active.kind,
		Id = active.id,
		Variant = variantName,
		Valid = active.valid,
		Reason = active.reason,
		Rotation = active.rotation,
		Tiles = active.tiles,
		Dragging = active.dragging == true,
		TargetLabel = active.targetLabel,
		HasAim = active.info ~= nil,
	}
end

local function plotBounds()
	local index = player:GetAttribute(Constants.Attributes.PlotIndex)
	if not index then
		return nil
	end
	return Plots.getBounds(index)
end

local function plotFolder(kind: string, bounds)
	local root = Workspace:FindFirstChild(kind)
	return root and root:FindFirstChild("Plot_" .. bounds.index) or nil
end

local function rectOf(model)
	local minX = model:GetAttribute("RectMinX")
	if minX == nil then
		return nil
	end
	return {
		minX = minX,
		maxX = model:GetAttribute("RectMaxX"),
		minZ = model:GetAttribute("RectMinZ"),
		maxZ = model:GetAttribute("RectMaxZ"),
	}
end

-- Validation context from replicated world models (server-created, attribute-tagged).
-- Cached and rebuilt only when the player's plot folders change.
local function buildContext(bounds)
	if ctxCache and not ctxDirty and ctxCache.plot.index == bounds.index then
		return ctxCache
	end
	local ctx = { plot = bounds, buildingRects = {}, roadCells = {}, buildingModels = {}, roadModels = {} }
	local bFolder = plotFolder("Buildings", bounds)
	local rFolder = plotFolder("Roads", bounds)
	if bFolder then
		for _, model in ipairs(bFolder:GetChildren()) do
			local rect = rectOf(model)
			if rect then
				table.insert(ctx.buildingRects, rect)
				table.insert(ctx.buildingModels, { model = model, rect = rect })
			end
		end
	end
	if rFolder then
		for _, model in ipairs(rFolder:GetChildren()) do
			local rect = rectOf(model)
			local ix, iz = model:GetAttribute("Ix"), model:GetAttribute("Iz")
			if rect and ix ~= nil and iz ~= nil then
				local key = GridMath.cellKey(ix, iz)
				ctx.roadCells[key] = rect
				ctx.roadModels[key] = model
			end
		end
	end
	ctxCache = ctx
	ctxDirty = false
	return ctx
end

local function watchFolders(bounds)
	for _, kind in ipairs({ "Buildings", "Roads" }) do
		local folder = plotFolder(kind, bounds)
		if folder then
			table.insert(connections, folder.ChildAdded:Connect(function()
				ctxDirty = true
				if active then
					active.lastKey = nil
				end
			end))
			table.insert(connections, folder.ChildRemoved:Connect(function()
				ctxDirty = true
				if active then
					active.lastKey = nil
				end
			end))
		end
	end
end

-- Preview helpers ----------------------------------------------------------------------------
local function ensurePreviewFolder()
	if previewFolder and previewFolder.Parent then
		return previewFolder
	end
	previewFolder = Instance.new("Folder")
	previewFolder.Name = "WarStatePreview"
	previewFolder.Parent = Workspace.CurrentCamera
	return previewFolder
end

local function hideTiles(from: number)
	for i = from, #tilePool do
		tilePool[i].Parent = nil
	end
end

local function showTiles(tiles, surfaceY: number)
	local folder = ensurePreviewFolder()
	for i, tile in ipairs(tiles) do
		local p = tilePool[i]
		if not p then
			p = RoadModels.previewTile()
			tilePool[i] = p
		end
		p.CFrame = CFrame.new(tile.centerX, surfaceY + 0.07, tile.centerZ)
		if tile.existing then
			p.Color = EXISTING_COLOR
			p.Transparency = 0.7
		else
			p.Color = tile.valid and VALID_COLOR or INVALID_COLOR
			p.Transparency = PlacementConfig.PreviewTransparency
		end
		p.Parent = folder
	end
	hideTiles(#tiles + 1)
end

local function setModelTransparency(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local base = d:GetAttribute("BaseTransparency") or 0
			d.Transparency = math.max(base, PlacementConfig.PreviewTransparency)
		end
	end
end

local function destroyPreview()
	if active then
		for _, key in ipairs({ "model", "highlight", "ring", "targetHighlight" }) do
			if active[key] then
				active[key]:Destroy()
				active[key] = nil
			end
		end
	end
	hideTiles(1)
end

local function createBuildingPreview()
	destroyPreview()
	local def = defsById[active.id]
	local model = BuildingModels.build(def, def.Variants[active.variantIndex])
	model.Name = "PlacementPreview"
	local highlight = Instance.new("Highlight")
	highlight.Name = "InvalidHighlight"
	highlight.FillColor = INVALID_COLOR
	highlight.OutlineColor = INVALID_COLOR
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0.4
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Adornee = model
	highlight.Parent = model
	active.model = model
	active.highlight = highlight
	setModelTransparency(model)
	model.Parent = ensurePreviewFolder()
	-- Coverage ring for water / power sources.
	local radius = (def.Water and def.Water.Radius) or (def.Power and def.Power.Radius)
	if radius and radius > 0 then
		local ring = Instance.new("Part")
		ring.Name = "RadiusRing"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.05, radius * 2, radius * 2)
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.CastShadow = false
		ring.Material = Enum.Material.SmoothPlastic
		ring.Color = (def.Water and (def.Water.Radius or 0) > 0) and Color3.fromRGB(120, 186, 245) or Color3.fromRGB(245, 200, 90)
		ring.Transparency = 0.82
		ring.Parent = ensurePreviewFolder()
		active.ring = ring
	end
end

local function raycastGround(screenPoint: Vector2)
	local camera = Workspace.CurrentCamera
	local map = Workspace:FindFirstChild("Map")
	if not camera or not map then
		return nil
	end
	local ray = camera:ViewportPointToRay(screenPoint.X, screenPoint.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { map }
	local result = Workspace:Raycast(ray.Origin, ray.Direction * PlacementConfig.MaxPlacementRayDistance, params)
	return result and result.Position or nil
end

local function currentScreenPoint(): Vector2?
	if aimScreen then
		return aimScreen
	end
	if UserInputService.MouseEnabled then
		return UserInputService:GetMouseLocation()
	end
	return nil
end

-- Mode updates -------------------------------------------------------------------------------
local function updateRoad(bounds, hit)
	local ctx = buildContext(bounds)
	local startX, startZ = hit.X, hit.Z
	if active.dragging and active.dragStart then
		startX, startZ = active.dragStart.X, active.dragStart.Z
	end
	local cells = PlacementRules.roadLine(startX, startZ, hit.X, hit.Z, bounds)
	local ok, reason, tiles, newCount = PlacementRules.validateRoadLine(cells, ctx)
	active.valid = ok
	active.reason = ok and nil or reason
	active.tiles = newCount
	active.lineEnd = { X = hit.X, Z = hit.Z }
	showTiles(tiles, bounds.surfaceY)
	if not active.dragging and ok then
		active.reason = nil
	end
end

local function updateBuilding(bounds, hit)
	local ctx = buildContext(bounds)
	local ok, reason, info = PlacementRules.validateBuilding(defsById[active.id], hit.X, hit.Z, active.rotation, ctx)
	active.info = info
	active.valid = ok
	active.reason = reason
	if info and active.model then
		active.model.Parent = ensurePreviewFolder()
		active.model:PivotTo(
			CFrame.new(info.centerX, bounds.surfaceY + 0.02, info.centerZ)
				* CFrame.Angles(0, GridMath.yawForRotation(active.rotation), 0)
		)
		if active.highlight then
			active.highlight.Enabled = not ok
		end
		if active.ring then
			active.ring.CFrame = CFrame.new(info.centerX, bounds.surfaceY + 0.06, info.centerZ) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
end

local function labelFor(model): string
	local kind = model:GetAttribute(Constants.Attributes.Kind)
	if kind == "Road" then
		return "Road tile"
	end
	local def = defsById[model:GetAttribute(Constants.Attributes.TypeId) or ""]
	return def and def.DisplayName or "Building"
end

local function updateDemolish(bounds, hit)
	local ctx = buildContext(bounds)
	local target = nil
	for _, entry in ipairs(ctx.buildingModels) do
		local r = entry.rect
		if hit.X >= r.minX and hit.X <= r.maxX and hit.Z >= r.minZ and hit.Z <= r.maxZ then
			target = entry.model
			break
		end
	end
	if not target then
		local ix, iz = PlacementRules.snapRoad(hit.X, hit.Z, bounds)
		target = ctx.roadModels[GridMath.cellKey(ix, iz)]
	end
	if target ~= active.target then
		if active.targetHighlight then
			active.targetHighlight:Destroy()
			active.targetHighlight = nil
		end
		active.target = target
		if target then
			local h = Instance.new("Highlight")
			h.FillColor = INVALID_COLOR
			h.OutlineColor = INVALID_COLOR
			h.FillTransparency = 0.5
			h.OutlineTransparency = 0.2
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Adornee = target
			h.Parent = ensurePreviewFolder()
			active.targetHighlight = h
		end
	end
	active.valid = target ~= nil
	active.reason = target and nil or "Point at your building or road"
	active.targetLabel = target and ("Remove " .. labelFor(target)) or nil
end

local function update()
	if not active then
		return
	end
	local bounds = plotBounds()
	local screenPoint = currentScreenPoint()
	local hit = (bounds and screenPoint) and raycastGround(screenPoint) or nil
	if not hit then
		if active.valid ~= false or active.reason ~= "Aim at your plot" then
			active.valid = false
			active.reason = "Aim at your plot"
			active.info = nil
			if active.model then
				active.model.Parent = nil
			end
			if not active.dragging then
				hideTiles(1)
			end
			emit()
		end
		return
	end
	-- Only recompute when the snapped cell (or rotation / drag state) changes.
	local grid = active.kind == "Road" and PlacementConfig.RoadTileSize or PlacementConfig.GridSize
	local key = string.format(
		"%d:%d:%d:%s",
		math.floor((hit.X - bounds.minX) / grid),
		math.floor((hit.Z - bounds.minZ) / grid),
		active.rotation,
		tostring(active.dragging)
	)
	if key == active.lastKey and not ctxDirty then
		return
	end
	active.lastKey = key
	active.lastHit = hit
	if active.kind == "Road" then
		updateRoad(bounds, hit)
	elseif active.kind == "Building" then
		updateBuilding(bounds, hit)
	else
		updateDemolish(bounds, hit)
	end
	emit()
end

local function notifyResult(success: boolean, message: string)
	for _, fn in ipairs(PlacementController.resultListeners) do
		task.spawn(fn, success, message)
	end
end

local function invoke(remoteName: string, request, callback)
	requesting = true
	task.spawn(function()
		local remote = Remotes:WaitForChild(remoteName)
		local ok, result = pcall(function()
			return remote:InvokeServer(request)
		end)
		requesting = false
		local success = ok and type(result) == "table" and result.ok == true
		local message = success and "OK" or ((ok and type(result) == "table" and result.error) or "Request failed")
		notifyResult(success, message)
		if callback then
			callback(success, message, result)
		end
		ctxDirty = true
		if active then
			active.lastKey = nil
		end
	end)
end

-- Road drag release: build the previewed line.
local function finishRoadDrag()
	if not active or active.kind ~= "Road" or not active.dragging then
		return
	end
	active.dragging = false
	local start, finish = active.dragStart, active.lineEnd
	active.dragStart = nil
	active.lastKey = nil
	if not start or not finish or not active.valid or requesting then
		hideTiles(1)
		if active.reason then
			notifyResult(false, active.reason)
		end
		emit()
		return
	end
	invoke(Constants.Remotes.PlaceRoadLine, { StartX = start.X, StartZ = start.Z, EndX = finish.X, EndZ = finish.Z })
	hideTiles(1)
	emit()
end

function PlacementController.isActive(): boolean
	return active ~= nil
end

function PlacementController.start(kind: string, id: string?)
	PlacementController.cancel()
	local bounds = plotBounds()
	active = {
		kind = kind,
		id = id,
		variantIndex = 1,
		rotation = 0,
		valid = false,
		reason = "Aim at your plot",
	}
	aimScreen = nil
	ctxDirty = true
	if kind == "Building" then
		createBuildingPreview()
	end
	if bounds then
		watchFolders(bounds)
	end
	table.insert(connections, RunService.RenderStepped:Connect(update))
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not active then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			PlacementController.rotate()
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.Escape then
			PlacementController.cancel()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if input.UserInputType == Enum.UserInputType.Touch then
				aimScreen = Vector2.new(input.Position.X, input.Position.Y)
			else
				aimScreen = nil
			end
			if active.kind == "Road" then
				local b = plotBounds()
				local point = currentScreenPoint()
				local hit = (b and point) and raycastGround(point) or nil
				if hit then
					active.dragging = true
					active.dragStart = { X = hit.X, Z = hit.Z }
					active.lastKey = nil
				end
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				PlacementController.confirm()
			end
		end
	end))
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if active and active.dragging and input.UserInputType == Enum.UserInputType.Touch then
			aimScreen = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if not active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if active.kind == "Road" and active.dragging then
				update()
				finishRoadDrag()
			end
		end
	end))
	table.insert(connections, UserInputService.TouchTapInWorld:Connect(function(position, processed)
		if not processed and active and active.kind ~= "Road" then
			aimScreen = position
		end
	end))
	emit()
end

function PlacementController.rotate()
	if not active or active.kind ~= "Building" then
		return
	end
	active.rotation = (active.rotation + 1) % 4
	active.lastKey = nil
	emit()
end

function PlacementController.cycleVariant()
	if not active or active.kind ~= "Building" then
		return
	end
	local def = defsById[active.id]
	active.variantIndex = (active.variantIndex % #def.Variants) + 1
	createBuildingPreview()
	active.lastKey = nil
	emit()
end

function PlacementController.cancel()
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}
	destroyPreview()
	local wasActive = active ~= nil
	active = nil
	aimScreen = nil
	if wasActive then
		emit()
	end
end

-- Building / demolish confirm (roads are built on drag release). The server is the authority.
function PlacementController.confirm(callback)
	if not active or requesting then
		return
	end
	if active.kind == "Road" then
		return
	end
	if not active.valid then
		notifyResult(false, active.reason or "Invalid placement")
		emit()
		return
	end
	if active.kind == "Demolish" then
		local target = active.target
		if not target then
			return
		end
		local kind = target:GetAttribute(Constants.Attributes.Kind)
		invoke(Constants.Remotes.Demolish, { Kind = kind, Id = target.Name }, callback)
		return
	end
	if not active.info then
		return
	end
	local def = defsById[active.id]
	invoke(Constants.Remotes.PlaceBuilding, {
		Type = active.id,
		Variant = def.Variants[active.variantIndex],
		X = active.info.centerX,
		Z = active.info.centerZ,
		Rotation = active.rotation,
	}, callback)
end

PlacementController.resultListeners = {}
function PlacementController.onResult(fn)
	table.insert(PlacementController.resultListeners, fn)
end

return PlacementController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="107">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Folder" referent="108">
      <Properties>
        <string name="Name">Buildings</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="109">
      <Properties>
        <string name="Name">Map</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="110">
      <Properties>
        <string name="Name">NPCs</string>
      </Properties>
    </Item>
