      <Item class="Folder" referent="64">
        <Properties>
          <string name="Name">Population</string>
        </Properties>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">PopulationService</string>
            <string name="Source"><![CDATA[-- PopulationService: logical population (no physical NPCs).
-- Completed housing -> HousingCapacity -> Population grows gradually, never above HousingCapacity.
-- Water shortages never delete citizens instantly: growth stops at PROLONGED_SHORTAGE and only the
-- GRADUAL_POPULATION_DECREASE stage (WaterService) slowly reduces population.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))

local PopulationService = {}
PopulationService.Name = "PopulationService"

local services
local capacityByType = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	capacityByType[def.Id] = def.HousingCapacity or 0
end

local NO_GROWTH = {
	[Constants.ShortageStage.Prolonged] = true,
	[Constants.ShortageStage.Problems] = true,
	[Constants.ShortageStage.Decrease] = true,
}

function PopulationService.capacityOf(country): number
	local capacity = 0
	for _, record in pairs(country.Buildings) do
		if record.State == Constants.BuildState.Completed then
			capacity += capacityByType[record.Type] or 0
		end
	end
	return capacity
end

-- Recalculate capacity and clamp population (called on load and when housing changes).
function PopulationService.recalculate(country)
	country.HousingCapacity = PopulationService.capacityOf(country)
	if country.Population > country.HousingCapacity then
		country.Population = country.HousingCapacity
	end
	country.Workers = math.floor(country.Population * GameConfig.Population.WorkerRatio)
end

function PopulationService.growthBlocked(country): boolean
	local infra = country.Infrastructure
	local stage = infra and infra.Shortage and infra.Shortage.Stage
	return stage ~= nil and NO_GROWTH[stage] == true
end

-- One growth step. Returns true if population changed.
function PopulationService.grow(country): boolean
	local capacity = country.HousingCapacity
	local population = country.Population
	if population >= capacity then
		if population > capacity then
			country.Population = capacity
			return true
		end
		return false
	end
	if PopulationService.growthBlocked(country) then
		return false
	end
	local free = capacity - population
	local growth = math.max(GameConfig.Population.MinGrowth, math.floor(free * GameConfig.Population.GrowthFraction))
	country.Population = math.min(capacity, population + growth)
	country.Workers = math.floor(country.Population * GameConfig.Population.WorkerRatio)
	return true
end

function PopulationService.init(allServices)
	services = allServices
end

function PopulationService.start()
	task.spawn(function()
		while true do
			task.wait(GameConfig.Population.TickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local country = services.DataService.getCountry(player)
				if country and services.WorldService.getPlotIndex(player) and PopulationService.grow(country) then
					services.DataService.markDirty(player)
					services.CountryService.push(player)
				end
			end
		end
	end)
end

return PopulationService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="66">
        <Properties>
          <string name="Name">Power</string>
        </Properties>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">PowerService</string>
            <string name="Source"><![CDATA[-- PowerService: server-side electricity system.
-- Sources: Wind Generator (small: cheap, low production, small radius) and Substation /
-- Advanced Power Source (expensive, high production, large radius, higher resource upkeep).
-- Every building record gets PowerRequired / PowerSupplied / PowerStatus
-- (GREEN supplied, RED insufficient / no electricity, GREY not required).
-- Coverage is recomputed on events only. Upkeep (e.g. Fuel) is charged per utility tick only
-- while ResourceService is active; a source that cannot pay its upkeep goes offline.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local GameConfig = require(Config:WaitForChild("GameConfig"))
local BuildingConfig = require(Config:WaitForChild("BuildingConfig"))
local Constants = require(Shared:WaitForChild("Constants"):WaitForChild("Constants"))
local UtilityGrid = require(Shared:WaitForChild("Modules"):WaitForChild("UtilityGrid"))

local PowerService = {}
PowerService.Name = "PowerService"
PowerService.Kind = "Power"

local services
local defsById = {}
for _, def in ipairs(BuildingConfig.Buildings) do
	defsById[def.Id] = def
end

local function infra(country)
	country.Infrastructure = country.Infrastructure or {}
	local i = country.Infrastructure
	i.Power = i.Power or { Production = 0, Demand = 0 }
	return i
end

function PowerService.recompute(player: Player): boolean
	local country = services.DataService.getCountry(player)
	if not country then
		return false
	end
	local i = infra(country)
	local result = UtilityGrid.compute(country.Buildings, defsById, "Power")
	local changed = UtilityGrid.apply(country.Buildings, "Power", result)
	i.Power.Production = result.production
	i.Power.Demand = result.demand
	i.Power.Supplied = result.supplied
	services.BuildingService.refreshUtilityAttributes(player)
	return changed
end

-- Upkeep step: returns true when a source changed online/offline state.
local function upkeepStep(country): boolean
	if not services.ResourceService.Active then
		return false
	end
	local changed = false
	for _, record in pairs(country.Buildings) do
		local def = defsById[record.Type]
		local spec = def and def.Power
		if spec and (spec.Production or 0) > 0 and record.State == Constants.BuildState.Completed then
			local upkeep = spec.Upkeep or {}
			local affordable = services.ResourceService.canAfford(country, upkeep)
			local offline = not affordable
			if offline ~= (record.PowerOffline == true) then
				changed = true
			end
			record.PowerOffline = offline or nil
			if affordable then
				services.ResourceService.charge(country, upkeep)
			end
		end
	end
	return changed
end

function PowerService.init(allServices)
	services = allServices
end

function PowerService.start()
	task.spawn(function()
		while true do
			task.wait(GameConfig.Utilities.TickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local country = services.DataService.getCountry(player)
				if country and services.WorldService.getPlotIndex(player) then
					local ok, result = pcall(upkeepStep, country)
					if ok and result then
						PowerService.recompute(player)
						services.DataService.markDirty(player)
						services.CountryService.push(player)
					elseif not ok then
						warn("[PowerService] " .. tostring(result))
					end
				end
			end
		end
	end)
end

return PowerService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="68">
