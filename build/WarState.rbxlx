Variants.LargeHouse_C = function(m)
	-- Two-storey L-shape
	foundation(m, -2.0, -1.6, 10.8, 7.2)
	body(m, "Body", -2.0, -1.6, 10.8, 7.2, 7.0, C.Beige)
